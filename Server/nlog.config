<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off"
      throwConfigExceptions="true">

  <targets>
    <!-- No console target here — the classic ASP.NET Core console formatter (added via builder.Logging.AddConsole()
         in Program.cs) handles console output; NLog is only responsible for the file below. -->

    <!-- Active file is a stable name; every rollover (once per day, OR sooner if it hits 10MB first) moves
         its content into logs/archive/ with a date+sequence suffix. Both maxArchiveFiles and maxArchiveDays
         are enforced on every rollover, so nothing sits around uncleaned just because a quiet day never
         hit the size threshold — anything past 10 archives or 14 days old gets deleted automatically. -->
    <!-- Log directory comes from LOG_DIRECTORY when set, otherwise ${basedir}/logs as before.

         Program.cs sets LOG_DIRECTORY at startup via LogPaths.ApplyToEnvironment(), so no configuration
         is required: on Azure App Service it resolves to the writable share, everywhere else to
         ${basedir}/logs as before. Setting LOG_DIRECTORY explicitly still overrides both.

         This matters because the Azure site runs with WEBSITE_RUN_FROM_PACKAGE=1, which mounts the
         deployed zip READ-ONLY - ${basedir} is inside that mount, so this target could never create its
         directory there, and an NLog file target that cannot write does not fail startup. It just
         produces nothing, which is why it went unnoticed. -->
    <target xsi:type="File" name="file"
            fileName="${environment:variable=LOG_DIRECTORY:whenEmpty=${basedir}/logs}/imperial2030.log"
            archiveFileName="${environment:variable=LOG_DIRECTORY:whenEmpty=${basedir}/logs}/archive/imperial2030_${date:format=yyyy-MM-dd}_{##}.log"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveNumbering="Sequence"
            maxArchiveFiles="10"
            maxArchiveDays="14"
            keepFileOpen="false"
            layout="${date:format=yyyy-MM-dd HH\:mm\:ss.ffff zzz}|${level:uppercase=true}|${threadid}|${logger}|${callsite}|${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Mirrors appsettings.json's "Microsoft.AspNetCore"/"Microsoft.EntityFrameworkCore": "Warning" — but
         that config section is NOT automatically applied to NLog (NLog.Extensions.Logging filters via its
         own <rules> here, independent of Logging:LogLevel), so without this NLog re-floods the file with
         every MVC action-filter/EF Core per-query Info line these categories were already meant to suppress. -->
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
