@using Imperial2030.Shared.Models

<div class="map-container">
    <svg viewBox="0 0 1000 600" class="world-map">
        <!-- Oceans -->
        <rect width="1000" height="600" fill="#a4c2f4" />
        
        <!-- Schematic Regions (Placeholders for real map paths) -->
        <!-- Russia -->
        <path d="M500,50 L900,50 L900,200 L500,200 Z" fill="#e06666" stroke="black" stroke-width="2" />
        <text x="700" y="125" text-anchor="middle" fill="white" font-weight="bold">Russia</text>
        
        <!-- China -->
        <path d="M600,200 L900,200 L900,350 L600,350 Z" fill="#ffd966" stroke="black" stroke-width="2" />
        <text x="750" y="275" text-anchor="middle" fill="black" font-weight="bold">China</text>
        
        <!-- India -->
        <path d="M500,250 L600,250 L600,400 L500,400 Z" fill="#93c47d" stroke="black" stroke-width="2" />
        <text x="550" y="325" text-anchor="middle" fill="black" font-weight="bold">India</text>
        
        <!-- Europe -->
        <path d="M400,100 L500,100 L500,250 L400,250 Z" fill="#6d9eeb" stroke="black" stroke-width="2" />
        <text x="450" y="175" text-anchor="middle" fill="white" font-weight="bold">Europe</text>
        
        <!-- Brazil -->
        <path d="M250,350 L400,350 L400,550 L250,550 Z" fill="#b6d7a8" stroke="black" stroke-width="2" />
        <text x="325" y="450" text-anchor="middle" fill="black" font-weight="bold">Brazil</text>
        
        <!-- USA -->
        <path d="M100,150 L350,150 L350,300 L100,300 Z" fill="#76a5af" stroke="black" stroke-width="2" />
        <text x="225" y="225" text-anchor="middle" fill="white" font-weight="bold">USA</text>
        
        <!-- Africa (Neutral) -->
        <path d="M400,250 L600,250 L600,550 L400,550 Z" fill="#e69138" opacity="0.5" stroke="black" stroke-width="1" />
        <text x="500" y="400" text-anchor="middle" fill="black">Africa</text>

    </svg>
</div>

<style>
    .map-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .world-map {
        max-width: 100%;
        max-height: 100%;
        border-radius: 4px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
</style>

@code {
    [Parameter]
    public List<NationStateDto> NationStates { get; set; } = new List<NationStateDto>();
}
