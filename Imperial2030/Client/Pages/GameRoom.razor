@page "/game/{GameId:guid}"
@using Imperial2030.Shared.Models
@attribute [Authorize]

<PageTitle>Imperial 2030 - Game Room</PageTitle>

<div class="game-container">
    <div class="sidebar-left">
        <!-- Turn info, Rondel, etc. -->
        <div class="panel">
            <h4>Current Turn</h4>
            <div class="turn-indicator">
                <span class="badge bg-danger">Russia</span>
            </div>
        </div>
    </div>

    <div class="main-board">
        <!-- SVG Map or Canvas will go here -->
        <div class="map-placeholder">
            <h2>World Map Area</h2>
            <p>Game ID: @GameId</p>
        </div>
    </div>

    <div class="sidebar-right">
        <!-- Player stats, bond holdings -->
        <div class="panel">
            <h4>My Assets</h4>
            <ul class="list-group list-group-flush bg-transparent">
                <li class="list-group-item bg-transparent text-white">Cash: 2M</li>
                <li class="list-group-item bg-transparent text-white">Bonds: Russia (4M), China (2M)</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .game-container {
        display: grid;
        grid-template-columns: 250px 1fr 250px;
        height: calc(100vh - 60px);
        /* Adjust for header */
        gap: 1rem;
        padding: 1rem;
    }

    .panel {
        background-color: #2c3e50;
        padding: 1rem;
        border-radius: 8px;
        color: #ecf0f1;
    }

    .main-board {
        background-color: #34495e;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #95a5a6;
    }

    .map-placeholder {
        text-align: center;
        border: 2px dashed #7f8c8d;
        padding: 4rem;
        border-radius: 12px;
    }
</style>

@code {
    [Parameter]
    public Guid GameId { get; set; }
}
