@page "/game/{GameId:guid}"
@using Imperial2030.Shared.Models
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Imperial2030.Client.Components
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>Imperial 2030 - Game Room</PageTitle>

@if (game == null)
{
    <p>Loading game details...</p>
}
else
{
    <div class="game-container">
        <div class="sidebar-left">
            <div class="panel">
                <h4>Players</h4>
                <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var player in game.Players)
                    {
                        <li class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                            @player.UserName
                            @if (player.IsHost)
                            {
                                <span class="badge bg-warning text-dark">Host</span>
                            }
                        </li>
                    }
                </ul>
            </div>
            
             <div class="panel mt-3">
                <h4>Game Status</h4>
                <p class="mb-1">@game.Status</p>
                <small class="text-muted">Turn: @(game.Status == GameStatus.InProgress ? "Russia" : "-")</small>
            </div>
            
            @if (game.Status == GameStatus.InProgress)
            {
                <div class="panel mt-3">
                    <h4>Nations</h4>
                    <ul class="list-group list-group-flush bg-transparent small">
                        @foreach (var ns in game.NationStates)
                        {
                            <li class="list-group-item bg-transparent text-white px-0">
                                <b>@ns.Nation</b><br/>
                                <span class="text-info">Treasury: @ns.Treasury M</span> | 
                                <span class="text-warning">Power: @ns.Power</span><br/>
                                <span class="text-muted">Ctrl: @(ns.ControllerName ?? "None")</span>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-auto pt-3 d-grid gap-2">
                 @if (IsHost && game.Status == GameStatus.Lobby)
                 {
                     <button class="btn btn-success" @onclick="StartGame" disabled="@(game.Players.Count < 2)">Start Game</button>
                 }
                 <button class="btn btn-danger" @onclick="ExitGame">Exit Game</button>
            </div>
        </div>

        <div class="main-board">
             @if (game.Status == GameStatus.InProgress)
             {
                 <GameMap NationStates="@game.NationStates" />
             }
             else
             {
                 <div class="map-placeholder">
                    <h2>Imperial 2030</h2>
                    <p>Waiting for game to start...</p>
                    <p>Game ID: @GameId</p>
                </div>
             }
        </div>

        <div class="sidebar-right">
            <!-- Player stats, bond holdings -->
            <div class="panel">
                <h4>My Assets</h4>
                @if (MyPlayer != null)
                {
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-white fs-5">
                            Cash: <span class="text-success fw-bold">@MyPlayer.Cash M</span>
                        </li>
                        <li class="list-group-item bg-transparent text-white">
                            <h6 class="text-muted mt-2">Bonds</h6>
                            @if (MyPlayer.Bonds.Any())
                            {
                                @foreach (var bond in MyPlayer.Bonds)
                                {
                                    <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                        <span>@bond.Nation</span>
                                        <span>@bond.Interest M (Cost @bond.Cost)</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <small>No bonds held.</small>
                            }
                        </li>
                    </ul>
                }
            </div>
        </div>
    </div>
}

<style>
    .game-container {
        display: grid;
        grid-template-columns: 250px 1fr 250px;
        height: calc(100vh - 60px);
        /* Adjust for header */
        gap: 1rem;
        padding: 1rem;
    }

    .panel {
        background-color: #2c3e50;
        padding: 1rem;
        border-radius: 8px;
        color: #ecf0f1;
        display: flex; /* Added for layout of sidebar content */
        flex-direction: column;
        max-height: 100%;
        overflow-y: auto;
    }
    
    .sidebar-left, .sidebar-right {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        gap: 1rem;
    }

    .main-board {
        background-color: #34495e;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #95a5a6;
        flex-direction: column;
        overflow: hidden;
    }

    .map-placeholder {
        text-align: center;
        border: 2px dashed #7f8c8d;
        padding: 4rem;
        border-radius: 12px;
    }
</style>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private GameDetailDto? game;
    private HubConnection? hubConnection;
    private bool IsHost = false;
    private string? currentUserId;
    private PlayerDto? MyPlayer => game?.Players.FirstOrDefault(p => p.UserId == currentUserId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value; 
        if (currentUserId == null) 
             currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;


        await LoadGame();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .Build();

        hubConnection.On<Guid>("GameUpdated", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();
                StateHasChanged();
            }
        });
        
        hubConnection.On<Guid>("GameStarted", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();
                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinGameGroup", GameId.ToString());
    }

    private string? errorMessage;

    private async Task LoadGame()
    {
        try
        {
            game = await Http.GetFromJsonAsync<GameDetailDto>($"api/games/{GameId}");
            if (game != null && currentUserId != null)
            {
                var me = game.Players.FirstOrDefault(p => p.UserId == currentUserId);
                IsHost = me?.IsHost ?? false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game: {ex.Message}");
            errorMessage = $"Error loading game: {ex.Message}";
        }
    }

    private async Task StartGame()
    {
        errorMessage = null;
        var response = await Http.PostAsync($"api/games/{GameId}/start", null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = $"Failed to start game: {error}";
            Console.WriteLine(errorMessage);
        }
    }

    private async Task ExitGame()
    {
        var response = await Http.PostAsync($"api/games/{GameId}/leave", null);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Console.WriteLine("Failed to leave game");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("LeaveGameGroup", GameId.ToString());
            await hubConnection.DisposeAsync();
        }
    }
}
