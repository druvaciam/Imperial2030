# start.sh creates .env on the first run - you do not need this file. It lists what .env can hold.

# The port the game is reached on. Easier: sudo sh start.sh 9000
PORT=8080

# Generated by start.sh. Never change them once the database exists: it is locked with this password.
MSSQL_SA_PASSWORD=
JWT_KEY=

# Optional extras - add them to .env and run start.sh again:
# AZURE_FUNCTION_NOTIFICATION_KEY=   push notifications (copy from the existing instance's settings)
# TYPESAFE_API_KEY=                  offers the Jev-layered bots
# MSSQL_MEMORY_LIMIT_MB=2048         memory SQL Server may use; 2048 is its minimum
