                if (!oldFactories.Contains(ts.TerritoryId))
                {
                    _newFactoryTimestamps[ts.TerritoryId] = DateTime.Now;
                }
            }
            var expiredFacs = _newFactoryTimestamps.Where(kv => (DateTime.Now - kv.Value).TotalSeconds > 10).Select(kv => kv.Key).ToList();
            foreach (var e in expiredFacs) _newFactoryTimestamps.Remove(e);
        }

        if (oldNationStates != null)
        {
            foreach (var ns in newState.NationStates)
            {
                if (oldNationStates.TryGetValue(ns.Nation, out var oldNs))
                {
                    if (oldNs.Treasury != ns.Treasury)
                    {
                        var delta = ns.Treasury - oldNs.Treasury;
                        _nationTreasuryEffects[ns.Nation] = (delta, Guid.NewGuid(), DateTime.Now);
                    }
                    if (oldNs.Power != ns.Power)
                    {
                        var pDelta = ns.Power - oldNs.Power;
                        _nationPowerEffects[ns.Nation] = (pDelta, Guid.NewGuid(), DateTime.Now);
                        _nationPowerChanges[ns.Nation] = DateTime.Now;
                    }
                    if (oldNs.TaxRevenue != ns.TaxRevenue)
                    {
                        _nationTaxChanges[ns.Nation] = DateTime.Now;
                    }
                }
            }
            var expiredTreasury = _nationTreasuryEffects.Where(kv => (DateTime.Now - kv.Value.Timestamp).TotalSeconds > 10).Select(kv => kv.Key).ToList();
            foreach (var e in expiredTreasury) _nationTreasuryEffects.Remove(e);

            var expiredPowerEffects = _nationPowerEffects.Where(kv => (DateTime.Now - kv.Value.Timestamp).TotalSeconds > 10).Select(kv => kv.Key).ToList();
            foreach (var e in expiredPowerEffects) _nationPowerEffects.Remove(e);

            var expiredPower = _nationPowerChanges.Where(kv => (DateTime.Now - kv.Value).TotalSeconds > 30).Select(kv => kv.Key).ToList();
            foreach (var e in expiredPower) _nationPowerChanges.Remove(e);

            var expiredTax = _nationTaxChanges.Where(kv => (DateTime.Now - kv.Value).TotalSeconds > 30).Select(kv => kv.Key).ToList();
            foreach (var e in expiredTax) _nationTaxChanges.Remove(e);
        }
    }

    // Drops any in-flight animation effects. Used when swapping between the real game and a replay
    // session, whose snapshots are a different game copy entirely (fresh unit/player ids) — carrying
    // stale highlights across that boundary would light up unrelated pieces.
    private void ClearStateChangeAnimations()
    {
        _playerCashEffects.Clear();
        _nationTreasuryEffects.Clear();
        _nationPowerEffects.Clear();
        _newUnitTimestamps.Clear();
        _newFactoryTimestamps.Clear();
        _nationPowerChanges.Clear();
        _nationTaxChanges.Clear();
    }

    private async Task LoadGame()
    {
        try
        {
            var newGame = await Http.GetFromJsonAsync<GameDetailDto>($"api/games/{GameId}");

            if (newGame != null)
            {
                UpdateDisplayedNation(newGame.CurrentTurnNation);
                CaptureStateChangeAnimations(newGame);
            }
            game = newGame;

            if (game != null && currentUserId != null)
            {
                var me = game.Players.FirstOrDefault(p => p.UserId == currentUserId);
                IsHost = me?.IsHost ?? false;

                // Also re-resolves when the previously-selected id no longer exists in this game's roster
                // (not just when never set) — needed for returning from a replay session, whose Players are
                // freshly-generated ids in a separate in-memory copy that don't carry over to the real game.
                if (selectedPlayerId == null || !game.Players.Any(p => p.Id == selectedPlayerId))
                {
                    if (me != null)
                    {
                        selectedPlayerId = me.Id;
                    }
                    else if (game.Players.Any())
                    {
                        selectedPlayerId = game.Players.First().Id;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game: {ex.Message}");
            await ShowToast(L["Toast_GameNotFound"], true);
            await Task.Delay(2000);
            Navigation.NavigateTo("/");
        }
    }

