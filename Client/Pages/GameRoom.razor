    private async Task OnRondelMove(int slotIndex)
    {
        if (game == null || isSubmitting) return;

        var nation = game.CurrentTurnNation;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return;

        // Client-side cost verification
        int cost = 0;
        if (ns.RondelPosition.HasValue)
        {
            int current = ns.RondelPosition.Value;
            if (current == slotIndex) return; // Same slot, ignore

            int dist = (slotIndex - current + RondelData.SlotCount) % RondelData.SlotCount;
            if (dist > RondelData.MaxMoveDistance)
            {
                _ = ShowToast(L["Toast_RondelTooFar", RondelData.MaxMoveDistance], true);
                return;
            }

            cost = RondelData.GetMoveCost(current, slotIndex, ns.Power);
        }

        if (cost > 0)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["Confirm_MoveCost", cost].Value);
            if (!confirmed) return;
        }

        // --- Useless Action Warnings ---
        string warningMessage = string.Empty;

        // 1. Factory (Slot 1)
        if (slotIndex == RondelData.FactorySlot)
        {
            if (ns.Treasury < 5)
            {
                warningMessage = L["Warn_NoTreasuryForFactory"];
            }
            else
            {
                var homeProvinces = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == nation).ToList();
                int builtFactoriesCount = game.Territories.Count(ts => homeProvinces.Any(hp => hp.Id == ts.TerritoryId) && ts.HasFactory);
                if (builtFactoriesCount >= homeProvinces.Count)
                {
                    warningMessage = L["Warn_AllFactoriesBuilt"];
                }
                else if (!homeProvinces.Any(hp =>
                             !game.Territories.Any(ts => ts.TerritoryId == hp.Id && ts.HasFactory) &&
                             !game.Units.Any(u => u.TerritoryId == hp.Id && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile)))
                {
                    // Money and an empty city, but a hostile army stands in every empty one.
                    // Imperial-2030-Rules.pdf p.7: "A factory may be built only in one of the nation's own
                    // cities if there are no hostile armies (standing upright) in its home province."
                    warningMessage = L["Warn_FactoryCitiesBlockaded"];
                }
            }
        }
        // 2 & 6. Production
        else if (RondelData.IsProductionSlot(slotIndex))
        {
            var homeProvinces = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == nation);
            var myFactories = game.Territories.Where(ts => homeProvinces.Any(hp => hp.Id == ts.TerritoryId) && ts.HasFactory);

            bool hasUnblockadedFactory = false;
            foreach (var factory in myFactories)
            {
                // A factory is blockaded ONLY if a hostile army of another nation is on it.
                bool isBlockaded = game.Units.Any(u => u.TerritoryId == factory.TerritoryId && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile);
                if (!isBlockaded)
                {
                    hasUnblockadedFactory = true;
                    break;
                }
            }

            if (!myFactories.Any())
            {
                warningMessage = L["Warn_NoFactories"];
            }
            else if (!hasUnblockadedFactory)
            {
                warningMessage = L["Warn_FactoriesBlockaded"];
            }
            else
            {
                // A factory that is free to work can still have nothing to make, because that unit type
                // is already at the nation's cap. This is the case that actually happens: the engine
                // forbids hostile entry into a nation's last unoccupied factory, so at least one factory
                // is always unblockaded and the branch above is close to unreachable, while this one was
                // silent. Mirrors BotService.BotProduction's per-factory test exactly - a brown city
                // makes an army, a light blue one a fleet, and each has its own cap.
                int currentArmies = game.Units.Count(u => u.Nation == nation && u.UnitType == UnitType.Army);
                int currentFleets = game.Units.Count(u => u.Nation == nation && u.UnitType == UnitType.Fleet);
                int maxArmies = Imperial2030.Shared.Constants.NationData.GetMaxArmies(nation);
                int maxFleets = Imperial2030.Shared.Constants.NationData.GetMaxFleets(nation);

                bool canProduceAnything = myFactories.Any(factory =>
                {
                    bool isBlockaded = game.Units.Any(u => u.TerritoryId == factory.TerritoryId && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile);
                    if (isBlockaded) return false;

                    var def = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == factory.TerritoryId);
                    return def?.CityType == CityType.LightBlue ? currentFleets < maxFleets : currentArmies < maxArmies;
                });

                if (!canProduceAnything)
                {
                    warningMessage = L["Warn_ProductionAtUnitCap"];
                }
            }
        }
        // 3 & 7. Maneuver
        else if (RondelData.IsManeuverSlot(slotIndex))
        {
            int myUnitsCount = game.Units.Count(u => u.Nation == nation);
            if (myUnitsCount == 0)
            {
                warningMessage = L["Warn_NoUnitsToManeuver"];
            }
        }
        // 4. Investor
        else if (slotIndex == RondelData.InvestorSlot)
        {
            var bondsForNation = game.Players.SelectMany(p => p.Bonds).Where(b => b.Nation == nation).ToList();
            int totalOwedToOthers = bondsForNation.Where(b => b.HolderName != MyPlayer?.UserName).Sum(b => b.Interest);
            int myInterestOwed = bondsForNation.Where(b => b.HolderName == MyPlayer?.UserName).Sum(b => b.Interest);

            if (ns.Treasury <= totalOwedToOthers)
            {
                warningMessage = L["Warn_InterestShortfall", ns.Treasury, totalOwedToOthers, myInterestOwed];
            }
        }
        // 5. Import
        else if (slotIndex == RondelData.ImportSlot)
        {
            if (ns.Treasury < 1)
            {
                warningMessage = L["Warn_NoTreasuryForImport"];
            }
        }

        if (!string.IsNullOrEmpty(warningMessage))
        {
            bool proceed = await JSRuntime.InvokeAsync<bool>("confirm", warningMessage + " Are you sure you want to proceed?");
            if (!proceed) return;
        }
        // --- End Useless Action Warnings ---

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/move/{nation}/{slotIndex}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast(L["Toast_MoveFailed", error], true);
            }
            else
            {
                // State update handled by SignalR refresh, hasMoved is server-side now
            }
        }
        catch (Exception ex)
        {
            await ShowToast(L["Toast_Error", ex.Message], true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

