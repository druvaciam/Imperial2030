@code {
    [Parameter]
    public Guid GameId { get; set; }

    private GameDetailDto? game;
    private HubConnection? hubConnection;
    private bool IsHost = false;
    private string? currentUserId;
    private PlayerDto? MyPlayer => game?.Players.FirstOrDefault(p => p.UserId == currentUserId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value; 
        if (currentUserId == null) 
             currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;


        await LoadGame();

        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"), options =>
            {
                if (!string.IsNullOrEmpty(token))
                {
                    options.AccessTokenProvider = () => Task.FromResult((string?)token);
                }
            })
            .Build();

        hubConnection.On<Guid>("GameUpdated", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });
        
        hubConnection.On<Guid>("GameStarted", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });

        hubConnection.On<string, bool>("UserPresenceChanged", (userId, isOnline) =>
        {
            if (game != null)
            {
                var player = game.Players.FirstOrDefault(p => p.UserId == userId);
                if (player != null && player.IsOnline != isOnline)
                {
                    player.IsOnline = isOnline;
                    StateHasChanged();
                }
            }
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinGameGroup", GameId.ToString());
    }

    private async Task LoadGame()
    {
        try
        {
            game = await Http.GetFromJsonAsync<GameDetailDto>($"api/games/{GameId}");
            if (game != null && currentUserId != null)
            {
                var me = game.Players.FirstOrDefault(p => p.UserId == currentUserId);
                IsHost = me?.IsHost ?? false;

                if (selectedPlayerId == null && me != null)
                {
                    selectedPlayerId = me.Id;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game: {ex.Message}");
            await ShowToast($"Error loading game: {ex.Message}", true);
        }
    }

    private async Task StartGame()
    {
        var response = await Http.PostAsync($"api/games/{GameId}/start", null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            await ShowToast($"Failed to start game: {error}", true);
        }
    }

    private string GetWinningNation()
    {
        if (game == null) return "Unknown";
        var winner = game.NationStates.OrderByDescending(n => n.Power).FirstOrDefault();
        return winner?.Nation.ToString() ?? "Unknown";
    }

    private int GetPlayerScore(PlayerDto player)
    {
        if (game == null) return 0;
        var g = game!;
        int score = player.Cash;
        if (player.Bonds != null)
        {
            foreach (var bond in player.Bonds)
            {
                var nation = g.NationStates.FirstOrDefault(n => n.Nation == bond.Nation);
                if (nation != null)
                {
                    int factor = nation.Power / 5;
                    score += bond.Interest * factor;
                }
            }
        }
        return score;
    }

    private bool IsMyTurn()
    {
        if (game == null) return false;
        // If game is finished, no one's turn
        if (game.Status == GameStatus.Finished) return false;

        if (game.Status != GameStatus.InProgress) return false;
        // If it's investor turn, the global "Turn" is effectively paused for the nation controller
        if (game.IsInvestorTurn) return false;
        var currentNationState = game.NationStates.FirstOrDefault(ns => ns.Nation == game.CurrentTurnNation);
        return currentNationState?.ControllerName == MyPlayer?.UserName;
    }

    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    private bool isSubmitting = false;
    private string? toastMessage;
    private bool isToastError;
    // Reset state when game updates (if it's a new turn for me)

    private Guid? selectedPlayerId;

    private async Task OnRondelMove(int slotIndex)
    {
        if (game == null || isSubmitting) return;
        
        var nation = game.CurrentTurnNation;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return;

        // Client-side cost verification
        int cost = 0;
        if (ns.RondelPosition.HasValue)
        {
             int current = ns.RondelPosition.Value;
             if (current == slotIndex) return; // Same slot, ignore
             
             int dist = (slotIndex - current + 8) % 8;
             if (dist > 3)
             {
                 int powerFactor = ns.Power / 5;
                 int costPerStep = 1 + powerFactor;
                 cost = (dist - 3) * costPerStep;
             }
        }
        
        if (cost > 0)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"This move will cost {cost}M. Proceed?");
            if (!confirmed) return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/move/{nation}/{slotIndex}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Move failed: {error}", true);
            }
            else
            {
                // State update handled by SignalR refresh, hasMoved is server-side now
            }
        }
        catch (Exception ex)
        {
             await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task EndTurn()
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/end-turn", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Failed to end turn: {error}", true);
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool CanBuildFactory()
    {
        if (game == null || !IsMyTurn() || game.IsInvestorTurn) return false;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        // Assuming slot 1 is Factory
        return ns?.RondelPosition == 1 && ns.Treasury >= 5;
    }

    private List<Imperial2030.Shared.Models.Territory> GetValidFactoryTerritories()
    {
        if (game == null) return new ();
        var nation = game.CurrentTurnNation;
        return Imperial2030.Shared.Constants.TerritoryData.AllTerritories
            .Where(t => t.Nation == nation && !game.Territories.Any(ts => ts.TerritoryId == t.Id && ts.HasFactory))
            .ToList();
    }

    private async Task BuildFactory(string territoryId)
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/build-factory/{territoryId}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Failed to build factory: {error}", true);
            }
            else
            {
                await ShowToast("Factory built successfully!", false);
                // State update handled by SignalR refresh, hasBuilt is server-side now
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool CanTax()
    {
        if (game == null || !IsMyTurn() || game.IsInvestorTurn) return false;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        return ns?.RondelPosition == 0; // Slot 0 is Taxation
    }

    private async Task CollectTaxation()
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/taxation", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Taxation failed: {error}", true);
            }
            else
            {
                 // Create a formatted message from result if possible, but minimal for now
                 var result = await response.Content.ReadFromJsonAsync<TaxationResultDto>(); // Need DTO? Or just dynamic/anonymous?
                 // Let's just toast success for now or parse generic object
                 
                 await ShowToast("Taxation executed successfully!", false);
            }
        }
        catch (Exception ex)
        {
             await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }
    
    // Add simple DTO for result parsing locally if needed, or use dynamic
    public class TaxationResultDto 
    {
        public int TaxRevenue { get; set; }
        public int SoldiersPay { get; set; }
        public int Bonus { get; set; }
        public int PowerGain { get; set; }
    }

    private bool CanProduce()
    {
        if (game == null || !IsMyTurn() || game.IsInvestorTurn) return false;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        return (ns?.RondelPosition == 2 || ns?.RondelPosition == 6) && !ns.HasProducedThisTurn; // Slots 2 and 6 are Production
    }

    private async Task ExecuteProduction()
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/production", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Production failed: {error}", true);
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                await ShowToast(msg, false);
            }
        }
        catch (Exception ex)
        {
             await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task PerformInvestment(string actionType, Guid? bondId, Guid? tradeInBondId = null)
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var payload = new { ActionType = actionType, BondId = bondId, TradeInBondId = tradeInBondId };
            var response = await Http.PostAsJsonAsync($"api/games/{GameId}/investor-action", payload);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Investment failed: {error}", true);
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private List<ImportUnit> pendingImports = new();

    private bool CanImport()
    {
        if (game == null || !IsMyTurn() || game.IsInvestorTurn) return false;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        return ns?.RondelPosition == 5 && !ns.HasImportedThisTurn; 
    }

    private void AddImportUnit()
    {
        if (pendingImports.Count < 3)
        {
            var valid = GetValidImportTerritories(UnitType.Army);
            // Default to first valid territory used
            var defaultId = valid.FirstOrDefault()?.Id ?? "";
            
            // If already have imports, try to reuse last territory for convenience
            if (pendingImports.Any())
            {
                 var last = pendingImports.Last();
                 // Check if last used is valid for new type (Army)
                 if (valid.Any(v => v.Id == last.TerritoryId)) 
                 {
                     defaultId = last.TerritoryId;
                 }
            }

            pendingImports.Add(new ImportUnit { UnitType = UnitType.Army, TerritoryId = defaultId });
        }
    }

    private void RemoveImportUnit(ImportUnit unit)
    {
        pendingImports.Remove(unit);
    }

    private void OnImportUnitTypeChanged(ImportUnit unit, object? newValue)
    {
        if (newValue is null) return;
        if (Enum.TryParse<UnitType>(newValue.ToString(), out var parsedType))
        {
            unit.UnitType = parsedType;
            // Check if current territory is still valid
            var validTerritories = GetValidImportTerritories(parsedType);
            if (!validTerritories.Any(t => t.Id == unit.TerritoryId))
            {
                // Reset to first valid
                unit.TerritoryId = validTerritories.FirstOrDefault()?.Id ?? "";
            }
        }
    }

    private List<Imperial2030.Shared.Models.Territory> GetValidImportTerritories(UnitType unitType)
    {
        if (game == null) return new ();
        var nation = game.CurrentTurnNation;
        
        var query = Imperial2030.Shared.Constants.TerritoryData.AllTerritories
            .Where(t => t.Nation == nation); // Home Province

        if (unitType == UnitType.Fleet)
        {
            query = query.Where(t => t.CityType == CityType.LightBlue); // Harbor
        }

        // Hostile Army filter
        var hostileTerritories = game.Units
            .Where(u => u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile)
            .Select(u => u.TerritoryId)
            .ToHashSet();

        return query.Where(t => !hostileTerritories.Contains(t.Id)).ToList();
    }

    private async Task ExecuteImport()
    {
        if (game == null || isSubmitting) return;
        
        if (pendingImports.Count == 0) return;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        if (ns == null || ns.Treasury < pendingImports.Count) 
        {
             await ShowToast("Insufficient funds!", true);
             return;
        }

        isSubmitting = true;
        try
        {
            var request = new ImportRequest { Units = pendingImports };
            var response = await Http.PostAsJsonAsync($"api/games/{GameId}/import", request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Import failed: {error}", true);
            }
            else
            {
                var msg = await response.Content.ReadAsStringAsync();
                await ShowToast(msg, false);
                pendingImports.Clear();
            }
        }
        catch (Exception ex)
        {
             await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    // Wrapper to match Action<string, bool> signature (fire and forget)
    private void OnShowToastAction(string message, bool isError)
    {
        _ = ShowToast(message, isError);
    }
    
    private async Task ShowToast(string message, bool isError)
    {
        toastMessage = message;
        isToastError = isError;
        StateHasChanged();
        Console.WriteLine($"Toast: {message}");
        await Task.Delay(4000);
        toastMessage = null;
        StateHasChanged();
    }

    private async Task ExitGame()
    {
        var response = await Http.PostAsync($"api/games/{GameId}/leave", null);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            await ShowToast("Failed to leave game", true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("LeaveGameGroup", GameId.ToString());
            await hubConnection.DisposeAsync();
        }
    }
}
