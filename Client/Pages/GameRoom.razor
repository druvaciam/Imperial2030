    private async Task OnRondelMove(int slotIndex)
    {
        if (game == null || isSubmitting) return;

        var nation = game.CurrentTurnNation;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return;

        // Client-side cost verification
        int cost = 0;
        if (ns.RondelPosition.HasValue)
        {
            int current = ns.RondelPosition.Value;
            if (current == slotIndex) return; // Same slot, ignore

            int dist = (slotIndex - current + 8) % 8;
            if (dist > 6)
            {
                _ = ShowToast("You cannot move more than 6 spaces on the rondel!", true);
                return;
            }

            if (dist > 3)
            {
                int powerFactor = ns.Power / 5;
                int costPerStep = 1 + powerFactor;
                cost = (dist - 3) * costPerStep;
            }
        }

        if (cost > 0)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"This move will cost {cost}M. Proceed?");
            if (!confirmed) return;
        }

        // --- Useless Action Warnings ---
        string warningMessage = string.Empty;

        // 1. Factory (Slot 1)
        if (slotIndex == 1)
        {
            if (ns.Treasury < 5)
            {
                warningMessage = "You have less than 5M in your treasury. You will not be able to build a factory.";
            }
            else
            {
                var homeProvinces = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == nation);
                int builtFactoriesCount = game.Territories.Count(ts => homeProvinces.Any(hp => hp.Id == ts.TerritoryId) && ts.HasFactory);
                if (builtFactoriesCount >= homeProvinces.Count())
                {
                    warningMessage = "All of your home provinces already have factories built. You cannot build any more.";
                }
            }
        }
        // 2 & 6. Production
        else if (slotIndex == 2 || slotIndex == 6)
        {
            var homeProvinces = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == nation);
            var myFactories = game.Territories.Where(ts => homeProvinces.Any(hp => hp.Id == ts.TerritoryId) && ts.HasFactory);

            bool hasUnblockadedFactory = false;
            foreach (var factory in myFactories)
            {
                // A factory is blockaded ONLY if a hostile army of another nation is on it.
                bool isBlockaded = game.Units.Any(u => u.TerritoryId == factory.TerritoryId && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile);
                if (!isBlockaded)
                {
                    hasUnblockadedFactory = true;
                    break;
                }
            }

            if (!myFactories.Any())
            {
                warningMessage = "You do not have any factories. You will not produce any units.";
            }
            else if (!hasUnblockadedFactory)
            {
                warningMessage = "All of your factories are blockaded by hostile armies. You cannot produce any units.";
            }
        }
        // 3 & 7. Maneuver
        else if (slotIndex == 3 || slotIndex == 7)
        {
            int myUnitsCount = game.Units.Count(u => u.Nation == nation);
            if (myUnitsCount == 0)
            {
                warningMessage = "You have no armies or fleets on the board to maneuver.";
            }
        }
        // 4. Investor
        else if (slotIndex == 4)
        {
            var bondsForNation = game.Players.SelectMany(p => p.Bonds).Where(b => b.Nation == nation).ToList();
            int totalOwedToOthers = bondsForNation.Where(b => b.HolderName != MyPlayer?.UserName).Sum(b => b.Interest);
            int myInterestOwed = bondsForNation.Where(b => b.HolderName == MyPlayer?.UserName).Sum(b => b.Interest);

            if (ns.Treasury <= totalOwedToOthers)
            {
                warningMessage = $"This nation only has {ns.Treasury}M, but owes {totalOwedToOthers}M to other players. You will earn 0M from your {myInterestOwed}M interest.";
            }
        }
        // 5. Import
        else if (slotIndex == 5)
        {
            if (ns.Treasury < 1)
            {
                warningMessage = "You have 0M in your treasury. You will not be able to import any units.";
            }
        }

        if (!string.IsNullOrEmpty(warningMessage))
        {
            bool proceed = await JSRuntime.InvokeAsync<bool>("confirm", warningMessage + " Are you sure you want to proceed?");
            if (!proceed) return;
        }
        // --- End Useless Action Warnings ---

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/move/{nation}/{slotIndex}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Move failed: {error}", true);
            }
            else
            {
                // State update handled by SignalR refresh, hasMoved is server-side now
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

