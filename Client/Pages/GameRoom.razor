                    // Replay was clicked. Left stale, the Assets panel's dropdown-driven lookup matches no
                    // one and silently renders empty (the <select> itself still shows a value since HTML
                    // falls back to displaying its first <option> even when none match the bound value).
                    if (!game.Players.Any(p => p.Id == selectedPlayerId))
