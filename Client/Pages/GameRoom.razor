    }

    private void AddImportUnit()
    {
        if (pendingImports.Count < 3)
        {
            var valid = GetValidImportTerritories(UnitType.Army);
            // Default to first valid territory used
            var defaultId = valid.FirstOrDefault()?.Id ?? "";

            // If already have imports, try to reuse last territory for convenience
            if (pendingImports.Any())
            {
                var last = pendingImports.Last();
                // Check if last used is valid for new type (Army)
                if (valid.Any(v => v.Id == last.TerritoryId))
                {
                    defaultId = last.TerritoryId;
                }
            }

            pendingImports.Add(new ImportUnit { UnitType = UnitType.Army, TerritoryId = defaultId });
        }
    }

    private void RemoveImportUnit(ImportUnit unit)
    {
        pendingImports.Remove(unit);
    }

    private void OnImportUnitTypeChanged(ImportUnit unit, object? newValue)
    {
        if (newValue is null) return;
        if (Enum.TryParse<UnitType>(newValue.ToString(), out var parsedType))
        {
            unit.UnitType = parsedType;
            // Check if current territory is still valid
            var validTerritories = GetValidImportTerritories(parsedType);
            if (!validTerritories.Any(t => t.Id == unit.TerritoryId))
            {
                // Reset to first valid
                unit.TerritoryId = validTerritories.FirstOrDefault()?.Id ?? "";
            }
        }
    }

    private List<Imperial2030.Shared.Models.Territory> GetValidImportTerritories(UnitType unitType)
    {
        if (game == null) return new();
        var nation = game.CurrentTurnNation;

        var query = Imperial2030.Shared.Constants.TerritoryData.AllTerritories
            .Where(t => t.Nation == nation); // Home Province

        if (unitType == UnitType.Fleet)
        {
            query = query.Where(t => t.CityType == CityType.LightBlue); // Harbor
        }

        // Hostile Army filter
        var hostileTerritories = game.Units
            .Where(u => u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile)
            .Select(u => u.TerritoryId)
            .ToHashSet();

        return query.Where(t => !hostileTerritories.Contains(t.Id)).ToList();
    }

    private async Task ExecuteImport()
    {
        if (game == null || isSubmitting) return;

        if (pendingImports.Count == 0) return;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        if (ns == null || ns.Treasury < pendingImports.Count)
        {
            await ShowToast(L["Toast_InsufficientFunds"], true);
            return;
        }

        isSubmitting = true;
        try
        {
            var request = new ImportRequest { Units = pendingImports };
            var response = await Http.PostAsJsonAsync($"api/games/{GameId}/import", request);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast(L["Toast_ImportFailed", error], true);
            }
            else
            {
                pendingImports.Clear();
            }
        }
        catch (Exception ex)
        {
            await ShowToast(L["Toast_Error", ex.Message], true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool IsBondRecentlyBought(Imperial2030.Shared.Models.Nation nation, int cost)
    {
        if (game == null) return false;
        var threshold = DateTime.UtcNow.AddSeconds(-30);
        return game.Actions.Any(a => {
            if (a.ActionType != "Investment" || a.Timestamp < threshold || string.IsNullOrEmpty(a.Metadata)) return false;
            try
            {
                var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.InvestmentMetadata>(a.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                return meta != null && meta.Nation == nation.ToString() && meta.Cost == cost;
            }
            catch { return false; }
        });
    }

    // Wrapper to match Action<string, bool> signature (fire and forget)
    private void OnShowToastAction(string message, bool isError)
    {
        _ = ShowToast(message, isError);
    }

    /// <summary>
    /// Renders a server-pushed toast in the viewer's language: looks the resource key up locally and
    /// substitutes its arguments, translating the ones flagged as nations. An unknown key falls back
    /// to the key itself rather than throwing, so a server/client version skew degrades visibly but
    /// harmlessly instead of breaking the toast pipeline.
    /// </summary>
    private string RenderToast(LocalizedToast toast)
    {
        if (toast == null || string.IsNullOrEmpty(toast.Code)) return string.Empty;

        var args = toast.Args
            .Select(a => a.IsNation ? Names.NationFromName(a.Value) : a.Value)
            .Cast<object>()
            .ToArray();

        return L[toast.Code, args];
    }

    private Task ShowToast(string message, bool isError)
    {
        toastQueue.Enqueue((message, isError));
        _ = ProcessToastQueueAsync();
        return Task.CompletedTask;
    }

    private async Task ProcessToastQueueAsync()
    {
        if (isDisplayingToast) return;
        isDisplayingToast = true;

        while (toastQueue.Count > 0)
        {
            var (message, isError) = toastQueue.Dequeue();
            toastMessage = message;
            isToastError = isError;
            StateHasChanged();
            
            await Task.Delay(toastQueue.Count > 1 ? 5000 : 7000);
            
            toastMessage = null;
            StateHasChanged();
            
            // Brief pause between toasts to distinguish them
            await Task.Delay(200);
        }

        isDisplayingToast = false;
    }

    private async Task ExitGame()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/leave", null);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/");
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                await ShowToast(L["Toast_LeaveGameFailed", errorBody], true);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private (int Bonus, int TreasuryGain, int PowerGain) GetTaxPreview(NationStateDto nationState, GameDetailDto? targetGame = null)
    {
        var curGame = targetGame ?? game;
        if (curGame == null) return (0, 0, 0);
        var nation = nationState.Nation;
        int unblockedFactories = TaxationRules.CountUnblockedFactories(curGame, nation);
        int flagCount = curGame.Territories.Count(ts => ts.Controller == nation);
        int totalTaxRevenue = TaxationRules.ComputeRevenue(unblockedFactories, flagCount);

        int unitCount = curGame.Units.Count(u => u.Nation == nation);
        int soldiersPay = TaxationRules.ComputeSoldiersPay(unitCount);
        
        int simulatedTreasury = nationState.Treasury + totalTaxRevenue;
        int actualPay = Math.Min(simulatedTreasury, soldiersPay);
        simulatedTreasury -= actualPay;

        int bonus = 0;
        if (curGame.VariantBonusOnlyForTaxIncreases)
        {
            int oldTier = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(nationState.TaxRevenue);
            int newTier = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(totalTaxRevenue);
            bonus = Math.Max(0, newTier - oldTier);
        }
        else
        {
            bonus = Imperial2030.Shared.Constants.TaxChart.GetStandardBonus(totalTaxRevenue);
        }
        
        int actualBonus = Math.Min(simulatedTreasury, bonus);
        simulatedTreasury -= actualBonus;

        int powerGain = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(totalTaxRevenue);
        
        int expectedTreasuryGain = simulatedTreasury - nationState.Treasury;

        return (actualBonus, expectedTreasuryGain, powerGain);
    }

    private bool isTogglingPause = false;
    private bool IsSinglePlayerGame() => game != null && game.Players.Count(p => !p.IsBot) <= 1;

    private async Task TogglePauseGame()
    {
        if (isTogglingPause || game == null) return;
        isTogglingPause = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/toggle-pause", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<TogglePauseResponse>();
                if (result != null)
                {
                    game.IsPaused = result.IsPaused;
                }
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                await ShowToast(L["Toast_TogglePauseFailed", errorBody], true);
            }
        }
        catch (Exception ex)
        {
            await ShowToast(L["Toast_TogglePauseError", ex.Message], true);
        }
        finally
        {
            isTogglingPause = false;
            StateHasChanged();
        }
    }

    private class TogglePauseResponse
    {
        public bool IsPaused { get; set; }
    }

    /// <summary>
    /// Rotates the Nations panel so the acting nation leads the list.
    ///
    /// In live play the change is held back briefly (see below) so the panel does not jump the instant
    /// a turn ends. Replay passes <paramref name="immediate"/> because it sets its own rhythm: at the
    /// fastest pacing a whole action takes 500ms, so a 3s lag would leave the panel several turns
    /// behind the board it is supposed to describe.
    /// </summary>
    private void UpdateDisplayedNation(Nation newNation, bool immediate = false)
    {
        if (_displayedTurnNation == null || immediate)
        {
            _nationRotationCts?.Cancel();
            _displayedTurnNation = newNation;
            return;
        }

        if (_displayedTurnNation != newNation)
        {
            _nationRotationCts?.Cancel();
            _nationRotationCts = new CancellationTokenSource();
            var token = _nationRotationCts.Token;

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(3000, token);
                    _displayedTurnNation = newNation;
                    await InvokeAsync(StateHasChanged);
                }
                catch (TaskCanceledException) { }
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        _nationRotationCts?.Cancel();
        _nationRotationCts?.Dispose();

        _replayPollCts?.Cancel();
        if (replaySessionId != null)
        {
            try { await Http.PostAsync($"api/games/replay/{replaySessionId}/stop", null); }
            catch { /* best-effort — leaving the page shouldn't block on this */ }
        }

        if (hubConnection is not null)
        {
            // Leaving the group is best-effort; disposing the connection is not. InvokeAsync throws when
            // the connection has already dropped — the ordinary case when navigating away, and certain on
            // network loss — and an unguarded throw here skipped DisposeAsync entirely, leaking the
            // connection. Same reasoning as the replay-stop call above, which was already guarded.
            try { await hubConnection.InvokeAsync("LeaveGameGroup", GameId.ToString(), MyPlayer == null); }
            catch { /* already disconnected: OnDisconnectedAsync cleans up presence server-side */ }

            await hubConnection.DisposeAsync();
        }
    }
}
