@code {
    private bool _showOnlyBoughtBonds = false;

    [Parameter]
    public Guid GameId { get; set; }

    private GameDetailDto? game;
    private HubConnection? hubConnection;
    private bool IsHost = false;
    private string? currentUserId;
    private int observerCount = 0;
    private PlayerDto? MyPlayer => game?.Players.FirstOrDefault(p => p.UserId == currentUserId);
    private GameMap? gameMap;
    private bool showGameOverPopup = true;
    private List<string> availableBotTypes = new() { "Default", "Aggressive", "Friendly", "Greedy", "RL", "Random" };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value;
        if (currentUserId == null)
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;


        await LoadGame();
        
        try
        {
            availableBotTypes = await Http.GetFromJsonAsync<List<string>>("api/games/available-bots") ?? availableBotTypes;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Could not fetch available bots: {ex.Message}");
        }

        var token = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "authToken");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"), options =>
            {
                if (!string.IsNullOrEmpty(token))
                {
                    options.AccessTokenProvider = () => Task.FromResult((string?)token);
                }
            })
            .Build();

        hubConnection.On<Guid>("GameUpdated", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });

        hubConnection.On<Guid>("GameStarted", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });

        hubConnection.On<string, bool>("UserPresenceChanged", (userId, isOnline) =>
        {
            if (game != null)
            {
                var player = game.Players.FirstOrDefault(p => p.UserId == userId);
                if (player != null && player.IsOnline != isOnline)
                {
                    player.IsOnline = isOnline;
                    if (!isOnline) player.IsActiveInGame = false;
                    StateHasChanged();
                }
            }
        });

        hubConnection.On<string, bool>("PlayerActiveChanged", (userId, isActive) =>
        {
            if (game != null)
            {
                var player = game.Players.FirstOrDefault(p => p.UserId == userId);
                if (player != null && player.IsActiveInGame != isActive)
                {
                    player.IsActiveInGame = isActive;
                    StateHasChanged();
                }
            }
        });

        hubConnection.On<int>("ObserverCountChanged", (count) =>
        {
            observerCount = count;
            StateHasChanged();
        });

        hubConnection.On<Guid>("GameDeleted", async (id) =>
        {
            if (id == GameId)
            {
                await ShowToast("The game has been deleted by the host.", true);
                Navigation.NavigateTo("/");
            }
        });

        hubConnection.On<string, bool>("ShowToast", OnShowToastAction);

        await hubConnection.StartAsync();
        observerCount = await hubConnection.InvokeAsync<int>("JoinGameGroup", GameId.ToString(), MyPlayer == null);
    }

    private async Task LoadGame()
    {
        try
        {
            game = await Http.GetFromJsonAsync<GameDetailDto>($"api/games/{GameId}");
            if (game != null && currentUserId != null)
            {
                var me = game.Players.FirstOrDefault(p => p.UserId == currentUserId);
                IsHost = me?.IsHost ?? false;

                if (selectedPlayerId == null)
                {
                    if (me != null)
                    {
                        selectedPlayerId = me.Id;
                    }
                    else if (game.Players.Any())
                    {
                        selectedPlayerId = game.Players.First().Id;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game: {ex.Message}");
            await ShowToast($"Game not found or access denied.", true);
            await Task.Delay(2000);
            Navigation.NavigateTo("/");
        }
    }

    private async Task StartGame()
    {
        var response = await Http.PostAsync($"api/games/{GameId}/start", null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            await ShowToast($"Failed to start game: {error}", true);
        }
    }

    private string selectedBotType = "";

    private async Task AddBot()
    {
        string url = $"api/games/{GameId}/add-bot";
        if (!string.IsNullOrEmpty(selectedBotType))
        {
            url += $"?botType={selectedBotType}";
        }
        var response = await Http.PostAsync(url, null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            await ShowToast($"Failed to add bot: {error}", true);
        }
    }

    private async Task RemoveBot(Guid playerId)
    {
        var response = await Http.PostAsync($"api/games/{GameId}/remove-bot/{playerId}", null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            await ShowToast($"Failed to remove bot: {error}", true);
        }
    }

    private string GetWinningNation()
    {
        if (game == null) return "Unknown";
        var winner = game.NationStates.OrderByDescending(n => n.Power).FirstOrDefault();
        return winner?.Nation.ToString() ?? "Unknown";
    }

    private string GetPlayerControlledNationsString(PlayerDto player)
    {
        if (game == null) return "";
        var controlledNations = game.NationStates
            .Where(ns => ns.ControllerId == player.Id)
            .Select(ns => ns.Nation)
            .ToList();

        if (controlledNations.Count == 0)
            return "🏦";

        var acronyms = controlledNations.Select(n => n switch
        {
            Imperial2030.Shared.Models.Nation.Russia => "🇷🇺",
            Imperial2030.Shared.Models.Nation.China => "🇨🇳",
            Imperial2030.Shared.Models.Nation.India => "🇮🇳",
            Imperial2030.Shared.Models.Nation.Brazil => "🇧🇷",
            Imperial2030.Shared.Models.Nation.USA => "🇺🇸",
            Imperial2030.Shared.Models.Nation.Europe => "🇪🇺",
            _ => ""
        });

        return string.Join(" ", acronyms);
    }

    private int GetPlayerScore(PlayerDto player)
    {
        if (game == null) return 0;
        var g = game!;
        int score = player.Cash;
        if (player.Bonds != null)
        {
            foreach (var bond in player.Bonds)
            {
                var nation = g.NationStates.FirstOrDefault(n => n.Nation == bond.Nation);
                if (nation != null)
                {
                    int factor = nation.Power / 5;
                    score += bond.Interest * factor;
                }
            }
        }
        return score;
    }

    private List<PlayerDto> GetRankedPlayers()
    {
        if (game == null || game.Players == null) return new List<PlayerDto>();
        
        var rankedNations = game.NationStates != null 
            ? game.NationStates.OrderByDescending(ns => ns.Power).Select(ns => ns.Nation).ToList()
            : new List<Imperial2030.Shared.Models.Nation>();

        var playerScores = game.Players.ToDictionary(p => p.Id, p => GetPlayerScore(p));
        var playerCredits = game.Players.ToDictionary(p => p.Id, p =>
        {
            var credits = new Dictionary<Imperial2030.Shared.Models.Nation, int>();
            foreach (var nation in rankedNations)
            {
                credits[nation] = p.Bonds?.Where(b => b.Nation == nation).Sum(b => b.Cost) ?? 0;
            }
            return credits;
        });

        var ranked = game.Players.ToList();
        ranked.Sort((p1, p2) =>
        {
            int scoreDiff = playerScores[p2.Id].CompareTo(playerScores[p1.Id]);
            if (scoreDiff != 0) return scoreDiff;

            foreach (var nation in rankedNations)
            {
                int creditDiff = playerCredits[p2.Id][nation].CompareTo(playerCredits[p1.Id][nation]);
                if (creditDiff != 0) return creditDiff;
            }

            return 0;
        });

        return ranked;
    }

    private bool IsMyTurn()
    {
        if (game == null) return false;
        // If game is finished, no one's turn
        if (game.Status == GameStatus.Finished) return false;

        if (game.Status != GameStatus.InProgress) return false;
        // If it's investor turn, the global "Turn" is effectively paused for the nation controller
        if (game.IsInvestorTurn) return false;
        var currentNationState = game.NationStates.FirstOrDefault(ns => ns.Nation == game.CurrentTurnNation);
        return currentNationState?.ControllerName == MyPlayer?.UserName;
    }

    private bool IsPlayerActive(PlayerDto player)
    {
        if (game == null) return false;
        if (game.Status != GameStatus.InProgress) return false;

        if (game.IsInvestorTurn)
        {
            return game.ActingPlayerId == player.Id;
        }

        var currentNationState = game.NationStates.FirstOrDefault(ns => ns.Nation == game.CurrentTurnNation);
        return currentNationState?.ControllerName == player.UserName;
    }

