@page "/game/{GameId:guid}"
@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@using System.Globalization
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Imperial2030.Client.Components
@inject NavigationManager Navigation
@inject HttpClient Http
@inject Imperial2030.Client.Services.ManeuverService ManeuverService
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<GameRoom> L
@inject IStringLocalizer<SharedResource> Shared
@inject DisplayNameLocalizer Names
@implements IAsyncDisposable

<PageTitle>@(IsMyTurn() ? L["TitleYourTurnPrefix"].Value : "")@(game != null ? $"{game.Name} - " : "")Imperial 2030</PageTitle>

@if (game == null)
{
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-white">@L["LoadingArchives"]</p>
        </div>
}
else
{
        <div class="game-container">

            <SectionContent SectionName="top-bar-info">
                <span class="text-white-50 small"><strong>@game.Name</strong></span>
                <span class="text-white-50 small px-3 d-none d-md-inline" style="border-left: 1px solid rgba(255,255,255,0.2);">@L["TopBar_GameId", GameId.ToString().Substring(0, 8)]</span>
                @if (game.Players.FirstOrDefault(p => p.IsHost) is var host && host != null)
                {
                    <span class="text-white-50 small px-3 d-none d-md-inline" style="border-left: 1px solid rgba(255,255,255,0.2);">@L["TopBar_Host"] <strong class="text-white">@host.UserName</strong></span>
                }
                @if (game.IsPrivate && game.IsCurrentUserHost && game.JoinCode != null)
                {
                    <span class="text-info small px-3 d-none d-lg-inline" style="border-left: 1px solid rgba(255,255,255,0.2);">@L["TopBar_JoinCode"] <strong>@game.JoinCode</strong></span>
                }
                @if (game.VariantBonusOnlyForTaxIncreases)
                {
                    <span class="badge bg-warning text-dark ms-2">@L["TopBar_VariantTaxBonus"]</span>
                }
                @if (game.Status == GameStatus.InProgress && IsSinglePlayerGame() && MyPlayer != null)
                {
                    <button class="btn btn-sm @(game.IsPaused ? "btn-warning" : "btn-outline-light") ms-3 px-3 py-0 d-inline-flex align-items-center gap-1 fw-bold shadow-sm"
                            style="height: 28px; border-radius: 6px;"
                            @onclick="TogglePauseGame"
                            disabled="@isTogglingPause"
                            title="@(game.IsPaused ? L["TopBar_ResumeGame"].Value : L["TopBar_PauseGame"].Value)">
                        <i class="bi @(game.IsPaused ? "bi-play-fill" : "bi-pause-fill")"></i>
                        @(game.IsPaused ? L["TopBar_Resume"] : L["TopBar_Pause"])
                    </button>
                }
            </SectionContent>

            <div class="sidebar-left">
            @if (game.PendingBattleTerritoryId != null)
            {
                        <div class="panel mb-3 border border-warning" style="background-color: rgba(230, 126, 34, 0.1);">
                            <div class="text-center">
                                <h4 class="text-warning mb-2 fw-bold"><i class="oi oi-warning"></i> @L["Battle_PendingTitle"]</h4>
                                <h5 class="text-white">@Names.Territory(game.PendingBattleTerritoryId).ToUpper()</h5>
                                <hr class="border-warning" />

                        @{
                            // Check if current player controls any of the defending nations
                            var myDefendingNations = game.PendingBattleDefenders
                                .Where(d => game.NationStates.Any(ns => ns.Nation == d && ns.ControllerId == MyPlayer?.Id))
                                .ToList();

                            bool amIDefender = myDefendingNations.Any();
                        }

                        @if (amIDefender)
                        {
                            var currentRespondingNation = myDefendingNations.First();
                                        <p class="mb-3 small">@((MarkupString)L["Battle_Prompt", Names.Nation(game.PendingBattleAggressorNation), Names.Nation(currentRespondingNation), Names.Nation(currentRespondingNation)].Value)</p>
                                        <div class="d-flex flex-column gap-2 mt-2">
                                            <button class="btn btn-sm btn-success fw-bold" @onclick="() => RespondToBattle(false)">
                                                <i class="oi oi-thumb-up"></i> @L["Battle_AcceptPeace"]
                                            </button>
                                            <button class="btn btn-sm btn-danger fw-bold" @onclick="() => RespondToBattle(true)">
                                                <i class="oi oi-fire"></i> @L["Battle_Fight"]
                                            </button>
                                        </div>
                        }
                        else
                        {
                                        <p class="small mb-0">@L["Battle_WaitingPrefix"] @((MarkupString)L["Battle_Waiting", string.Join(", ", game.PendingBattleDefenders.Select(d => Names.Nation(d))), Names.Nation(game.PendingBattleAggressorNation)].Value)</p>
                                        <div class="spinner-border spinner-border-sm text-warning mt-2" role="status">
                                            <span class="visually-hidden">@Shared["Common_Loading"]</span>
                                        </div>
                        }
                            </div>
                        </div>
            }

            @if (game.PendingSwissBankForceNation != null)
            {
                        <div class="panel mb-3 border border-info" style="background-color: rgba(23, 162, 184, 0.1);">
                            <div class="text-center">
                                <h4 class="text-info mb-2 fw-bold"><i class="oi oi-info"></i> @L["Swiss_Title"]</h4>
                                <p class="small mb-2">@((MarkupString)L["Swiss_Explanation", Names.Nation(game.PendingSwissBankForceNation)].Value)</p>
                                <hr class="border-info" />

                        @{
                            bool amISwissBankResponder = MyPlayer != null && game.PendingSwissBankResponders.Contains(MyPlayer.Id);
                        }

                        @if (amISwissBankResponder)
                        {
                            var myBonds = MyPlayer.Bonds.Where(b => b.Nation == game.PendingSwissBankForceNation).ToList();
                            int totalInterest = myBonds.Sum(b => b.Interest);
                            bool hasInvestment = totalInterest > 0;

                                        <p class="mb-3 small">@L["Swiss_Question"]</p>
                                        <div class="d-flex flex-column gap-2 mt-2">
                                            <button class="btn btn-sm btn-success fw-bold @(hasInvestment ? "pulse-valid-invest" : "")" 
                                                    title="@L["Swiss_ForceStopTitle", totalInterest]"
                                                    @onclick="() => RespondToSwissBank(true)">
                                                <i class="oi oi-media-pause"></i> @L["Swiss_ForceStop"]
                                            </button>
                                            <button class="btn btn-sm btn-danger fw-bold @(!hasInvestment ? "pulse-pass-invest" : "")" 
                                                    title="@L["Swiss_AllowPassTitle"]"
                                                    @onclick="() => RespondToSwissBank(false)">
                                                <i class="oi oi-media-skip-forward"></i> @L["Swiss_AllowPass"]
                                            </button>
                                        </div>
                        }
                        else
                        {
                            @* HTML-encoded because the result is rendered as a MarkupString below, which
                               bypasses Blazor's own encoding. The resource string legitimately contains
                               markup; these names do not. Identity's default AllowedUserNameCharacters
                               happens to exclude < and >, but nothing here should depend on a default set
                               in Program.cs - loosening it (to allow spaces or non-Latin names) must not
                               silently turn this into stored XSS. Nation names above are enum-driven and
                               need no encoding. *@
                            var respondersNames = game.Players
                                .Where(p => game.PendingSwissBankResponders.Contains(p.Id))
                                .Select(p => System.Net.WebUtility.HtmlEncode(p.UserName));
                                        <p class="small mb-0">@((MarkupString)L["Swiss_Waiting", string.Join(", ", respondersNames)].Value)</p>
                                        <div class="spinner-border spinner-border-sm text-info mt-2" role="status">
                                            <span class="visually-hidden">@Shared["Common_Loading"]</span>
                                        </div>
                        }
                            </div>
                        </div>
            }

                <div class="panel">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h4 class="m-0">@L["Players_Title"]</h4>
                    @if (observerCount > 0)
                    {
                                <span class="badge bg-secondary" title="@L["Players_Observers", observerCount]">
                                    <i class="oi oi-eye pe-1"></i> @observerCount
                                </span>
                    }
                    </div>
                    <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var player in game.Players.OrderBy(p => p.Id))
                    {
                                <li class="list-group-item bg-transparent text-white d-flex flex-column @(IsPlayerActive(player) ? "active-player-highlight" : (game.InvestorCardHolderId == player.Id ? "" : "px-0")) @(game.InvestorCardHolderId == player.Id ? "border border-info rounded my-2 p-2" : "")" style="@(game.InvestorCardHolderId == player.Id ? "border-width: 2px !important;" : "")">
                                    <div class="d-flex justify-content-between align-items-center w-100">
                                        <span class="d-flex align-items-center gap-2 flex-grow-1" style="min-width: 0; padding-right: 8px;">
                                @if (player.IsBot)
                                {
                                                <span class="flex-shrink-0" title="@L["Players_BotPlayer"]">🤖</span>
                                }
                                else
                                {
                                                <span class="rounded-circle d-inline-block flex-shrink-0" 
                                                      style="width: 10px; height: 10px; background-color: @(player.IsOnline ? (player.IsActiveInGame ? "#28a745" : "#ffc107") : "#dc3545");"
                                                      title="@(player.IsOnline ? (player.IsActiveInGame ? L["Players_InGame"].Value : L["Players_Online"].Value) : L["Players_Offline"].Value)"></span>
                                }
                                        <span class="text-truncate" style="font-size: 0.85em;" title="@player.UserName">@player.UserName</span>
                                        <span class="ms-1 flex-shrink-0 fw-bold" style="font-size: 0.85em; white-space: nowrap; color: #ced4da;" title="@L["Players_ControlledNations"]">@GetPlayerControlledNationsString(player)</span>
                                    </span>
                                    <div class="d-flex align-items-center justify-content-end gap-1 flex-shrink-0">
                                        <span class="badge bg-warning text-dark position-relative" title="@L["Players_Cash"]">
                                            $@(player.Cash)M
                                            @if (_playerCashEffects.TryGetValue(player.Id, out var effect) && (DateTime.Now - effect.Timestamp).TotalSeconds < 5.5)
                                            {
                                                <span @key="effect.TriggerId" class="floating-cash @(effect.Delta > 0 ? "positive" : "negative")">
                                                    @(effect.Delta > 0 ? "+$" : "-$")@(Math.Abs(effect.Delta))M
                                                </span>
                                            }
                                        </span>
                                        <span class="badge bg-success" title="@L["Players_VpTooltip"]">@L["Players_Vp", GetPlayerScore(player)]</span>
                                @if (player.IsBot && IsHost && game.Status == GameStatus.Lobby)
                                {
                                                <button class="btn btn-outline-danger btn-sm py-0 px-1" style="font-size: 0.7rem; line-height: 1;" @onclick="@(() => RemoveBot(player.Id))" title="@L["Players_RemoveBot"]">✕</button>
                                }
                                    </div>
                                    </div>
                                    @if (game.InvestorCardHolderId == player.Id)
                                    {
                                        <div class="w-100 mt-2 text-center text-info fw-bold" style="background-color: rgba(23, 162, 184, 0.1); padding: 2px 0; border-radius: 4px; font-size: 0.85em; letter-spacing: 1px;">
                                            @L["Players_InvestorCard"]
                                        </div>
                                    }
                                </li>
                    }
                    </ul>
                </div>

                <!-- Investor Action Panel -->
            @if (game.IsInvestorTurn)
            {
                        <div class="panel mt-3 border-info @(MyPlayer?.Id == game.ActingPlayerId ? "panel-investor-pulse" : "")">
                            <h4 class="text-info">@L["Investor_Title"]</h4>
                    @if (MyPlayer?.Id == game.ActingPlayerId)
                    {
                                    <div class="d-flex justify-content-between align-items-center mb-3 mt-2 bg-dark p-2 rounded border border-warning">
                                        <span class="text-white fw-bold">@L["Investor_AvailableToInvest"]</span>
                                        <span class="badge bg-warning text-dark" style="font-size: 1.1em;">$@(MyPlayer.Cash)M</span>
                                    </div>
                                    <p class="small text-muted mb-3">
                                        @if (game.InvestorCardHolderId == MyPlayer.Id)
                                        {
                                            <text>@L["Investor_HoldsCard"]</text>
                                        }
                                        else
                                        {
                                            <text>@L["Investor_SwissBank"]</text>
                                        }
                                    </p>

                                    <div class="d-grid gap-2">
                                         @{
                                             bool hasValidOption = false;
                                             foreach (var testBond in game.AvailableBonds)
                                             {
                                                 if ((MyPlayer?.Cash ?? 0) >= testBond.Cost) hasValidOption = true;
                                                 var testOwned = MyPlayer?.Bonds?.Where(b => b.Nation == testBond.Nation) ?? Enumerable.Empty<Imperial2030.Shared.Models.BondDto>();
                                                 foreach (var owned in testOwned)
                                                 {
                                                     if (owned.Cost < testBond.Cost && (MyPlayer?.Cash ?? 0) >= (testBond.Cost - owned.Cost)) hasValidOption = true;
                                                 }
                                             }
                                         }
                                         <button class="btn btn-secondary @(!hasValidOption ? "btn-endturn-pulse" : "")" @onclick="@(() => PerformInvestment("Pass", null, null))">@L["Investor_Pass"]</button>

                                         <h6 class="mt-2 text-white border-bottom pb-1">@L["Investor_AvailableBonds"]</h6>
                                         <div style="max-height: 200px; overflow-y: auto;">
                                @foreach (var bond in game.AvailableBonds.OrderBy(b => b.Nation).ThenBy(b => b.Cost))
                                {
                                    bool canAffordFull = (MyPlayer?.Cash ?? 0) >= bond.Cost;

                                    // Check for upgrade
                                    var ownedBonds = (MyPlayer?.Bonds?.Where(b => b.Nation == bond.Nation).OrderByDescending(b => b.Cost) ?? Enumerable.Empty<Imperial2030.Shared.Models.BondDto>()).ToList();

                                                     <div class="mb-1">
                                                         <button class="btn btn-sm btn-outline-primary w-100 text-start @(canAffordFull ? "btn-investor-pulse-green" : "")" 
                                                                 disabled="@(!canAffordFull)"
                                        @onclick="@(() => PerformInvestment("Buy", bond.Id, null))">
                                                             <span class="fw-bold">@Names.Nation(bond.Nation)</span> @L["Investor_BondInterest", bond.Interest] 
                                                             <span class="float-end badge @(canAffordFull ? "bg-success" : "bg-danger")">@L["Investor_BondCost", bond.Cost]</span>
                                                         </button>
                                        @foreach (var owned in ownedBonds)
                                        {
                                            if (owned.Cost < bond.Cost)
                                            {
                                                int diff = bond.Cost - owned.Cost;
                                                bool canAffordUpgrade = (MyPlayer?.Cash ?? 0) >= diff;
                                                                         <button class="btn btn-sm btn-outline-info w-100 mt-1 text-end small @(canAffordUpgrade ? "btn-investor-pulse-green" : "")"
                                                                                 disabled="@(!canAffordUpgrade)"
                                                @onclick="@(() => PerformInvestment("Buy", bond.Id, owned.Id))">
                                                                             <small>@L["Investor_Upgrade", owned.Cost, diff]</small>
                                                                         </button>
                                            }
                                        }
                                                     </div>
                                }
                                         </div>
                                    </div>
                    }
                    else
                    {
                                    <p class="text-warning">@L["Investor_WaitingAction"]</p>
                                    <small>@L["Investor_CurrentActor", game.Players.FirstOrDefault(p => p.Id == game.ActingPlayerId)?.UserName ?? ""]</small>
                    }
                        </div>
            }
                <div class="panel mt-3">
                @{
                    var currentNs = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
                    bool isLocked = currentNs?.HasMovedThisTurn ?? false;
                }

                    <div style="max-width: 380px; margin: 0 auto;">
                        <Rondel 
                            NationStates="@game.NationStates" 
                            CurrentTurnNation="@game.CurrentTurnNation"
                            IsMyTurn="@IsMyTurn()"
                            IsLocked="@isLocked"
                            OnMoveSelected="@OnRondelMove"
                            Game="@game"
                            CurrentPlayerId="@MyPlayer?.Id" />
                    </div>

                    <div class="mt-1 text-center">
                        <span class="text-muted small text-uppercase">@L["CurrentTurn"]</span>
                        <h3 class="fw-bold text-white mb-1">@Names.Nation(game.CurrentTurnNation)</h3>
                    </div>

                @if (IsMyTurn())
                {
                    var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
                    bool alreadyBuilt = ns?.HasBuiltThisTurn ?? false;
                    bool turnMoved = ns?.HasMovedThisTurn ?? false;

                            <div class="mt-2 d-grid gap-2">
                        @if (CanBuildFactory() && !alreadyBuilt && turnMoved)
                        {
                                        <div class="card bg-dark border-secondary">
                                            <div class="card-header text-center">@L["BuildFactory_Title"]</div>
                                            <div class="card-body p-2">
                                                <p class="small text-muted mb-2">@L["BuildFactory_Prompt"]</p>
                                    @foreach (var t in GetValidFactoryTerritories())
                                    {
                                                        <button class="btn btn-sm btn-outline-info w-100 mb-1" @onclick="@(() => BuildFactory(t.Id))">
                                            @Names.Territory(t.Id)
                                                        </button>
                                    }
                                            </div>
                                        </div>
                        }

                        @if (CanImport() && turnMoved && !alreadyBuilt) // reusing alreadyBuilt variable name? No, wait. 
                                                                       // Import slot is different from Factory.
                                                                       // CanImport checks specific slot. 
                                                                       // But wait, "alreadyBuilt" was defined as "ns?.HasBuiltThisTurn".
                                                                       // Import has its own flag. 
                        {
                                         <div class="card bg-dark border-secondary mb-2">
                                            <div class="card-header text-center py-1">@L["Import_Title"]</div>
                                            <div class="card-body p-2">
                                                <p class="small text-muted mb-2">@L["Import_Prompt"]</p>

                                    @foreach (var unit in pendingImports)
                                    {
                                                        <div class="mb-2 bg-black bg-opacity-25 rounded p-1">
                                                            <div class="d-flex justify-content-between mb-1 gap-2">
                                                                <select class="form-select form-select-sm py-0 bg-dark text-white border-secondary" 
                                                                        value="@unit.UnitType" 
                                                @onchange="@(e => OnImportUnitTypeChanged(unit, e.Value))"
                                                                        style="height: 28px;">
                                                                    <option value="@UnitType.Army">@Names.UnitType(UnitType.Army)</option>
                                                                    <option value="@UnitType.Fleet">@Names.UnitType(UnitType.Fleet)</option>
                                                                </select>
                                                                <button class="btn btn-outline-danger btn-sm py-0" type="button" @onclick="() => RemoveImportUnit(unit)" style="height: 28px;">✕</button>
                                                            </div>
                                                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="unit.UnitType" hidden></select> @* Dummy to force re-render if needed, actually binding below *@
                                                            <select class="form-select form-select-sm bg-dark text-white border-secondary" @bind="unit.TerritoryId">
                                                @foreach (var t in GetValidImportTerritories(unit.UnitType))
                                                {
                                                                        <option value="@t.Id">@Names.Territory(t.Id)</option>
                                                }
                                                            </select>
                                                        </div>
                                    }

                                    @if (pendingImports.Count < 3)
                                    {
                                                        <button class="btn btn-sm btn-outline-success w-100 mb-2" @onclick="AddImportUnit">@L["Import_AddUnit"]</button>
                                    }

                                                <button class="btn btn-sm btn-primary w-100 fw-bold" @onclick="ExecuteImport" disabled="@(isSubmitting || pendingImports.Count == 0)">
                                                    @L["Import_Confirm", pendingImports.Count]
                                                </button>
                                            </div>
                                        </div>
                        }



                        @if (CanProduce() && turnMoved)
                        {
                                         <button class="btn btn-primary w-100 fw-bold mb-2" @onclick="ExecuteProduction" disabled="@isSubmitting">
                                             @L["ExecuteProduction"]
                                         </button>
                        }

                        @if (CanTax() && turnMoved)
                        {
                                         <button class="btn btn-warning w-100 fw-bold mb-2" @onclick="CollectTaxation" disabled="@isSubmitting">
                                             @L["ExecuteTaxation"]
                                         </button>
                        }
                        else
                        {
                            bool noActionsLeft = false;
                            if (turnMoved && !isSubmitting && !game.IsInvestorTurn)
                            {
                                noActionsLeft = true;
                                if (CanBuildFactory() && !alreadyBuilt) noActionsLeft = false;
                                if (CanImport() && ns != null && !ns.HasImportedThisTurn) noActionsLeft = false;
                                if (CanProduce()) noActionsLeft = false;
                                if (RondelData.IsManeuverSlot(ns?.RondelPosition ?? -1))
                                {
                                    if (game.ManeuverState?.Phase != ManeuverPhase.None)
                                    {
                                        noActionsLeft = false;
                                    }
                                }
                            }

                                        <button class="btn btn-warning fw-bold @(noActionsLeft ? "btn-endturn-pulse" : "")" @onclick="EndTurn" disabled="@(!turnMoved || isSubmitting || game.IsInvestorTurn)">
                                            @L["EndTurn"]
                                @if (game.IsInvestorTurn)
                                {
                                    <span>@L["EndTurn_WaitingInvestor"]</span>
                                }
                                        </button>
                        }

                            </div>
                }
                </div>


            @if (game.Status == GameStatus.InProgress)
            {
                        <div class="panel mt-3 pb-1">
                            <details open>
                                <summary class="h4 m-0 text-white" style="cursor: pointer; user-select: none;">
                                    @L["Nations_Title"]
                                </summary>
                                <div class="mt-3">
                                    <ul class="list-group list-group-flush bg-transparent small">
                        @foreach (var ns in game.NationStates.OrderBy(n => ((int)n.Nation - (int)(_displayedTurnNation ?? game.CurrentTurnNation) + 6) % 6))
                        {
                                        <li class="list-group-item bg-transparent text-white @(ns.Nation == game.CurrentTurnNation ? "active-player-highlight" : "px-0")">
                                            <b>@Names.Nation(ns.Nation)</b><br/>
                                            <span class="text-info">
                                                @L["Nations_Treasury"] <span class="position-relative">$@(ns.Treasury)M
                                                @if (_nationTreasuryEffects.TryGetValue(ns.Nation, out var tEffect) && (DateTime.Now - tEffect.Timestamp).TotalSeconds < 5.5)
                                                {
                                                    <span @key="tEffect.TriggerId" class="floating-cash @(tEffect.Delta > 0 ? "positive" : "negative")">
                                                        @(tEffect.Delta > 0 ? "+$" : "-$")@(Math.Abs(tEffect.Delta))M
                                                    </span>
                                                }
                                                </span>
                                            </span> | 
                                            <span class="text-warning">
                                                @L["Nations_Power"] <span class="position-relative">@ns.Power
                                                @if (_nationPowerEffects.TryGetValue(ns.Nation, out var pEffect) && (DateTime.Now - pEffect.Timestamp).TotalSeconds < 5.5)
                                                {
                                                    <span @key="pEffect.TriggerId" class="floating-cash @(pEffect.Delta > 0 ? "positive" : "negative")">
                                                        @(pEffect.Delta > 0 ? "+" : "")@(pEffect.Delta)
                                                    </span>
                                                }
                                                </span> (@(RondelData.GetPowerFactor(ns.Power))x)
                                            </span><br/>
                                            @{
                                                var taxInfo = GetTaxPreview(ns);
                                            }
                                            <span class="text-success small">@L["Nations_TaxPreview", taxInfo.PowerGain, (taxInfo.TreasuryGain >= 0 ? "+" : "") + taxInfo.TreasuryGain, taxInfo.Bonus]</span><br/>
                                            <span class="text-muted">@L["Nations_Controller", ns.ControllerName ?? Shared["Common_None"].Value]</span>
                                @{
                                    var flagNames = game.Territories
                                        .Where(t => t.Controller == ns.Nation)
                                        .Select(t => Names.Territory(t.TerritoryId))
                                        .OrderBy(n => n)
                                        .ToList();

                                    var armyNames = game.Units
                                        .Where(u => u.Nation == ns.Nation && u.UnitType == UnitType.Army)
                                        .Select(u => Names.Territory(u.TerritoryId))
                                        .OrderBy(n => n)
                                        .ToList();

                                    var fleetNames = game.Units
                                        .Where(u => u.Nation == ns.Nation && u.UnitType == UnitType.Fleet)
                                        .Select(u => Names.Territory(u.TerritoryId))
                                        .OrderBy(n => n)
                                        .ToList();

                                    var armiesMax = Imperial2030.Shared.Constants.NationData.GetMaxArmies(ns.Nation);
                                    var fleetsMax = Imperial2030.Shared.Constants.NationData.GetMaxFleets(ns.Nation);
                                }
                                            <div class="small text-white-50 mt-1 d-flex justify-content-between">
                                                <span title="@string.Join(", ", flagNames)" style="cursor: help"><i class="oi oi-flag"></i> @L["Nations_Flags", flagNames.Count]</span> 
                                                <span title="@string.Join(", ", armyNames)" style="cursor: help"><i class="oi oi-people"></i> @L["Nations_Armies", armyNames.Count, armiesMax]</span> 
                                                <span title="@string.Join(", ", fleetNames)" style="cursor: help"><i class="oi oi-boat"></i> @L["Nations_Fleets", fleetNames.Count, fleetsMax]</span>
                                            </div>
                                @{
                                    var builtFactories = Imperial2030.Shared.Constants.TerritoryData.AllTerritories
                                        .Where(t => t.Nation == ns.Nation && game.Territories.Any(ts => ts.TerritoryId == t.Id && ts.HasFactory))
                                        .Select(t => Names.Territory(t.Id))
                                        .ToList();
                                }
                                @if (builtFactories.Any())
                                {
                                                    <div class="mt-1 text-white-50">
                                                        <i class="oi oi-home small"></i> @L["Nations_Factories", string.Join(", ", builtFactories)]
                                                    </div>
                                }
                                        </li>
                        }
                                    </ul>
                                </div>
                            </details>
                        </div>
            }

                <div class="mt-auto pt-3 d-grid gap-2">
                @if (IsHost && game.Status == GameStatus.Lobby)
                {
                             <div class="input-group">
                                 <select class="form-select bg-dark text-white border-secondary" @bind="selectedBotType">
                                     <option value="">@L["Host_RandomBot"]</option>
                                     @foreach (var botType in availableBotTypes)
                                     {
                                         <option value="@botType">@L["Host_BotOption", Names.BotType(botType)]</option>
                                     }
                                 </select>
                                 <button class="btn btn-outline-info" @onclick="AddBot" disabled="@(game.Players.Count >= game.MaxPlayers)">
                                     @L["Host_AddBot"]
                                 </button>
                             </div>
                             <button class="btn btn-success" @onclick="StartGame" disabled="@(game.Players.Count < 2)">@L["Host_StartGame"]</button>
                }
                @if (game.Status == GameStatus.Lobby)
                {
                             <button class="btn btn-danger" @onclick="ExitGame" disabled="@isSubmitting">@L["LeaveGame"]</button>
                }
                else
                {
                             <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/"))">@L["ReturnToLobby"]</button>
                }
                </div>
            </div>

            <div class="main-board-container">
        @if (game.Status == GameStatus.Finished && !isReplayMode)
        {
            <div class="d-flex justify-content-center gap-2 my-2">
                <button class="btn btn-sm btn-outline-light d-flex align-items-center justify-content-center" style="background-color: #2c3e50; border-radius: 8px; padding: 0.5rem 1rem;" @onclick="StartReplayViewing"><i class="bi bi-film me-1"></i>@L["Replay_Start"]</button>
                <a class="btn btn-sm btn-outline-light d-flex align-items-center justify-content-center" style="background-color: #2c3e50; border-radius: 8px; padding: 0.5rem 1rem;" href="@($"api/games/{GameId}/export")" download><i class="bi bi-download me-1"></i>@L["Replay_Export"]</a>
            </div>
        }
        else if (isReplayMode)
        {
            <div class="d-flex justify-content-center gap-2 my-2 mx-auto" style="background-color: #2c3e50; border-radius: 8px; padding: 0.5rem 1rem; width: fit-content;">
                <button class="btn btn-sm btn-outline-light d-flex align-items-center justify-content-center" @onclick="TogglePauseReplay" disabled="@(replayState?.IsComplete == true)"><i class="bi @(replayState?.IsPaused == true ? "bi-play-fill" : "bi-pause-fill")"></i> @(replayState?.IsPaused == true ? L["Replay_Resume"] : L["Replay_Pause"])</button>
                <button class="btn btn-sm btn-outline-light d-flex align-items-center justify-content-center" @onclick="ResetReplayViewing"><i class="bi bi-arrow-counterclockwise"></i> @L["Replay_Reset"]</button>
                <button class="btn btn-sm btn-outline-danger d-flex align-items-center justify-content-center" @onclick="ExitReplayViewing"><i class="bi bi-x-lg"></i> @L["Replay_Exit"]</button>

                <span class="replay-speed-divider" aria-hidden="true"></span>

                @* Transport-style speed control: rewind/fast-forward step through ReplaySpeed.PresetPacingsMs
                   and the readout is a multiplier, which is what a viewer actually wants to express. Buttons
                   disable by asking Step whether the ladder can move, so the ends can never be reached by a
                   comparison that disagrees with what the step would actually do. The server normalizes
                   regardless and returns what it applied, which is what gets displayed. *@
                <div class="replay-speed" role="group" aria-label="@L["Replay_Speed"]">
                    <button class="btn btn-sm btn-outline-light replay-speed-step" title="@L["Replay_Slower"]" aria-label="@L["Replay_Slower"]"
                            @onclick="() => StepReplaySpeed(-1)"
                            disabled="@(ReplaySpeed.Step(CurrentPacingMs, -1) == CurrentPacingMs)">
                        <i class="bi bi-rewind-fill"></i>
                    </button>
                    <span class="replay-speed-value" title="@L["Replay_Speed"]">@L["Replay_SpeedMultiplier", FormatMultiplier(CurrentPacingMs)]</span>
                    <button class="btn btn-sm btn-outline-light replay-speed-step" title="@L["Replay_Faster"]" aria-label="@L["Replay_Faster"]"
                            @onclick="() => StepReplaySpeed(1)"
                            disabled="@(ReplaySpeed.Step(CurrentPacingMs, 1) == CurrentPacingMs)">
                        <i class="bi bi-fast-forward-fill"></i>
                    </button>
                </div>
            </div>
        }
            <div class="main-board">
        @if (isReplayMode)
        {
            <div class="turn-alert-wrapper">
                <div class="turn-alert-overlay" style="background: linear-gradient(135deg, rgba(155, 89, 182, 0.95) 0%, rgba(108, 52, 131, 0.95) 100%); --alert-color: rgba(155, 89, 182, 0.95);">
                    <div class="alert-content">
                        <h3><i class="bi bi-film me-2"></i>@L["Replay_Banner"]</h3>
                        <small>
                            @if (replayState != null)
                            {
                                @L["Replay_Progress", replayState.CurrentActionIndex + 1, replayState.TotalActions, replayState.IsPaused ? L["Replay_Paused"].Value : replayState.IsComplete ? L["Replay_Complete"].Value : ""]
                            }
                            else
                            {
                                @L["Replay_Starting"]
                            }
                        </small>
                    </div>
                </div>
            </div>
        }
        else if (game.IsPaused)
        {
            <div class="turn-alert-wrapper">
                <div class="turn-alert-overlay" style="background: linear-gradient(135deg, rgba(243, 156, 18, 0.95) 0%, rgba(211, 84, 0, 0.95) 100%); --alert-color: rgba(243, 156, 18, 0.95);">
                    <div class="alert-content">
                        <h3><i class="bi bi-pause-circle-fill me-2"></i>@L["Alert_GamePaused"]</h3>
                        <small>@L["Alert_GamePausedSub"]</small>
                    </div>
                </div>
            </div>
        }
        else if (IsMyTurn())
        {
            <div class="turn-alert-wrapper">
                <div class="turn-alert-overlay" style="background: linear-gradient(135deg, rgba(231, 76, 60, 0.95) 0%, rgba(192, 57, 43, 0.95) 100%); --alert-color: rgba(231, 76, 60, 0.95);">
                    <div class="alert-content">
                        <h3><i class="bi bi-bell-fill me-2"></i>@L["Alert_YourMove"]</h3>
                        <small>@L["Alert_YouControl", Names.Nation(game.CurrentTurnNation)]</small>
                    </div>
                </div>
            </div>
        }
        else if (MyPlayer != null && IsPlayerActive(MyPlayer))
        {
            <div class="turn-alert-wrapper">
                <div class="turn-alert-overlay" style="background: linear-gradient(135deg, rgba(230, 126, 34, 0.95) 0%, rgba(211, 84, 0, 0.95) 100%); --alert-color: rgba(230, 126, 34, 0.95);">
                    <div class="alert-content">
                        <h3><i class="bi bi-person-fill-exclamation me-2"></i>@L["Alert_InvestorPhase"]</h3>
                        <small>@L["Alert_YourTurnToAct"]</small>
                    </div>
                </div>
            </div>
        }
        else if (MyPlayer == null)
        {
            <div class="turn-alert-wrapper">
                <div class="turn-alert-overlay" style="background: linear-gradient(135deg, rgba(52, 152, 219, 0.95) 0%, rgba(41, 128, 185, 0.95) 100%); --alert-color: rgba(52, 152, 219, 0.95);">
                    <div class="alert-content">
                        <h3><i class="bi bi-eye-fill me-2"></i>@L["Alert_ObserverMode"]</h3>
                        <small>@L["Alert_Watching"]</small>
                    </div>
                </div>
            </div>
        }
            @if (game.Status == GameStatus.InProgress)
            {
                          <div style="position: relative; width: 100%; display: flex; flex-direction: column; align-items: center; flex: 1;">
                    @if (!string.IsNullOrEmpty(toastMessage))
                    {
                        <div class="toast-notification-wrapper">
                            <div class="toast-notification @(isToastError ? "toast-error" : "toast-success")">
                                <div class="toast-content">
                                    <i class="bi @(isToastError ? "bi-exclamation-octagon-fill" : "bi-info-circle-fill") me-2"></i>
                                    @toastMessage
                                </div>
                            </div>
                        </div>
                    }
                              <GameMap @ref="gameMap" Game="@game" IsMyTurn="@IsMyTurn()" IsObserver="@(MyPlayer == null)" ShowToastAction="OnShowToastAction" NewUnitIds="@(_newUnitTimestamps.Keys.ToHashSet())" NewFactoryIds="@(_newFactoryTimestamps.Keys.ToHashSet())" PowerBlinkNations="@(_nationPowerChanges.Keys.ToHashSet())" TaxBlinkNations="@(_nationTaxChanges.Keys.ToHashSet())" />
                          </div>
            }
            else if (game.Status == GameStatus.Finished)
            {
                         <div style="position: relative; width: 100%; height: 100%;">
                             <GameMap Game="@game" IsMyTurn="@false" IsObserver="@(MyPlayer == null)" NewUnitIds="@(_newUnitTimestamps.Keys.ToHashSet())" NewFactoryIds="@(_newFactoryTimestamps.Keys.ToHashSet())" PowerBlinkNations="@(_nationPowerChanges.Keys.ToHashSet())" TaxBlinkNations="@(_nationTaxChanges.Keys.ToHashSet())" />
                             @if (showGameOverPopup)
                             {
                                 <div class="game-over-overlay">
                                    <div class="game-over-card" style="position: relative;">
                                        <button type="button" class="btn-close btn-close-white" style="position: absolute; top: 1rem; right: 1rem; z-index: 100; cursor: pointer;" @onclick="() => showGameOverPopup = false" aria-label="@Shared["Common_Close"]"></button>
                                        <h1 class="text-gradient mb-2">@L["GameOver_Title"]</h1>
                                        <h5 class="text-white-50 mb-4">@L["GameOver_EndedBy", GetWinningNation(), GameConstants.MaxPowerPoints]</h5>

                                    <div class="leaderboard-container">
                                        <table class="table table-dark table-borderless table-sm score-table">
                                            <thead>
                                                <tr class="text-white-50 border-bottom border-secondary">
                                                    <th>@L["GameOver_Rank"]</th>
                                                    <th>@L["GameOver_Player"]</th>
                                                    <th class="text-end">@L["GameOver_Cash"]</th>
                                                    <th class="text-end">@L["GameOver_BondValue"]</th>
                                                    <th class="text-end">@L["GameOver_TotalVp"]</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                        @{
                                            var rankedPlayers = GetRankedPlayers().Select(p => new { Player = p, Score = GetPlayerScore(p) }).ToList();
                                            int rank = 1;
                                        }
                                        @foreach (var item in rankedPlayers)
                                        {
                                                        <tr class="@(rank == 1 ? "winner-row" : "")">
                                                            <td>
                                                    @if (rank == 1)
                                                    {
                                                        <span class="crown">👑</span>
                                                    } 
                                                                #@rank
                                                            </td>
                                                            <td class="fw-bold">@item.Player.UserName</td>
                                                            <td class="text-end text-success">@item.Player.Cash M</td>
                                                            <td class="text-end text-info">@L["Players_Vp", item.Score - item.Player.Cash]</td>
                                                            <td class="text-end fw-bolder fs-5">@item.Score</td>
                                                        </tr>
                                            rank++;
                                        }
                                            </tbody>
                                        </table>
                                    </div>

                                    <div class="mt-4 d-flex gap-2 justify-content-center align-items-stretch">
                                        <button class="btn btn-outline-light btn-lg px-4 shadow-lg d-flex align-items-center justify-content-center" @onclick="StartReplayViewing" disabled="@isReplayMode"><i class="bi bi-film me-2"></i>@L["Replay_Start"]</button>
                                        <a class="btn btn-outline-light btn-lg px-4 shadow-lg d-flex align-items-center justify-content-center" href="@($"api/games/{GameId}/export")" download><i class="bi bi-download me-2"></i>@L["Replay_Export"]</a>
                                        <button class="btn btn-primary btn-lg px-5 shadow-lg d-flex align-items-center justify-content-center" style="text-transform: none;" @onclick="@(() => Navigation.NavigateTo("/"))">@L["ReturnToLobby"]</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
            }
            else
            {
                         <div class="map-placeholder">
                            <h2>Imperial 2030</h2>
                            <p>@L["Placeholder_WaitingToStart"]</p>
                            <p>@L["Placeholder_GameId", GameId]</p>
                        </div>
            }

                 <GameTerminal Actions="@game.Actions" />
            </div>
            </div>



            <div class="sidebar-right">
                <!-- Player stats, bond holdings -->
                <div class="panel">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="m-0">@L["Assets_Title"]</h4>
                    @if (game != null)
                    {
                                <select class="form-select form-select-sm w-auto bg-dark text-white border-secondary py-0 pe-4" 
                                        value="@selectedPlayerId" 
                        @onchange="@(e => { if (Guid.TryParse(e.Value?.ToString(), out var g)) selectedPlayerId = g; })">
                            @foreach (var p in game.Players)
                            {
                                             <option value="@p.Id" selected="@(p.Id == selectedPlayerId)">@p.UserName</option>
                            }
                                </select>
                    }
                    </div>

                @{
                    var targetPlayer = game?.Players.FirstOrDefault(p => p.Id == selectedPlayerId) ?? MyPlayer;
                }

                @if (targetPlayer != null)
                {
                            <!-- Governments -->
                            <div class="mb-3">
                                 <h6 class="text-white border-bottom border-secondary pb-1"> @L["Assets_Governments"]</h6>
                        @{
                            var myGovernments = game?.NationStates.Where(ns => ns.ControllerName == targetPlayer.UserName).ToList() ?? new List<Imperial2030.Shared.Models.NationStateDto>();
                        }
                        @if (myGovernments.Any())
                        {
                            foreach (var gov in myGovernments)
                            {
                                                 <div class="d-flex align-items-center mb-1">
                                                     <span class="badge bg-primary me-2">@Names.Nation(gov.Nation)</span>
                                                     <small class="text-muted">
                                                         @L["Assets_Power"] <span class="position-relative">@gov.Power
                                                             @if (_nationPowerEffects.TryGetValue(gov.Nation, out var govPEffect) && (DateTime.Now - govPEffect.Timestamp).TotalSeconds < 5.5)
                                                             {
                                                                 <span @key="govPEffect.TriggerId" class="floating-cash @(govPEffect.Delta > 0 ? "positive" : "negative")">
                                                                     @(govPEffect.Delta > 0 ? "+" : "")@(govPEffect.Delta)
                                                                 </span>
                                                             }
                                                         </span> | 
                                                         @L["Assets_Treasury"] <span class="position-relative">$@(gov.Treasury)M
                                                             @if (_nationTreasuryEffects.TryGetValue(gov.Nation, out var govTEffect) && (DateTime.Now - govTEffect.Timestamp).TotalSeconds < 5.5)
                                                             {
                                                                 <span @key="govTEffect.TriggerId" class="floating-cash @(govTEffect.Delta > 0 ? "positive" : "negative")">
                                                                     @(govTEffect.Delta > 0 ? "+$" : "-$")@(Math.Abs(govTEffect.Delta))M
                                                                 </span>
                                                             }
                                                         </span>
                                                     </small>
                                                 </div>
                            }
                        }
                        else
                        {
                                         <small class="text-muted">@Shared["Common_None"]</small>
                        }
                            </div>

                            <ul class="list-group list-group-flush bg-transparent">
                                <li class="list-group-item bg-transparent text-white fs-5 px-0">
                                    @L["Assets_Cash"] <span class="text-success fw-bold">$@(targetPlayer.Cash)M</span>
                                </li>
                                <li class="list-group-item bg-transparent text-white px-0">
                                    <h6 class="text-white border-bottom border-secondary pb-1 mt-2">@L["Assets_Bonds"]</h6>
                            @if (targetPlayer.Bonds.Any())
                            {
                                @foreach (var group in targetPlayer.Bonds.GroupBy(b => b.Nation).OrderBy(g => g.Key))
                                {
                                    var totalCost = group.Sum(b => b.Cost);
                                    var totalInterest = group.Sum(b => b.Interest);

                                                    <div class="mb-2 border-bottom border-secondary pb-1">
                                                        <div class="d-flex justify-content-between fw-bold text-info">
                                                            <span>@Names.Nation(group.Key)</span>
                                                            <span>@totalInterest M <small class="text-white small">(@totalCost M)</small></span>
                                                        </div>
                                        @foreach (var bond in group.OrderByDescending(b => b.Cost))
                                        {
                                                                 <div class="d-flex justify-content-between small text-muted ps-2">
                                                                    <span>@L["Assets_Bond", bond.Cost]</span>
                                                                    <span>+@bond.Interest</span>
                                                                 </div>
                                        }
                                                    </div>
                                }
                            }
                            else
                            {
                                            <small>@L["Assets_NoBonds"]</small>
                            }
                                </li>
                            </ul>
                }
                </div>

                <!-- All Bonds Panel -->
                <div class="panel mt-2">
                    <div class="d-flex justify-content-between align-items-center mb-2 border-bottom border-secondary pb-1">
                        <h5 class="mb-0">@L["Assets_GlobalBonds"]</h5>
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" id="showBoughtOnly" @bind="_showOnlyBoughtBonds">
                            <label class="form-check-label small text-muted ms-1" for="showBoughtOnly">@L["Assets_BoughtOnly"]</label>
                        </div>
                    </div>
                    @if (game != null)
                    {
                        @foreach (var ns in game.NationStates.OrderBy(n => n.Nation))
                        {
                            var nation = ns.Nation;
                            var availableForNation = game.AvailableBonds.Where(b => b.Nation == nation);
                            var heldForNation = game.Players.SelectMany(p => p.Bonds.Select(b => new { Bond = b, Player = p }))
                                                            .Where(x => x.Bond.Nation == nation);

                            var combinedBonds = heldForNation.Select(h => new { h.Bond.Cost, h.Bond.Interest, Owner = h.Player.UserName })
                                                .Concat(availableForNation.Select(a => new { a.Cost, a.Interest, Owner = (string?)null }))
                                                .OrderBy(b => b.Cost)
                                                .ToList();

                            if (_showOnlyBoughtBonds)
                            {
                                combinedBonds = combinedBonds.Where(b => b.Owner != null).ToList();
                            }

                            if (!combinedBonds.Any()) continue;

                            <div class="mb-2">
                                <h6 class="text-info mb-0">
                                    @Names.Nation(nation)
                                    @if (!string.IsNullOrEmpty(ns.ControllerName))
                                    {
                                        var controllerInvestment = heldForNation.Where(h => h.Player.UserName == ns.ControllerName).Sum(h => h.Bond.Cost);
                                        <span class="text-muted fw-normal ms-1 small">(@ns.ControllerName, @controllerInvestment M)</span>
                                    }
                                </h6>
                                <div class="small ps-2">
                                    @foreach (var bond in combinedBonds)
                                    {
                                        if (bond.Owner != null)
                                        {
                                            bool isRecent = IsBondRecentlyBought(nation, bond.Cost);
                                            <div class="d-flex justify-content-between text-white @(isRecent ? "recent-bond-highlight" : "")">
                                                <span>@bond.Cost M (+@bond.Interest)</span>
                                                <span class="text-warning">@bond.Owner</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-content-between text-muted">
                                                <span>@bond.Cost M (+@bond.Interest)</span>
                                                <span>@Shared["Common_Bank"]</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
}

<style>
    .game-container {
        display: grid;
        grid-template-columns: 320px 1fr 320px;
        height: calc(100vh - 60px);
        /* Adjust for header */
        gap: 0.5rem;
        padding: 0.5rem;
        margin-left: -2rem;
        margin-right: -1.5rem;
        min-height: 0;
    }

    @@media (max-width: 1399.98px) {
        .game-container {
            grid-template-columns: 1fr 1fr;
            grid-template-rows: auto auto;
            height: auto;
            margin-left: -1.5rem;
            margin-right: -1.5rem;
            overflow-y: auto;
        }
        .main-board-container {
            grid-column: 1 / -1;
            grid-row: 1;
            min-height: 400px;
        }
        .sidebar-left {
            grid-column: 1;
            grid-row: 2;
            height: auto;
            max-height: none;
            overflow: visible;
        }
        .sidebar-right {
            grid-column: 2;
            grid-row: 2;
            height: auto;
            max-height: none;
            overflow: visible;
        }
    }

    @@media (max-width: 767.98px) {
        .game-container {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto auto;
        }
        .main-board-container {
            grid-column: 1;
            grid-row: 1;
        }
        .main-board {
            padding-top: 35px; /* Smaller safe zone for mobile */
        }
        .sidebar-left {
            grid-column: 1;
            grid-row: 2;
        }
        .sidebar-right {
            grid-column: 1;
            grid-row: 3;
        }
    }

    /* Replay speed stepper */
    .replay-speed {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    /* Square +/- keys, fixed size so both match exactly regardless of glyph width. */
    .replay-speed-step {
        width: 1.9rem;
        height: 1.9rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1;
    }

    .replay-speed-value {
        min-width: 3.1rem; /* fixed so the toolbar doesn't shift as the value goes 0.5x -> 10x */
        text-align: center;
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #ecf0f1;
        font-size: 0.85rem;
    }

    .replay-speed-divider {
        width: 1px;
        align-self: stretch;
        margin: 0 0.15rem;
        background-color: rgba(255, 255, 255, 0.22);
    }

    .panel {
        background-color: #2c3e50;
        padding: 1rem;
        border-radius: 8px;
        color: #ecf0f1;
        display: flex; 
        flex-direction: column;
        flex-shrink: 0;
    }

    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0, 0, 0, 0.2);
        border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.4);
    }

    .sidebar-left, .sidebar-right {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow-y: auto; 
        overflow-x: hidden;
        gap: 0.1rem;
        padding: 8px; /* Added padding to prevent box-shadow clipping on the left edge */
        min-height: 0;
    }

    /* Custom Scrollbar for sidebars */
    .sidebar-left::-webkit-scrollbar, .sidebar-right::-webkit-scrollbar {
