    private int? _pendingPacingMs;
    private int CurrentPacingMs => _pendingPacingMs ?? replayState?.PacingMs ?? ReplaySpeed.DefaultPacingMs;

    /// <summary>
    /// Renders the playback multiplier, dropping the decimal for whole speeds ("1", "0.5", "10").
    /// Two decimals are allowed because a session sitting between presets (an older session, or a
    /// hand-crafted speed) still has a real speed worth showing honestly rather than rounding to a
    /// preset it is not actually running at.
    /// </summary>
    private static string FormatMultiplier(int pacingMs)
    {
        var multiplier = ReplaySpeed.MultiplierFor(pacingMs);
        return multiplier.ToString(multiplier % 1 == 0 ? "0" : "0.##", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Moves one rung along <see cref="ReplaySpeed.PresetPacingsMs"/>: <paramref name="direction"/>
    /// above zero is faster, at or below zero is slower. The server normalizes onto the allowed range
    /// and reports what it applied, which is what gets shown — so clamping at either end can never
    /// leave the UI displaying a speed the session isn't actually running at.
    /// </summary>
    private async Task StepReplaySpeed(int direction)
    {
        if (replaySessionId == null) return;

        var requested = ReplaySpeed.Step(CurrentPacingMs, direction);
        if (requested == CurrentPacingMs) return;
        _pendingPacingMs = requested;

        try
        {
            var response = await Http.PostAsync($"api/games/replay/{replaySessionId}/speed?pacingMs={requested}", null);
            if (response.IsSuccessStatusCode)
            {
                var applied = await response.Content.ReadFromJsonAsync<ReplaySpeedResponse>();
                if (applied != null) _pendingPacingMs = applied.PacingMs;
            }
            else
            {
                // Session gone (stopped or idle-evicted): drop back to whatever the polled state says.
                _pendingPacingMs = null;
            }
        }
        catch (Exception)
        {
