        // renders inside the game.Status == InProgress branch, so on a Finished game (the only place this
        // button appears) a toast would be silently invisible.
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/replay/start", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", L["Replay_StartFailed", error].Value);
                return;
            }
            replaySessionId = await response.Content.ReadFromJsonAsync<Guid>();
            _replayBaselineEstablished = false;
            _displayedTurnNation = null;
            isReplayMode = true;
            showGameOverPopup = false;
            _replayPollCts?.Cancel();
            _replayPollCts = new CancellationTokenSource();
            _ = PollReplayLoop(_replayPollCts.Token);
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", L["Replay_StartFailed", ex.Message].Value);
        }
