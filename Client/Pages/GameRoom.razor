    private async Task PollReplayLoop(CancellationToken token)
    {
        while (!token.IsCancellationRequested && replaySessionId.HasValue)
        {
            try
            {
                var state = await Http.GetFromJsonAsync<ReplayStateDto>($"api/games/replay/{replaySessionId}", token);
                if (state == null) break;
                replayState = state;
                if (state.Game != null)
                {
                    // Same diff the live game uses, so a replay animates as it plays (units appearing,
                    // cash/treasury/power deltas floating, power/tax blinks) instead of the board just
                    // silently changing. Skipped for the very first snapshot: `game` still holds the real
                    // finished game at that point, so diffing against it would flag the entire starting
                    // board as "new" in one burst.
                    if (_replayBaselineEstablished)
                    {
                        CaptureStateChangeAnimations(state.Game);
                    }
                    else
                    {
                        ClearStateChangeAnimations();
                        _replayBaselineEstablished = true;
                    }
                    // Keep the Nations panel's ordering following the acting nation. Without this the
                    // panel kept whatever order LoadGame established for the finished game and never
                    // moved for the whole replay, since LoadGame is the only other caller.
                    UpdateDisplayedNation(state.Game.CurrentTurnNation, immediate: true);
