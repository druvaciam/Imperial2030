@page "/game/{GameId:guid}"
@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Imperial2030.Client.Components
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@implements IAsyncDisposable

<PageTitle>@(IsMyTurn() ? "⚠️ YOUR TURN! - " : "")@(game != null ? $"{game.Name} - " : "")Imperial 2030</PageTitle>

@if (game == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-white">Loading imperial archives...</p>
    </div>
}
else
{
    <div class="game-container">
        @if (IsMyTurn())
        {
            <div class="turn-alert-overlay">
                <div class="alert-content">
                    <h1>IT IS YOUR MOVE!</h1>
                    <p>You control @game.CurrentTurnNation</p>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(toastMessage))
        {
            <div class="toast-notification @(isToastError ? "bg-danger" : "bg-success")">
                @toastMessage
            </div>
        }
        
        <div class="sidebar-left">
            <div class="panel mb-3 text-center">
                <h3 class="m-0 text-white">@game.Name</h3>
                <small class="text-muted">Game ID: @GameId.ToString().Substring(0, 8)...</small>
            </div>

            <div class="panel">
                <h4>Players</h4>
                <ul class="list-group list-group-flush bg-transparent">
                    @foreach (var player in game.Players)
                    {
                        <li class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center">
                            @player.UserName
                            @if (player.IsHost)
                            {
                                <span class="badge bg-warning text-dark me-1">Host</span>
                            }
                            @if (game.InvestorCardHolderId == player.Id)
                            {
                                <span class="badge bg-info text-dark">Investor Card</span>
                            }
                        </li>
                    }
                </ul>
            </div>
            
            <div class="panel mt-3">
                @{
                    var currentNs = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
                    bool isLocked = currentNs?.HasMovedThisTurn ?? false;
                }
                
                <Rondel 
                    NationStates="@game.NationStates" 
                    CurrentTurnNation="@game.CurrentTurnNation"
                    IsMyTurn="@IsMyTurn()"
                    IsLocked="@isLocked"
                    OnMoveSelected="@OnRondelMove" />
                
                <div class="mt-3 text-center">
                    <span class="text-muted small text-uppercase">Current Turn</span>
                    <h3 class="fw-bold text-white">@game.CurrentTurnNation</h3>
                </div>

                @if (IsMyTurn())
                {
                    var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
                    bool alreadyBuilt = ns?.HasBuiltThisTurn ?? false;
                    bool turnMoved = ns?.HasMovedThisTurn ?? false;

                    <div class="mt-3 d-grid gap-2">
                        @if (CanBuildFactory() && !alreadyBuilt && turnMoved)
                        {
                            <div class="card bg-dark border-secondary">
                                <div class="card-header text-center">Build Factory</div>
                                <div class="card-body p-2">
                                    <p class="small text-muted mb-2">Select a home territory to build a factory (Cost: 5M).</p>
                                    @foreach (var t in GetValidFactoryTerritories())
                                    {
                                        <button class="btn btn-sm btn-outline-info w-100 mb-1" @onclick="@(() => BuildFactory(t.Id))">
                                            @t.Name
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        
                        <button class="btn btn-warning fw-bold" @onclick="EndTurn" disabled="@(!turnMoved || isSubmitting || game.IsInvestorTurn)">
                            Ends Turn
                            @if (game.IsInvestorTurn) { <span>(Waiting for Investor)</span> }
                        </button>
                    </div>
                }
            </div>

            <!-- Investor Action Panel -->
            @if (game.IsInvestorTurn)
            {
                <div class="panel mt-3 border-info">
                    <h4 class="text-info">Investor Phase</h4>
                    @if (MyPlayer?.Id == game.ActingPlayerId)
                    {
                        <p class="small text-muted">You hold the Investor Card. You have received 2M bonus. Choose to invest or pass.</p>
                        
                        <div class="d-grid gap-2">
                             <button class="btn btn-secondary" @onclick="@(() => PerformInvestment("Pass", null))">Pass (No Investment)</button>
                             
                             <h6 class="mt-2 text-white border-bottom pb-1">Available Bonds</h6>
                             <div style="max-height: 200px; overflow-y: auto;">
                                 @foreach (var bond in game.AvailableBonds.OrderBy(b => b.Nation).ThenBy(b => b.Cost))
                                 {
                                     bool canAfford = MyPlayer.Cash >= bond.Cost;
                                     <button class="btn btn-sm btn-outline-primary w-100 mb-1 text-start" 
                                             disabled="@(!canAfford)"
                                             @onclick="@(() => PerformInvestment("Buy", bond.Id))">
                                         <span class="fw-bold">@bond.Nation</span> - @bond.Interest M Interest
                                         <span class="float-end badge @(canAfford ? "bg-success" : "bg-danger")">Cost: @bond.Cost M</span>
                                     </button>
                                 }
                             </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-warning">Waiting for Investor Action...</p>
                        <small>Current Actor: @game.Players.FirstOrDefault(p => p.Id == game.ActingPlayerId)?.UserName</small>
                    }
                </div>
            }

            @if (game.Status == GameStatus.InProgress)
            {
                <div class="panel mt-3">
                    <h4>Nations</h4>
                    <ul class="list-group list-group-flush bg-transparent small">
                        @foreach (var ns in game.NationStates)
                        {
                            <li class="list-group-item bg-transparent text-white px-0">
                                <b>@ns.Nation</b><br/>
                                <span class="text-info">Treasury: @ns.Treasury M</span> | 
                                <span class="text-warning">Power: @ns.Power (@(ns.Power/5)x)</span><br/>
                                <span class="text-muted">Ctrl: @(ns.ControllerName ?? "None")</span>
                                @{
                                    var builtFactories = Imperial2030.Shared.Constants.TerritoryData.AllTerritories
                                        .Where(t => t.Nation == ns.Nation && game.Territories.Any(ts => ts.TerritoryId == t.Id && ts.HasFactory))
                                        .Select(t => t.Name)
                                        .ToList();
                                }
                                @if (builtFactories.Any())
                                {
                                    <div class="mt-1 text-white-50">
                                        <i class="oi oi-home small"></i> Factories: @string.Join(", ", builtFactories)
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-auto pt-3 d-grid gap-2">
                 @if (IsHost && game.Status == GameStatus.Lobby)
                 {
                     <button class="btn btn-success" @onclick="StartGame" disabled="@(game.Players.Count < 2)">Start Game</button>
                 }
                 <button class="btn btn-danger" @onclick="ExitGame">Exit Game</button>
            </div>
        </div>

        <div class="main-board">
             @if (game.Status == GameStatus.InProgress)
             {
                 <GameMap Game="@game" IsMyTurn="@IsMyTurn()" />
             }
             else
             {
                 <div class="map-placeholder">
                    <h2>Imperial 2030</h2>
                    <p>Waiting for game to start...</p>
                    <p>Game ID: @GameId</p>
                </div>
             }
        </div>

        <div class="sidebar-right">
            <!-- Player stats, bond holdings -->
            <div class="panel">
                <h4>My Assets</h4>
                @if (MyPlayer != null)
                {
                    <!-- Governments -->
                    <div class="mb-3">
                         <h6 class="text-white border-bottom border-secondary pb-1">My Governments</h6>
                         @{
                             var myGovernments = game.NationStates.Where(ns => ns.ControllerName == MyPlayer.UserName).ToList();
                         }
                         @if (myGovernments.Any())
                         {
                             foreach (var gov in myGovernments)
                             {
                                 <div class="d-flex align-items-center mb-1">
                                     <span class="badge bg-primary me-2">@gov.Nation</span>
                                     <small class="text-muted">Power: @gov.Power | Treasury: @gov.Treasury M</small>
                                 </div>
                             }
                         }
                         else
                         {
                             <small class="text-muted">None</small>
                         }
                    </div>

                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent text-white fs-5 px-0">
                            Cash: <span class="text-success fw-bold">@MyPlayer.Cash M</span>
                        </li>
                        <li class="list-group-item bg-transparent text-white px-0">
                            <h6 class="text-white border-bottom border-secondary pb-1 mt-2">Bonds</h6>
                            @if (MyPlayer.Bonds.Any())
                            {
                                @foreach (var bond in MyPlayer.Bonds)
                                {
                                    <div class="d-flex justify-content-between py-1">
                                        <span>@bond.Nation</span>
                                        <span>@bond.Interest M <small class="text-muted">(Cost @bond.Cost)</small></span>
                                    </div>
                                }
                            }
                            else
                            {
                                <small>No bonds held.</small>
                            }
                        </li>
                    </ul>
                }
            </div>
        </div>
    </div>
}

<style>
    .game-container {
        display: grid;
        grid-template-columns: 250px 1fr 250px;
        height: calc(100vh - 60px);
        /* Adjust for header */
        gap: 1rem;
        padding: 1rem;
    }

    .panel {
        background-color: #2c3e50;
        padding: 1rem;
        border-radius: 8px;
        color: #ecf0f1;
        display: flex; 
        flex-direction: column;
    }
    
    .sidebar-left, .sidebar-right {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow-y: auto; 
        gap: 1rem;
        padding-right: 5px;
    }

    /* Custom Scrollbar for sidebars */
    .sidebar-left::-webkit-scrollbar, .sidebar-right::-webkit-scrollbar {
        width: 6px;
    }
    .sidebar-left::-webkit-scrollbar-track, .sidebar-right::-webkit-scrollbar-track {
        background: transparent; 
    }
    .sidebar-left::-webkit-scrollbar-thumb, .sidebar-right::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.2); 
        border-radius: 3px;
    }
    .sidebar-left::-webkit-scrollbar-thumb:hover, .sidebar-right::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.4); 
    }

    .main-board {
        background-color: #34495e;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #95a5a6;
        flex-direction: column;
        overflow: hidden;
    }

    .map-placeholder {
        text-align: center;
        border: 2px dashed #7f8c8d;
        padding: 4rem;
        border-radius: 12px;
    }

    .turn-alert-overlay {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: auto;
        height: auto;
        padding: 10px 40px;
        border-radius: 50px;
        background: linear-gradient(180deg, rgba(231, 76, 60, 0.95) 0%, rgba(192, 57, 43, 0.95) 100%);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 4px 15px rgba(0,0,0,0.4);
        border: 2px solid rgba(255,255,255,0.3);
        animation: slideDown 0.5s ease-out, pulse 2s infinite;
        pointer-events: none;
    }
    
    .alert-content {
        text-align: center;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }
    
    @@keyframes slideDown {
        from { transform: translate(-50%, -150%); opacity: 0; }
        to { transform: translate(-50%, 0); opacity: 1; }
    }
    
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.02); }
        100% { transform: scale(1); }
    }
    .toast-notification {
        position: fixed;
        top: 80px; /* Below the Turn Alert if present */
        left: 50%;
        transform: translateX(-50%);
        padding: 10px 20px;
        border-radius: 5px;
        color: white;
        z-index: 3000;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
        animation: fadeIn 0.3s ease-in-out;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; transform: translate(-50%, -20px); }
        to { opacity: 1; transform: translate(-50%, 0); }
    }
</style>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private GameDetailDto? game;
    private HubConnection? hubConnection;
    private bool IsHost = false;
    private string? currentUserId;
    private PlayerDto? MyPlayer => game?.Players.FirstOrDefault(p => p.UserId == currentUserId);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value; 
        if (currentUserId == null) 
             currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;


        await LoadGame();

        hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("/gamehub"))
            .Build();

        hubConnection.On<Guid>("GameUpdated", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });
        
        hubConnection.On<Guid>("GameStarted", async (id) =>
        {
            if (id == GameId)
            {
                await LoadGame();

                StateHasChanged();
            }
        });

        await hubConnection.StartAsync();
        await hubConnection.InvokeAsync("JoinGameGroup", GameId.ToString());
    }

    private string? errorMessage;

    private async Task LoadGame()
    {
        try
        {
            game = await Http.GetFromJsonAsync<GameDetailDto>($"api/games/{GameId}");
            if (game != null && currentUserId != null)
            {
                var me = game.Players.FirstOrDefault(p => p.UserId == currentUserId);
                IsHost = me?.IsHost ?? false;

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading game: {ex.Message}");
            errorMessage = $"Error loading game: {ex.Message}";
        }
    }

    private async Task StartGame()
    {
        errorMessage = null;
        var response = await Http.PostAsync($"api/games/{GameId}/start", null);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            errorMessage = $"Failed to start game: {error}";
            Console.WriteLine(errorMessage);
        }
    }

    private bool IsMyTurn()
    {
        if (game == null || game.Status != GameStatus.InProgress) return false;
        // If it's investor turn, the global "Turn" is effectively paused for the nation controller
        if (game.IsInvestorTurn) return false;
        var currentNationState = game.NationStates.FirstOrDefault(ns => ns.Nation == game.CurrentTurnNation);
        return currentNationState?.ControllerName == MyPlayer?.UserName;
    }

    [Inject] public IJSRuntime JSRuntime { get; set; } = default!;

    private bool isSubmitting = false;
    private string? toastMessage;
    private bool isToastError;
    // Reset state when game updates (if it's a new turn for me)
    private Guid? lastGameId = null;

    private async Task OnRondelMove(int slotIndex)
    {
        if (game == null || isSubmitting) return;
        
        var nation = game.CurrentTurnNation;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return;

        // Client-side cost verification
        int cost = 0;
        if (ns.RondelPosition.HasValue)
        {
             int current = ns.RondelPosition.Value;
             if (current == slotIndex) return; // Same slot, ignore
             
             int dist = (slotIndex - current + 8) % 8;
             if (dist > 3)
             {
                 int powerFactor = ns.Power / 5;
                 int costPerStep = 1 + powerFactor;
                 cost = (dist - 3) * costPerStep;
             }
        }
        
        if (cost > 0)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"This move will cost {cost}M. Proceed?");
            if (!confirmed) return;
        }

        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/move/{nation}/{slotIndex}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Move failed: {error}", true);
            }
            else
            {
                // State update handled by SignalR refresh, hasMoved is server-side now
            }
        }
        catch (Exception ex)
        {
             await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task EndTurn()
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/end-turn", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Failed to end turn: {error}", true);
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool CanBuildFactory()
    {
        if (game == null || !IsMyTurn() || game.IsInvestorTurn) return false;
        var ns = game.NationStates.FirstOrDefault(n => n.Nation == game.CurrentTurnNation);
        // Assuming slot 1 is Factory
        return ns?.RondelPosition == 1 && ns.Treasury >= 5;
    }

    private List<Imperial2030.Shared.Models.Territory> GetValidFactoryTerritories()
    {
        if (game == null) return new ();
        var nation = game.CurrentTurnNation;
        return Imperial2030.Shared.Constants.TerritoryData.AllTerritories
            .Where(t => t.Nation == nation && !game.Territories.Any(ts => ts.TerritoryId == t.Id && ts.HasFactory))
            .ToList();
    }

    private async Task BuildFactory(string territoryId)
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsync($"api/games/{GameId}/build-factory/{territoryId}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Failed to build factory: {error}", true);
            }
            else
            {
                await ShowToast("Factory built successfully!", false);
                // State update handled by SignalR refresh, hasBuilt is server-side now
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task PerformInvestment(string actionType, Guid? bondId)
    {
        if (game == null || isSubmitting) return;
        isSubmitting = true;
        try
        {
            var payload = new { ActionType = actionType, BondId = bondId };
            var response = await Http.PostAsJsonAsync($"api/games/{GameId}/investor-action", payload);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await ShowToast($"Investment failed: {error}", true);
            }
        }
        catch (Exception ex)
        {
            await ShowToast($"Error: {ex.Message}", true);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task ShowToast(string message, bool isError)
    {
        toastMessage = message;
        isToastError = isError;
        StateHasChanged();
        await Task.Delay(3000);
        toastMessage = null;
        StateHasChanged();
    }

    private async Task ExitGame()
    {
        var response = await Http.PostAsync($"api/games/{GameId}/leave", null);
        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            Console.WriteLine("Failed to leave game");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.InvokeAsync("LeaveGameGroup", GameId.ToString());
            await hubConnection.DisposeAsync();
        }
    }
}
