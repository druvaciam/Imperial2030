@page "/"
@using System.IO
@using Imperial2030.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IStringLocalizer<Lobby> L
@inject IStringLocalizer<SharedResource> Shared
@inject DisplayNameLocalizer Names
@attribute [Authorize]

<PageTitle>@L["Title"]</PageTitle>

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="display-4 text-white">@L["Title"]</h1>
        </div>
        <div class="col-auto d-flex gap-2">
            <div class="input-group">
                <span class="input-group-text bg-dark text-white border-secondary"><span class="oi oi-magnifying-glass"></span></span>
                <input type="text" class="form-control" placeholder="@L["SearchPlaceholder"]" @bind="newGameName" @bind:event="oninput" />
            </div>
            @if (!isGuest)
            {
                <button class="btn btn-success text-nowrap" @onclick="ShowCreateGameModal">
                    <span class="oi oi-plus me-1"></span>@L["CreateGame"]
                </button>
                <button class="btn btn-outline-light text-nowrap" @onclick="ShowImportGameModal">
                    <span class="oi oi-data-transfer-upload me-1"></span>@L["ImportGame"]
                </button>
            }
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <input type="checkbox" class="btn-check" id="filterLobby" @bind="showLobbyGames" autocomplete="off" />
                <label class="btn btn-outline-success btn-sm" for="filterLobby">@L["Filter_Lobby"]</label>

                <input type="checkbox" class="btn-check" id="filterInProgress" @bind="showInProgressGames" autocomplete="off" />
                <label class="btn btn-outline-warning btn-sm" for="filterInProgress">@L["Filter_InProgress"]</label>

                <input type="checkbox" class="btn-check" id="filterFinished" @bind="showFinishedGames" autocomplete="off" />
                <label class="btn btn-outline-secondary btn-sm" for="filterFinished">@L["Filter_Finished"]</label>

                <input type="checkbox" class="btn-check" id="filterMyGames" @bind="showOnlyMyGames" autocomplete="off" />
                <label class="btn btn-outline-info btn-sm ms-sm-2" for="filterMyGames">@L["Filter_MyGames"]</label>
            </div>
        </div>
    </div>

    @if (isGuest)
    {
        <div class="row mb-3">
            <div class="col">
                <div class="alert alert-info py-2 mb-0 d-flex align-items-center" role="alert">
                    <span class="oi oi-eye me-2"></span>
                    <span>@((MarkupString)L["GuestNotice"].Value)</span>
                </div>
            </div>
        </div>
    }

    @if (games == null)
    {
        <div class="text-center">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">@Shared["Common_Loading"]</span>
            </div>
        </div>
    }
    else if (!games.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            @L["NoGamesFound"]
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var game in GetFilteredGames())
            {
                bool amIInGame = currentUserId != null && game.UserIds.Contains(currentUserId);
                
                <div class="col">
                    <div class="card h-100 bg-dark text-white border-secondary shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-warning">@game.Name</h5>
                            @if (!string.IsNullOrEmpty(game.HostName))
                            {
                                <h6 class="card-subtitle mb-2 text-info"><i class="bi bi-person-fill me-1"></i>@L["Card_Host", game.HostName]</h6>
                            }
                            @* "g" (short date + short time) rather than a hardcoded "MMM dd, yyyy h:mm tt":
                               that pattern's month abbreviation and AM/PM designator are English-only. *@
                            <h6 class="card-subtitle mb-2 text-muted">@L["Card_Created", game.CreatedAt.ToLocalTime().ToString("g")]</h6>
                            @if (game.FinishedAt.HasValue)
                            {
                                <h6 class="card-subtitle mb-2 text-muted">@L["Card_Finished", game.FinishedAt.Value.ToLocalTime().ToString("g")]</h6>
                            }
                            @if (!string.IsNullOrEmpty(game.WinnerName))
                            {
                                <p class="text-success fw-bold mb-1"><i class="bi bi-trophy-fill me-1"></i> @L["Card_Winner", game.WinnerName]</p>
                            }
                            <p class="card-text">
                                @L["Card_Status"] <span class="badge bg-@GetStatusColor(game.Status)">
                                    @if (game.Status == GameStatus.InProgress)
                                    {
                                        @L["Card_InProgressPercent", (int)(game.MaxPower < 10 ? (game.TurnCount / 110.0 * 100.0) : (game.MaxPower / 25.0 * 100.0))]
                                    }
                                    else if (game.Status == GameStatus.Finished && game.TurnCount > 0)
                                    {
                                        @L["Card_FinishedTurns", game.TurnCount]
                                    }
                                    else
                                    {
                                        @Names.GameStatus(game.Status)
                                    }
                                </span>
                                @if (game.IsPrivate)
                                {
                                    <span class="badge bg-secondary ms-1">@L["Card_Private"]</span>
                                }
                                <br />
                                @L["Card_Players", game.PlayerCount, game.MaxPlayers]
                                @if (game.IsPrivate && amIInGame && game.HostId == currentUserId && game.JoinCode != null)
                                {
                                    <br />
                                    <span class="text-info small">@L["Card_JoinCode"] <strong>@game.JoinCode</strong></span>
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-secondary text-end">
                            @if (amIInGame)
                            {
                                <button class="btn btn-info btn-sm me-2" @onclick="@(() => NavigationManager.NavigateTo($"/game/{game.Id}"))">
                                    @(game.Status == GameStatus.Finished ? L["Card_ViewResults"] : L["Card_Resume"])
                                </button>
                                @if (game.Status == GameStatus.Lobby)
                                {
                                     <button class="btn btn-danger btn-sm" @onclick="@(() => LeaveGame(game.Id))">
                                        @L["Card_Leave"]
                                    </button>
                                }
                                @if (game.Status == GameStatus.InProgress && game.HostId == currentUserId)
                                {
                                     <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteGame(game.Id))">
                                        @Shared["Common_Delete"]
                                    </button>
                                }
                            }
                            else
                            {
                                @if (!isGuest)
                                {
                                    <button class="btn btn-secondary btn-sm" @onclick="@(() => InitiateJoinGame(game))"
                                        disabled="@(game.IsFull || game.Status != GameStatus.Lobby)">
                                        @(game.Status == GameStatus.Finished ? L["Filter_Finished"] : game.Status == GameStatus.InProgress ? L["Filter_InProgress"] : game.IsFull ? L["Card_Full"] : L["Card_JoinGame"])
                                    </button>
                                }
                                @if ((game.Status == GameStatus.InProgress || game.Status == GameStatus.Finished) && !game.IsPrivate)
                                {
                                    <button class="btn btn-outline-info btn-sm ms-2" @onclick="@(() => NavigationManager.NavigateTo($"/game/{game.Id}"))">
                                        @L["Card_Watch"]
                                    </button>
                                }
                                @if (game.IsAllBots && !isGuest)
                                {
                                    <button class="btn btn-danger btn-sm ms-2" @onclick="@(() => DeleteGame(game.Id))">
                                        @Shared["Common_Delete"]
                                    </button>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (isCreateModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@L["CreateModal_Title"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateGameModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(createErrorMessage))
                    {
                        <div class="alert alert-danger">@createErrorMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">@L["CreateModal_GameName"]</label>
                        <input type="text" class="form-control" @bind="newGameRequest.Name" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["CreateModal_MaxPlayers"]</label>
                        <select class="form-select" @bind="newGameRequest.MaxPlayers">
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                            <option value="6">6</option>
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isPrivateCheck" @bind="newGameRequest.IsPrivate" />
                        <label class="form-check-label" for="isPrivateCheck">@L["CreateModal_Private"]</label>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" class="form-check-input" id="isVariantBonusCheck" @bind="newGameRequest.VariantBonusOnlyForTaxIncreases" />
                        <label class="form-check-label" for="isVariantBonusCheck">@L["CreateModal_Variant"]</label>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseCreateGameModal">@Shared["Common_Cancel"]</button>
                    <button type="button" class="btn btn-success" @onclick="CreateGame" disabled="@string.IsNullOrWhiteSpace(newGameRequest.Name)">@L["CreateModal_Create"]</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isImportModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@L["ImportModal_Title"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseImportGameModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(importErrorMessage))
                    {
                        <div class="alert alert-danger">@importErrorMessage</div>
                    }
                    <p class="text-white-50">@L["ImportModal_Description"]</p>
                    <div class="mb-3">
                        <label class="form-label">@L["ImportModal_ExportFile"]</label>
                        <InputFile class="form-control" accept=".json,application/json" OnChange="OnImportFileSelected" disabled="@isImporting" />
                    </div>
                    @if (isImporting)
                    {
                        <div class="d-flex align-items-center gap-2 text-white-50">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <span>@L["ImportModal_Importing"]</span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseImportGameModal" disabled="@isImporting">@Shared["Common_Cancel"]</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isJoinModalOpen && gameToJoin != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">@L["JoinModal_Title", gameToJoin.Name]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseJoinGameModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(joinErrorMessage))
                    {
                        <div class="alert alert-danger">@joinErrorMessage</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">@L["JoinModal_JoinCode"]</label>
                        <input type="text" class="form-control" @bind="joinCodeInput" @bind:event="oninput" placeholder="@L["JoinModal_CodePlaceholder"]" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" @onclick="CloseJoinGameModal">@Shared["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="ConfirmJoinGame" disabled="@string.IsNullOrWhiteSpace(joinCodeInput)">@L["JoinModal_Join"]</button>
                </div>
            </div>
        </div>
    </div>
}

@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client


@code {
    private List<GameDto>? games;
    private string newGameName = string.Empty; // used for the global text filter now
    private HubConnection? hubConnection;
    private string? currentUserId;

    private bool showLobbyGames = true;
    private bool showInProgressGames = true;
    private bool showFinishedGames = true;
    private bool showOnlyMyGames = false;
    private bool isGuest = false;

    private bool isCreateModalOpen = false;
    private CreateGameRequest newGameRequest = new CreateGameRequest();
    private string createErrorMessage = string.Empty;

    private bool isImportModalOpen = false;
    private bool isImporting = false;
    private string importErrorMessage = string.Empty;

    private bool isJoinModalOpen = false;
    private GameDto? gameToJoin = null;
    private string joinCodeInput = string.Empty;
    private string joinErrorMessage = string.Empty;

    private IEnumerable<GameDto> GetFilteredGames()
    {
        if (games == null) return Enumerable.Empty<GameDto>();
        
        var query = games.AsEnumerable();

        // Apply My Games Filter
        if (showOnlyMyGames && currentUserId != null)
        {
            query = query.Where(g => g.UserIds.Contains(currentUserId));
        }

        // Apply Status Filters
        query = query.Where(g => 
            (showLobbyGames && g.Status == GameStatus.Lobby) ||
            (showInProgressGames && g.Status == GameStatus.InProgress) ||
            (showFinishedGames && g.Status == GameStatus.Finished)
        );

        // Apply Name text filter
        if (!string.IsNullOrWhiteSpace(newGameName))
        {
            query = query.Where(g => g.Name.Contains(newGameName, StringComparison.OrdinalIgnoreCase));
        }
            
        return query;
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value; 
        if (currentUserId == null) 
             currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        isGuest = user.IsInRole("Guest");

        await LoadGames();

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/gamehub"), options =>
            {
                if (!string.IsNullOrEmpty(token))
                {
                    options.AccessTokenProvider = () => Task.FromResult((string?)token);
                }
            })
            .Build();

        hubConnection.On<GameDto>("GameCreated", (game) =>
        {
            games?.Insert(0, game);
            StateHasChanged();
        });

        hubConnection.On<Guid>("GameUpdated", async (gameId) =>
        {
             await LoadGames();
             StateHasChanged();
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadGames()
    {
        try
        {
            var rawGames = await Http.GetFromJsonAsync<List<GameDto>>("api/games");
            if (rawGames != null)
            {
                games = rawGames
                    .OrderBy(g => g.Status)
                    .ThenByDescending(g => g.CreatedAt)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading games: {ex.Message}");
        }
    }

    private void ShowCreateGameModal()
    {
        newGameRequest = new CreateGameRequest { MaxPlayers = 6, IsPrivate = false, Name = "" };
        createErrorMessage = string.Empty;
        isCreateModalOpen = true;
    }

    private void CloseCreateGameModal()
    {
        isCreateModalOpen = false;
    }

    private async Task CreateGame()
    {
        if (string.IsNullOrWhiteSpace(newGameRequest.Name)) return;
        createErrorMessage = string.Empty;

        var response = await Http.PostAsJsonAsync("api/games", newGameRequest);
        if (response.IsSuccessStatusCode)
        {
            var game = await response.Content.ReadFromJsonAsync<GameDto>();
            CloseCreateGameModal();
            if (game != null)
            {
                NavigationManager.NavigateTo($"/game/{game.Id}");
            }
        }
        else
        {
            // Try to extract problem details if available, otherwise generic message
            try 
            {
                var problemStr = await response.Content.ReadAsStringAsync();
                var doc = System.Text.Json.JsonDocument.Parse(problemStr);
                if (doc.RootElement.TryGetProperty("errors", out var errorsProp) && errorsProp.ValueKind == System.Text.Json.JsonValueKind.Object)
                {
                    var errors = new List<string>();
                    foreach (var error in errorsProp.EnumerateObject())
                    {
                        foreach (var msg in error.Value.EnumerateArray())
                        {
                            errors.Add(msg.GetString() ?? "");
                        }
                    }
                    createErrorMessage = string.Join(" ", errors);
                }
                else
                {
                    createErrorMessage = L["CreateFailed"];
                }
            }
            catch
            {
                createErrorMessage = L["CreateFailed"];
            }
        }
    }

    private void ShowImportGameModal()
    {
        importErrorMessage = string.Empty;
        isImportModalOpen = true;
    }

    private void CloseImportGameModal()
    {
        if (isImporting) return; // don't let the user dismiss mid-request — the file input is already disabled while importing
        isImportModalOpen = false;
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importErrorMessage = string.Empty;
        isImporting = true;
        StateHasChanged();
        try
        {
            // Export files are plain JSON action logs; 20MB comfortably covers even very long games.
            const long maxFileSize = 20 * 1024 * 1024;
            string json;
            using (var stream = e.File.OpenReadStream(maxFileSize))
            using (var reader = new StreamReader(stream))
            {
                json = await reader.ReadToEndAsync();
            }

            using var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");
            var response = await Http.PostAsync("api/games/import", content);
            if (response.IsSuccessStatusCode)
            {
                var game = await response.Content.ReadFromJsonAsync<GameDto>();
                isImportModalOpen = false;
                if (game != null)
                {
                    NavigationManager.NavigateTo($"/game/{game.Id}");
                }
            }
            else
            {
                // ImportGame returns its diagnostics as a plain BadRequest(string), not a structured
                // model-validation error object, so this is read as raw text rather than parsed as JSON.
                var body = await response.Content.ReadAsStringAsync();
                importErrorMessage = string.IsNullOrWhiteSpace(body) ? L["ImportFailed"] : body;
            }
        }
        catch (Exception ex)
        {
            importErrorMessage = L["ImportReadFailed", ex.Message];
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    private void InitiateJoinGame(GameDto game)
    {
        if (game.IsPrivate)
        {
            gameToJoin = game;
            joinCodeInput = string.Empty;
            joinErrorMessage = string.Empty;
            isJoinModalOpen = true;
        }
        else
        {
            _ = JoinGame(game.Id, null);
        }
    }

    private void CloseJoinGameModal()
    {
        isJoinModalOpen = false;
        gameToJoin = null;
    }

    private async Task ConfirmJoinGame()
    {
        if (gameToJoin != null && !string.IsNullOrWhiteSpace(joinCodeInput))
        {
            await JoinGame(gameToJoin.Id, joinCodeInput);
        }
    }

    private async Task JoinGame(Guid gameId, string? joinCode)
    {
        var request = new JoinGameRequest { JoinCode = joinCode };
        var response = await Http.PostAsJsonAsync($"api/games/{gameId}/join", request);
        
        if (response.IsSuccessStatusCode)
        {
            if (isJoinModalOpen) CloseJoinGameModal();
            NavigationManager.NavigateTo($"/game/{gameId}");
        }
        else
        {
            if (isJoinModalOpen)
            {
                joinErrorMessage = await response.Content.ReadAsStringAsync();
                StateHasChanged();
            }
            else 
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Failed to join game: {error}");
            }
        }
    }
    
    private async Task LeaveGame(Guid gameId)
    {
        var response = await Http.PostAsync($"api/games/{gameId}/leave", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadGames(); // Refresh lobby
        }
        else
        {
             Console.WriteLine("Failed to leave game");
        }
    }

    private async Task DeleteGame(Guid gameId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", L["DeleteConfirm"].Value);
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/games/{gameId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadGames();
        }
        else
        {
            Console.WriteLine("Failed to delete game");
        }
    }

    private string GetStatusColor(GameStatus status) => status switch
    {
        GameStatus.Lobby => "success",
        GameStatus.InProgress => "warning",
        GameStatus.Finished => "secondary",
        _ => "primary"
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
