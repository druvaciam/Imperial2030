@page "/"
@using Imperial2030.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Game Lobby</PageTitle>

<div class="container mt-4">
    <div class="row align-items-center mb-4">
        <div class="col">
            <h1 class="display-4 text-white">Game Lobby</h1>
        </div>
        <div class="col-auto">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="New Game Name" @bind="newGameName" @bind:event="oninput" />
                <button class="btn btn-success" @onclick="CreateGame"
                    disabled="@string.IsNullOrWhiteSpace(newGameName)">Create Game</button>
            </div>
        </div>
    </div>

    @if (games == null)
    {
        <div class="text-center">
            <div class="spinner-border text-light" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!games.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            No active games found. Be the first to create one!
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var game in games)
            {
                bool amIInGame = currentUserId != null && game.UserIds.Contains(currentUserId);
                
                <div class="col">
                    <div class="card h-100 bg-dark text-white border-secondary shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title text-warning">@game.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">Created: @game.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy h:mm tt")
                            </h6>
                            <p class="card-text">
                                Status: <span class="badge bg-@GetStatusColor(game.Status)">@game.Status</span><br />
                                Players: @game.PlayerCount / @game.MaxPlayers
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-secondary text-end">
                            @if (amIInGame)
                            {
                                <button class="btn btn-info btn-sm me-2" @onclick="@(() => NavigationManager.NavigateTo($"/game/{game.Id}"))">
                                    @(game.Status == GameStatus.Finished ? "View Results" : "Resume")
                                </button>
                                @if (game.Status == GameStatus.Lobby)
                                {
                                     <button class="btn btn-danger btn-sm" @onclick="@(() => LeaveGame(game.Id))">
                                        Leave
                                    </button>
                                }
                                @if (game.Status == GameStatus.InProgress && game.HostId == currentUserId)
                                {
                                     <button class="btn btn-danger btn-sm" @onclick="@(() => DeleteGame(game.Id))">
                                        Delete
                                    </button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-secondary btn-sm" @onclick="@(() => JoinGame(game.Id))"
                                    disabled="@(game.IsFull || game.Status != GameStatus.Lobby)">
                                    @(game.Status == GameStatus.Finished ? "Finished" : game.Status == GameStatus.InProgress ? "In Progress" : game.IsFull ? "Full" : "Join Game")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@implements IAsyncDisposable
@using Microsoft.AspNetCore.SignalR.Client


@code {
    private List<GameDto>? games;
    private string newGameName = string.Empty;
    private HubConnection? hubConnection;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        currentUserId = user.FindFirst(c => c.Type == "sub")?.Value; 
        if (currentUserId == null) 
             currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await LoadGames();

        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/gamehub"), options =>
            {
                if (!string.IsNullOrEmpty(token))
                {
                    options.AccessTokenProvider = () => Task.FromResult((string?)token);
                }
            })
            .Build();

        hubConnection.On<GameDto>("GameCreated", (game) =>
        {
            games?.Insert(0, game);
            StateHasChanged();
        });

        hubConnection.On<Guid>("GameUpdated", async (gameId) =>
        {
             await LoadGames();
             StateHasChanged();
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadGames()
    {
        try
        {
            var rawGames = await Http.GetFromJsonAsync<List<GameDto>>("api/games");
            if (rawGames != null)
            {
                games = rawGames
                    .OrderBy(g => g.Status)
                    .ThenByDescending(g => g.CreatedAt)
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading games: {ex.Message}");
        }
    }

    private async Task CreateGame()
    {
        if (string.IsNullOrWhiteSpace(newGameName)) return;

        var response = await Http.PostAsJsonAsync("api/games", newGameName);
        if (response.IsSuccessStatusCode)
        {
            var game = await response.Content.ReadFromJsonAsync<GameDto>();
            newGameName = string.Empty;
            if (game != null)
            {
                NavigationManager.NavigateTo($"/game/{game.Id}");
            }
        }
    }

    private async Task JoinGame(Guid gameId)
    {
        var response = await Http.PostAsync($"api/games/{gameId}/join", null);
        
        if (response.IsSuccessStatusCode)
        {
            NavigationManager.NavigateTo($"/game/{gameId}");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Failed to join game: {error}");
        }
    }
    
    private async Task LeaveGame(Guid gameId)
    {
        var response = await Http.PostAsync($"api/games/{gameId}/leave", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadGames(); // Refresh lobby
        }
        else
        {
             Console.WriteLine("Failed to leave game");
        }
    }

    private async Task DeleteGame(Guid gameId)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this game?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/games/{gameId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadGames();
        }
        else
        {
            Console.WriteLine("Failed to delete game");
        }
    }

    private string GetStatusColor(GameStatus status) => status switch
    {
        GameStatus.Lobby => "success",
        GameStatus.InProgress => "warning",
        GameStatus.Finished => "secondary",
        _ => "primary"
    };

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}
