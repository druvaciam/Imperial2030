@page "/login"
@using Imperial2030.Shared.Auth
@inject Imperial2030.Client.Services.AuthService AuthService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Login> L

<h3>@L["Title"]</h3>

@if (ShowErrors)
{
    <div class="alert alert-danger" role="alert">
        <p>@Error</p>
    </div>
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@L["CardTitle"]</h5>
        <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="username" class="form-label">@L["UserName"]</label>
                <InputText id="username" class="form-control" @bind-Value="loginRequest.UserName" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">@L["Password"]</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="loginRequest.Password" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isLoggingIn">@L["SubmitButton"]</button>
        </EditForm>

        <div class="text-center my-3">
            <span class="text-muted">@L["OrSeparator"]</span>
        </div>

        <button class="btn btn-outline-secondary w-100" @onclick="HandleGuestLogin" disabled="@isLoggingIn">
            <span class="oi oi-eye me-2"></span>@L["GuestButton"]
        </button>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new LoginRequest();
    private bool ShowErrors;
    private string Error = "";
    private bool isLoggingIn = false;

    private async Task HandleLogin()
    {
        ShowErrors = false;

        var result = await AuthService.Login(loginRequest);

        if (result.Successful)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            Error = result.Error ?? L["LoginFailed"];
            ShowErrors = true;
        }
    }

    private async Task HandleGuestLogin()
    {
        ShowErrors = false;
        isLoggingIn = true;

        var result = await AuthService.LoginAsGuest();

        if (result.Successful)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            Error = result.Error ?? L["GuestLoginFailed"];
            ShowErrors = true;
        }

        isLoggingIn = false;
    }
}
