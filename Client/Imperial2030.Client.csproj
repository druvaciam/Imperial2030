<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Blazor WASM otherwise picks an ICU shard from the *browser's* locale, so an English-locale
         browser gets EFIGS and has no Belarusian date/number data at all. (Resource lookup works
         regardless; this only governs formatting.)
         Pinning one shard explicitly instead of BlazorWebAssemblyLoadAllGlobalizationData: that
         flag pulls the full 1.46 MB icudt.dat, while no_CJK covers every language this app offers
         for 1.06 MB. Swap back to the full file, or to a wider shard, if a CJK language is ever
         added - EFIGS (0.53 MB) is not an option, it has no Belarusian. -->
    <BlazorIcuDataFileName>icudt_no_CJK.dat</BlazorIcuDataFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Imperial2030.Shared.csproj" />
  </ItemGroup>

</Project>
