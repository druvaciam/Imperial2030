@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
<div class="top-row px-4 auth">
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Guest"))
                    {
                        <span class="me-3 text-muted"><span class="oi oi-eye me-1"></span>Guest (Watch Only)</span>
                        <a href="register" class="me-2">Register</a>
                        <a href="logout">Logout</a>
                    }
                    else
                    {
                        <span class="me-3">Hello, @context.User.Identity?.Name!</span>
                        <a href="logout">Logout</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="login">Login</a>
                    <a href="register" class="ms-3">Register</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="https://docs.microsoft.com/aspnet/" target="_blank" class="ms-3">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
