@inherits LayoutComponentBase
@inject LanguageService LanguageService
@inject IStringLocalizer<SharedResource> Shared
@inject HttpClient Http
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        @* The sidebar itself stretches to the full page height so its gradient never stops short on
           a long page; this inner wrapper is what stays pinned while scrolling. One element cannot
           do both — stretching and sticking are mutually exclusive. *@
        <div class="sidebar-sticky">
            <NavMenu />
        </div>
    </div>

    <main>
<div class="top-row px-4 auth">
            @* top-bar-info is the flexible half: it holds an arbitrarily long game name, so it is the
               one allowed to shrink and clip. Without this it kept its natural width and pushed the
               auth links off the right edge instead. *@
            <div class="me-4 d-flex gap-3 align-items-center top-bar-info">
                <SectionOutlet SectionName="top-bar-info" />
            </div>
            <select class="form-select form-select-sm w-auto bg-dark text-white border-secondary me-3 py-0 language-select"
                    title="@Shared["Language_Label"]"
                    aria-label="@Shared["Language_Label"]"
                    value="@LanguageService.CurrentCulture.Name"
                    @onchange="OnCultureChanged">
                @foreach (var culture in LanguageService.SupportedCultures)
                {
                    <option value="@culture.Name" selected="@(culture.Name == LanguageService.CurrentCulture.Name)">@culture.DisplayName</option>
                }
            </select>
            <AuthorizeView>
                <Authorized>
                    @if (context.User.IsInRole("Guest"))
                    {
                        <span class="me-3 text-muted d-none d-lg-inline"><span class="oi oi-eye me-1"></span>@Shared["Layout_GuestBadge"]</span>
                        <a href="register" class="me-2">@Shared["Layout_Register"]</a>
                        <a href="logout">@Shared["Layout_Logout"]</a>
                    }
                    else
                    {
                        <span class="me-3 d-none d-lg-inline">@Shared["Layout_Hello", context.User.Identity?.Name ?? ""]</span>
                        <a href="logout">@Shared["Layout_Logout"]</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="login">@Shared["Layout_Login"]</a>
                    <a href="register" class="ms-3">@Shared["Layout_Register"]</a>
                </NotAuthorized>
            </AuthorizeView>
            <a href="about" class="ms-3">@Shared["Layout_About"]</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    /// <summary>
    /// Asks the server, once per app load, whether the stored token is still accepted.
    ///
    /// CustomAuthenticationStateProvider can only check the token's `exp` claim — it cannot verify a
    /// signature — so a token signed with a rotated-away key leaves the user half-logged-in: greeted by
    /// name in the header while the server treats them as anonymous. Nothing surfaces it during normal
    /// use, because the endpoints the lobby hits are [AllowAnonymous] and answer 200 with the caller
    /// silently unauthenticated; it shows up only as their own games offering "Watch" instead of
    /// "Resume", and "My Games Only" listing nothing.
    ///
    /// /api/auth/me is [Authorize], so a token the server no longer honours returns 401 here, and
    /// CustomAuthorizationMessageHandler clears it and redirects to login. Any other failure (offline,
    /// server down) is deliberately ignored — this must never sign someone out over a transient error.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
        if (string.IsNullOrWhiteSpace(token) || token == "null") return;

        try
        {
            await Http.GetAsync("api/auth/me");
        }
        catch
        {
            // Network-level failure, not a rejected session. Leave the user signed in.
        }
    }

    // Switching language reloads the app (see LanguageService.SetCultureAsync for why that is
    // required rather than preferred), so there is no local state to update here.
    private async Task OnCultureChanged(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selected))
        {
            await LanguageService.SetCultureAsync(selected);
        }
    }
}
