@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<GameTerminal> L
@inject IStringLocalizer<SharedResource> Shared
@inject DisplayNameLocalizer Names

<div class="game-terminal-container">
    <div class="terminal-header">
        <span>@L["Header"]</span>
        <span class="blinking-cursor">_</span>
    </div>
    <div class="terminal-body" @ref="terminalBodyRef">
        @if (Actions == null || !Actions.Any())
        {
            <div class="terminal-line text-muted">@L["NoHistory"]</div>
        }
        else
        {
            @foreach (var action in Actions.OrderBy(a => a.OrderIndex).ThenBy(a => a.Timestamp))
            {
                <div class="terminal-line">
                    <span class="timestamp">[@action.Timestamp.ToLocalTime().ToString("HH:mm:ss")]</span>
                    @* GameConstants.SystemPlayerName marks an entry with no human/bot actor — a
                       consequence computed by the game itself, such as interest paid out of a national
                       treasury. Printing the sentinel would read as a player called "System" performing
                       the action; the nation tag beside it already identifies who it concerns. *@
                    @if (action.PlayerName != GameConstants.SystemPlayerName)
                    {
                        <span class="player">@action.PlayerName</span>
                    }
                    @if (action.Nation.HasValue)
                    {
                        <span class="nation-tag nation-@action.Nation.ToString()?.ToLower()">@Names.Nation(action.Nation.Value)</span>
                    }
                    @if (!string.IsNullOrEmpty(action.Message))
                    {
                        @* Legacy passthrough: GameLogger has always written Message = string.Empty, so
                           nothing this codebase produces reaches here. Rows persisted by an older
                           build could still carry text, which is why it is rendered raw (and left
                           untranslated — there is no key to look up for arbitrary historical text). *@
                        <span class="message">@action.Message</span>
                    }
                    else if (action.ActionType == "Investment" && string.IsNullOrEmpty(action.Metadata))
                    {
                        <span class="message">@L["PassedOnInvestment"]</span>
                    }
                    @if (action.ActionType == "Investment" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<InvestmentMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                if (meta.TradeInCost.HasValue && meta.Cost.HasValue)
                                {
                                    <span class="message">@L["UpgradedBond", Names.NationFromName(meta.Nation), meta.TradeInCost, meta.Cost]</span>
                                }
                                else if (meta.Cost.HasValue)
                                {
                                    <span class="message">@L["BoughtBond", Names.NationFromName(meta.Nation), meta.Cost]</span>
                                }

                                if (meta.NewControllerName != null && meta.NewControllerName != meta.OldControllerName)
                                {
                                    <span class="text-info">@(meta.OldControllerName != null
                                        ? L["TookControlOfNationFrom", Names.NationFromName(meta.Nation), meta.OldControllerName]
                                        : L["TookControlOfNation", Names.NationFromName(meta.Nation)])</span>
                                }

                                if (meta.IsSwissBankKicked)
                                {
                                    <div class="terminal-line text-warning">
                                        <span class="timestamp">[@action.Timestamp.ToLocalTime().ToString("HH:mm:ss")]</span>
                                        <span class="message">@L["SwissBankKicked", meta.OldControllerName]</span>
                                    </div>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Taxation" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<TaxationMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                string soldiersPayStr = meta.SoldiersPay > 0 ? $"-{meta.SoldiersPay}" : meta.SoldiersPay.ToString();
                                string tGainStr = meta.TreasuryGain > 0 ? $"+{meta.TreasuryGain}" : meta.TreasuryGain.ToString();
                                string bonusStr = meta.Bonus > 0 ? $"+{meta.Bonus}" : meta.Bonus.ToString();
                                string powerStr = meta.PowerGain > 0 ? $"+{meta.PowerGain}" : meta.PowerGain.ToString();
                                <span class="message">@L["CollectedTaxes", meta.TotalRevenue, soldiersPayStr, tGainStr, bonusStr, powerStr]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Import" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ImportMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                // Built from TerritoryId, not the metadata's TerritoryName: the name was
                                // baked in English by the server when the action was logged, while the id
                                // maps to a localized name here.
                                var locationNames = meta.Units.Select(u => L["UnitInTerritory", Names.UnitType(u.UnitType), Names.Territory(u.TerritoryId)].Value);
                                <span class="message">@L["ImportedUnits", meta.ImportedCount, string.Join(", ", locationNames)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "EndTurn")
                    {
                        <span class="message">@L["EndedTurn"]</span>
                    }
                    @if ((action.ActionType == "AutoSkipPhase" || action.ActionType == "AutoEndPhase" || action.ActionType == "EndPhase") && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<PhaseMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                // PhaseName is a server-authored English string ("Fleets"/"Armies"/"Turn");
                                // Names.PhaseName maps that closed set without changing the log format.
                                var phase = Names.PhaseName(meta.PhaseName);
                                if (action.ActionType == "AutoSkipPhase")
                                {
                                    <span class="message">@L["AutoSkippedPhase", phase]</span>
                                }
                                else if (action.ActionType == "AutoEndPhase")
                                {
                                    <span class="message">@L["AutoEndedPhase", phase]</span>
                                }
                                else if (action.ActionType == "EndPhase")
                                {
                                    <span class="message">@L["EndedPhase", phase]</span>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "AllPartiesPeace" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                <span class="message">@L["AllPartiesPeace", Names.Territory(meta.TerritoryId)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Move" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<RondelMoveMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                string targetStr = Names.RondelSlot(meta.TargetSlot);
                                string fromStr = meta.CurrentSlot.HasValue ? Names.RondelSlot(meta.CurrentSlot.Value) : L["RondelStart"].Value;
                                <span class="message">@L["RondelMoved", targetStr, fromStr, meta.Cost]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if ((action.ActionType == "MoveFleet" || action.ActionType == "MoveArmy") && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.FromTerritoryId != null && meta.ToTerritoryId != null)
                            {
                                // Message key varies by unit type, not just an interpolated noun: in
                                // gendered languages the verb has to agree with the unit ("армія рушыла"
                                // vs "флот рушыў"), which a single template cannot express.
                                string unitSuffix = action.ActionType == "MoveFleet" ? "Fleet" : "Army";
                                if (meta.FromTerritoryId == meta.ToTerritoryId)
                                {
                                    <span class="message">@L[$"UnitStayed_{unitSuffix}", Names.Territory(meta.ToTerritoryId)]</span>
                                }
                                else
                                {
                                    string originName = Names.Territory(meta.FromTerritoryId);
                                    string targetName = Names.Territory(meta.ToTerritoryId);

                                    if (!string.IsNullOrEmpty(meta.DefendersStr))
                                    {
                                        string peaceOrHostile = meta.IsHostileMove == true ? L["Hostilely"].Value : L["Peacefully"].Value;
                                        <span class="message">@L[$"UnitMovedAwaitingResponse_{unitSuffix}", peaceOrHostile, targetName, originName, LocalizeNationList(meta.DefendersStr)]</span>
                                    }
                                    else
                                    {
                                        <span class="message">@L[$"UnitMoved_{unitSuffix}", targetName, originName, Shared[meta.IsHostileMove == true ? "Common_Yes" : "Common_No"]]</span>
                                    }
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Battle" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                string targetName = Names.Territory(meta.TerritoryId);
                                if (meta.IsResponse == true)
                                {
                                    <span class="message">@L[$"BattleResponseFight_{UnitKeySuffix(meta.DefenderUnitType)}", Names.Nation(meta.DefenderNation), Names.Nation(meta.AggressorNation), LocalizeUnitType(meta.UnitType), targetName]</span>
                                }
                                else
                                {
                                    <span class="message">@L[$"BattleAttack_{UnitKeySuffix(meta.UnitType)}", Names.Nation(meta.DefenderNation), LocalizeUnitType(meta.DefenderUnitType), targetName]</span>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "FlagPlacement" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<FlagPlacementMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                string territoryName = Names.Territory(meta.TerritoryId);
                                if (meta.OldController.HasValue)
                                {
                                    <span class="message">@L["TookControlOfTerritoryFrom", territoryName, Names.Nation(meta.OldController.Value)]</span>
                                }
                                else
                                {
                                    <span class="message">@L["TookControlOfTerritory", territoryName]</span>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Factory" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                <span class="message">@L["BuiltFactory", Names.Territory(meta.TerritoryId)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "DestroyFactory" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                <span class="message">@L["DestroyedFactory", Names.Nation(action.Nation), Names.Territory(meta.TerritoryId)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "SwissBankResponse" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<SwissBankResponseMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                if (meta.IsForceStop)
                                {
                                    <span class="message">@L["SwissBankForceStop", Names.Nation(meta.Nation)]</span>
                                }
                                else
                                {
                                    <span class="message">@L["SwissBankPass", Names.Nation(meta.Nation)]</span>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "BattleResponse" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                <span class="message">@L["BattleResponsePeace", LocalizeNationList(meta.RespondingNationStr), Names.Nation(meta.AggressorNation), Names.Territory(meta.TerritoryId)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "ToggleHostility" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<HostilityMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.TerritoryId != null)
                            {
                                string unitSuffix = UnitKeySuffix(meta.UnitType);
                                string statusStr = meta.IsHostile ? L["Hostile"].Value : L["Friendly"].Value;
                                <span class="message">@L[$"HostilityToggled_{unitSuffix}", Names.Territory(meta.TerritoryId), statusStr]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "Production" && !string.IsNullOrEmpty(action.Metadata) && string.IsNullOrEmpty(action.Message))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<ProductionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                // TerritoryId rather than the English TerritoryName baked in at log time — same reasoning as Import above.
                                var locationNames = meta.Units.Select(u => L["UnitInTerritory", Names.UnitType(u.UnitType), Names.Territory(u.TerritoryId)].Value);
                                <span class="message">@L["ProducedUnits", meta.ProducedCount, string.Join(", ", locationNames)]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    @if (action.ActionType == "JoinGame")
                    {
                        <span class="message">@L["JoinedGame"]</span>
                    }
                    else if (action.ActionType == "LeaveGame")
                    {
                        <span class="message">@L["LeftGame"]</span>
                    }
                    else if (action.ActionType == "StartGame")
                    {
                        <span class="message">@L["StartedGame"]</span>
                    }
                    else if (action.ActionType == "PauseGame")
                    {
                        <span class="message text-warning">@L["PausedGame"]</span>
                    }
                    else if (action.ActionType == "ResumeGame")
                    {
                        <span class="message text-success">@L["ResumedGame"]</span>
                    }
                    else if (action.ActionType == "InvestorBonus" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.InvestorMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && meta.Type == "InvestorBonus")
                            {
                                <span class="message">@L["ReceivedInvestorBonus", meta.PaidAmount]</span>
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                    else if (action.ActionType == "Investor" && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.InvestorMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null)
                            {
                                if (meta.Type == "InterestPaid")
                                {
                                    <span class="message">@L["InterestPaid", meta.PaidAmount, meta.PayeeName]</span>
                                }
                                else if (meta.Type == "InterestPartial")
                                {
                                    <span class="message">@L["InterestPartial", meta.PaidAmount, meta.PayeeName, meta.ExpectedAmount]</span>
                                }
                                else if (meta.Type == "UnableToPay")
                                {
                                    if (meta.TreasuryEmpty == true)
                                    {
                                        <span class="message">@L["UnableToPayTreasuryEmpty", meta.PayeeName]</span>
                                    }
                                    else
                                    {
                                        <span class="message">@L["UnableToPay", meta.ExpectedAmount, meta.PayeeName]</span>
                                    }
                                }
                                else if (meta.Type == "PersonallyContributed")
                                {
                                    <span class="message">@L["PersonallyContributed", meta.PersonalContribution]</span>
                                }
                            }
                        }
                        catch (Exception ex)
                        {
                            <span class="message text-warning">@DescribeUnreadableEntry(action, ex)</span>
                        }
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public List<GameActionDto> Actions { get; set; } = new();

    private ElementReference terminalBodyRef;

    /// <summary>
    /// Renders a visible marker for a log entry whose metadata could not be read, and reports the
    /// reason to the browser console.
    ///
    /// Every metadata branch above used to end in a bare `catch { }`, so a shape mismatch produced a
    /// line with a timestamp, a nation tag and no message at all — nothing logged, nothing to tell a
    /// blank line from an entry that legitimately has none. That matters more here than it would
    /// elsewhere: this mapping is what CLAUDE.md calls the riskiest port, replay and import both depend
    /// on these shapes round-tripping, and a divergence is exactly what this code would otherwise hide.
    ///
    /// Deliberately not localized. It is a diagnostic for a should-never-happen case, and inventing a
    /// resource key would mean adding it to every .resx (LocalizationResourceTests enforces parity) to
    /// say something only a developer will act on.
    /// </summary>
    private static string DescribeUnreadableEntry(GameActionDto action, Exception ex)
    {
        Console.Error.WriteLine(
            $"[GameTerminal] Could not render '{action.ActionType}' entry {action.Id}: {ex.GetType().Name}: {ex.Message}");
        return $"[unreadable {action.ActionType} entry]";
    }

    /// <summary>
    /// Localizes a comma-joined list of nation names that the server pre-composed into the action
    /// metadata (ActionMetadata.DefendersStr / RespondingNationStr are built with string.Join over
    /// Nation values). Splitting and re-mapping keeps those nations translated without changing the
    /// logged format. Anything that does not parse as a Nation is passed through unchanged.
    /// </summary>
    private string LocalizeNationList(string? joinedNations)
    {
        if (string.IsNullOrEmpty(joinedNations)) return string.Empty;

        var parts = joinedNations.Split(',').Select(p => p.Trim())
            .Select(p => Enum.TryParse<Nation>(p, out var n) ? Names.Nation(n) : p);
        return string.Join(", ", parts);
    }

    /// <summary>Localized unit type, or empty when the metadata did not record one.</summary>
    /// <summary>
    /// Lowercase unit noun for use inside a sentence (an object, not the subject). The capitalised
    /// Names.UnitType is the standalone label used by the Import dropdown and unit lists.
    /// </summary>
    private string LocalizeUnitType(UnitType? unitType) => unitType.HasValue ? Names.UnitTypeLower(unitType.Value) : string.Empty;

    /// <summary>Resource-key suffix selecting the message variant whose verb agrees with this unit.</summary>
    private static string UnitKeySuffix(UnitType? unitType) => unitType == UnitType.Fleet ? "Fleet" : "Army";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Follow the newest entry, but only while the reader has not scrolled up to read back - see
        // scrollToBottomIfPinned in index.html. Unconditional scrolling made the log unreadable
        // during a replay, which pushes an update every step and pinned the view to the bottom even
        // while paused.
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottomIfPinned", terminalBodyRef);
        }
        catch (Exception) { /* Ignored if element invalid */ }
    }
}
