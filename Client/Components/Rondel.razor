@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@using System.Globalization
@using System.Linq
@inject IStringLocalizer<Rondel> L
@inject DisplayNameLocalizer Names

<div class="rondel-container @(IsMyTurn && !IsLocked ? "my-turn-highlight" : "")">
    <svg viewBox="-105 -105 210 210" class="rondel-svg" style="width: 100%; height: auto;">
        <defs>
            <filter id="drop-shadow">
                <feDropShadow dx="1" dy="1" stdDeviation="2" flood-opacity="0.5"/>
            </filter>
        </defs>

        @for (int i = 0; i < 8; i++)
        {
            var index = i; 
            var segment = Imperial2030.Shared.Constants.RondelData.GetSlotInfo(index);
            var isHoverable = CanMoveTo(index);
            var isCurrent = CurrentPosition == index;
            // Rotation centers the slice at the target angle.
            // Formula: index*45 - 90. 
            // 0 -> -90 (Top).
            var rotation = (index * 45 - 90).ToString(CultureInfo.InvariantCulture);
            var scale = (isCurrent ? 1.05 : 1).ToString(CultureInfo.InvariantCulture);

            <g transform="rotate(@rotation)" 
               class="rondel-slice @(isHoverable ? "hoverable" : "")"
               @onclick="@(() => OnSliceClick(index))">
                <title>@GetSliceTooltip(index)</title>
                <!-- Slice Shape: Symmetric wedge centered at 0 deg (-22.5 to +22.5) -->
                <!-- x = 100 * cos(22.5) = 92.388 -->
                <!-- y = 100 * sin(22.5) = 38.268 -->
                <path d="M0,0 L92.39,-38.27 A100,100 0 0,1 92.39,38.27 Z" 
                      fill="@segment.Color" 
                      stroke="#333" 
                      stroke-width="1"
                      transform="scale(@scale)" />

                <!-- Text label: Centered in the slice (at angle 0 relative to group) -->
                <text x="65" y="4" 
                      transform="rotate(0)" 
                      text-anchor="middle" 
                      fill="#fff" 
                      stroke="#000"
                      stroke-width="0.6"
                      paint-order="stroke"
                      font-size="10" 
                      font-weight="bold"
                      style="pointer-events: none;">
                    @Names.RondelSlot(index)
                </text>
            </g>
        }

        <!-- Center Hub -->
        <circle cx="0" cy="0" r="20" fill="#444" stroke="#888" stroke-width="2" />
        
        <!-- Nation Markers -->
        @foreach (var group in NationStates.Where(n => n.RondelPosition.HasValue).GroupBy(n => n.RondelPosition!.Value))
        {
            var pos = group.Key;
            var angle = (pos * 45) - 90; 
            var rad = (angle * Math.PI) / 180.0;
            
            int indexInSlot = 0;
            foreach (var nation in group)
            {
                 // Stack radially outward: 45, 65, 85, etc.
                 var r = 45 + (indexInSlot * 18); 
                 var x = (r * Math.Cos(rad)).ToString(CultureInfo.InvariantCulture);
                 var y = (r * Math.Sin(rad)).ToString(CultureInfo.InvariantCulture);
                 indexInSlot++;

                 <g transform="translate(@x, @y)">
                     @if (nation.Nation == CurrentTurnNation)
                     {
                         <!-- Highlight Ring for Active Turn -->
                         <circle r="11" fill="none" stroke="#fff" stroke-width="3" opacity="0.8">
                            <animate attributeName="opacity" values="0.8;0.3;0.8" dur="1.5s" repeatCount="indefinite" />
                         </circle>
                         <circle r="9" fill="@GetNationColor(nation.Nation)" stroke="#fff" stroke-width="2" />
                     }
                     else
                     {
                         <circle r="8" fill="@GetNationColor(nation.Nation)" stroke="#fff" stroke-width="1" />
                     }
                     <text y="3" text-anchor="middle" font-size="7" fill="#fff" font-weight="@(nation.Nation == CurrentTurnNation ? "bold" : "normal")">
                         @GetNationAbbreviation(nation.Nation)
                     </text>
                 </g>
            }
        }

    </svg>
</div>

@code {
    [Parameter] public List<NationStateDto> NationStates { get; set; } = new();
    [Parameter] public Nation CurrentTurnNation { get; set; }
    [Parameter] public bool IsMyTurn { get; set; }
    [Parameter] public bool IsLocked { get; set; }
    [Parameter] public EventCallback<int> OnMoveSelected { get; set; }
    [Parameter] public GameDetailDto? Game { get; set; }
    [Parameter] public Guid? CurrentPlayerId { get; set; }

    private int? CurrentPosition => NationStates.FirstOrDefault(n => n.Nation == CurrentTurnNation)?.RondelPosition;

    private bool CanMoveTo(int targetIndex)
    {
        if (!IsMyTurn || IsLocked) return false;
        
        var currentPos = CurrentPosition;
        
        // If not on Rondel yet, ANY move is valid (and free)
        if (currentPos == null) return true;
        
        // Calculate forward distance
        int dist = (targetIndex - currentPos.Value + 8) % 8;
        if (dist == 0) return false; // Can't stay
        
        return true; 
    }

    private async Task OnSliceClick(int index)
    {
        if (CanMoveTo(index))
        {
            await OnMoveSelected.InvokeAsync(index);
        }
    }

    private string GetSliceTooltip(int index)
    {
        // Keyed by slot index, not by slot name: the name is now localized, so switching on the
        // English string (as this did) would silently stop matching in any other language.
        string baseMsg = L[$"Desc_Slot_{index}"];

        if (Game == null || string.IsNullOrEmpty(baseMsg)) return baseMsg;

        var nationState = Game.NationStates.FirstOrDefault(n => n.Nation == CurrentTurnNation);
        if (nationState == null) return baseMsg;

        if (index == Imperial2030.Shared.Constants.RondelData.TaxationSlot) // Taxation Calculation
        {
            // Was re-deriving this inline and, uniquely among the call sites, omitted the 15-flag
            // cap — it applied only the 23M total cap. Unreachable in practice (the board enforces
            // 15 flags per nation) but it would have drifted the moment that limit changed.
            int unblockedFactories = TaxationRules.CountUnblockedFactories(Game, CurrentTurnNation);
            int flagCount = Game.Territories.Count(ts => ts.Controller == CurrentTurnNation);
            int totalTaxRevenue = TaxationRules.ComputeRevenue(unblockedFactories, flagCount);
            int unitCount = Game.Units.Count(u => u.Nation == CurrentTurnNation);
            int soldiersPay = TaxationRules.ComputeSoldiersPay(unitCount);
            
            int bonus = 0;
            if (Game.VariantBonusOnlyForTaxIncreases)
            {
                int oldTier = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(nationState.TaxRevenue);
                int newTier = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(totalTaxRevenue);
                bonus = Math.Max(0, newTier - oldTier);
            }
            else
            {
                bonus = Imperial2030.Shared.Constants.TaxChart.GetStandardBonus(totalTaxRevenue);
            }
            
            // Expected Treasury after tax but before pay
            int tempTreasury = nationState.Treasury + totalTaxRevenue;
            int actualPay = Math.Min(tempTreasury, soldiersPay);
            tempTreasury -= actualPay;
            int actualBonus = Math.Min(tempTreasury, bonus);

            int powerGain = Imperial2030.Shared.Constants.TaxChart.GetPowerGain(totalTaxRevenue);

            string controllerName = nationState.ControllerName ?? Names.Nation((Nation?)null);
            string youIndicator = Game.Players.FirstOrDefault(p => p.Id == CurrentPlayerId)?.UserName == controllerName ? L["YouSuffix"] : "";
            int newTreasury = tempTreasury - actualBonus;
            int treasuryGain = newTreasury - nationState.Treasury;

            string payStr = actualPay > 0 ? $"-{actualPay}" : actualPay.ToString();
            string tGainStr = treasuryGain > 0 ? $"+{treasuryGain}" : treasuryGain.ToString();
            string bonusStr = actualBonus > 0 ? $"+{actualBonus}" : actualBonus.ToString();
            string powerStr = powerGain > 0 ? $"+{powerGain}" : powerGain.ToString();

            return $"{baseMsg}\n\n{L["Tax_Revenue", totalTaxRevenue]}\n{L["Tax_SoldiersPay", payStr]}\n{L["Tax_TreasuryGain", tGainStr]}\n{L["Tax_ControllerBonus", controllerName, youIndicator, bonusStr]}\n{L["Tax_PowerGain", powerStr]}";
        }
        else if (index == Imperial2030.Shared.Constants.RondelData.InvestorSlot) // Investor Calculation
        {
            var payouts = new System.Collections.Generic.Dictionary<string, int>();
            int totalOwed = 0;
            
            foreach (var p in Game.Players)
            {
                int pInterest = p.Bonds?.Where(b => b.Nation == CurrentTurnNation).Sum(b => b.Interest) ?? 0;
                if (pInterest > 0)
                {
                    payouts[p.UserName] = pInterest;
                    totalOwed += pInterest;
                }
            }

            int treasuryAmount = nationState.Treasury;
            string details = $"{baseMsg}\n\n{L["Treasury", treasuryAmount]}\n";
            string meUserName = Game.Players.FirstOrDefault(p => p.Id == CurrentPlayerId)?.UserName ?? "";

            if (payouts.Count == 0)
            {
                details += L["Investor_NoBonds"];
                return details;
            }

            string ctrlName = nationState.ControllerName ?? Names.Nation((Nation?)null);
            string ctrlSuffix = ctrlName == meUserName ? L["YouSuffix"] : "";

            if (treasuryAmount >= totalOwed)
            {
                details += L["Investor_Payouts"] + "\n";
                foreach (var kvp in payouts.OrderByDescending(p => p.Value))
                {
                    string suffix = kvp.Key == meUserName ? L["YouSuffix"] : "";
                    details += L["Investor_PayoutLine", kvp.Key, suffix, kvp.Value] + "\n";
                }
            }
            else
            {
                int owedToOthers = 0;
                int owedToController = 0;
                foreach (var kvp in payouts)
                {
                    if (kvp.Key == ctrlName) owedToController += kvp.Value;
                    else owedToOthers += kvp.Value;
                }

                if (treasuryAmount >= owedToOthers)
                {
                    // Treasury can pay others, controller gets whatever is left.
                    details += L["Investor_Payouts"] + "\n";
                    int actualControllerPay = treasuryAmount - owedToOthers;
                    foreach (var kvp in payouts.OrderByDescending(p => p.Value))
                    {
                        string suffix = kvp.Key == meUserName ? L["YouSuffix"] : "";
                        int receiveAmount = kvp.Key == ctrlName ? actualControllerPay : kvp.Value;
                        string cap = kvp.Key == ctrlName && actualControllerPay < kvp.Value ? L["Investor_TreasuryMax"] : "";
                        details += L["Investor_PayoutLine", kvp.Key, suffix, receiveAmount] + cap + "\n";
                    }
                }
                else
                {
                    // Treasury cannot even pay others. Controller gets nothing, AND pays out of pocket.
                    int deficit = owedToOthers - treasuryAmount;
                    details += L["Investor_Insufficient"] + "\n\n" + L["Investor_Payouts"] + "\n";
                    foreach (var kvp in payouts.OrderByDescending(p => p.Value))
                    {
                        string suffix = kvp.Key == meUserName ? L["YouSuffix"] : "";
                        int receiveAmount = kvp.Key == ctrlName ? 0 : kvp.Value;
                        string none = kvp.Key == ctrlName ? L["Investor_NothingReceived"] : "";
                        details += L["Investor_PayoutLine", kvp.Key, suffix, receiveAmount] + none + "\n";
                    }
                    details += "\n" + L["Investor_DeficitLine", ctrlName, ctrlSuffix, deficit];
                }
            }
            return details;
        }
        else if (index == Imperial2030.Shared.Constants.RondelData.FactorySlot) // Factory
        {
            var myHomeCities = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == CurrentTurnNation).ToList();
            int myFactories = Game.Territories.Count(ts => ts.HasFactory && myHomeCities.Any(hc => hc.Id == ts.TerritoryId));
            int maxFactories = myHomeCities.Count;
            
            bool hasValidEmptyCity = false;
            foreach (var city in myHomeCities)
            {
                var ts = Game.Territories.FirstOrDefault(t => t.TerritoryId == city.Id);
                if (ts == null || !ts.HasFactory)
                {
                    bool hasHostile = Game.Units.Any(u => u.TerritoryId == city.Id && u.UnitType == Imperial2030.Shared.Models.UnitType.Army && u.Nation != CurrentTurnNation && u.IsHostile);
                    if (!hasHostile)
                    {
                        hasValidEmptyCity = true;
                        break;
                    }
                }
            }
            
            string canBuild;
            if (myFactories >= maxFactories) canBuild = L["Factory_No_MaxReached"];
            else if (nationState.Treasury < 5) canBuild = L["Factory_No_Need5M"];
            else if (!hasValidEmptyCity) canBuild = L["Factory_No_Blocked"];
            else canBuild = L["Answer_Yes"];

            return $"{baseMsg}\n\n{L["Treasury", nationState.Treasury]}\n{L["Factory_CurrentFactories", myFactories, maxFactories]}\n{L["Factory_CanBuild", canBuild]}";
        }
        else if (index == Imperial2030.Shared.Constants.RondelData.ImportSlot) // Import
        {
            string canImport = nationState.Treasury >= 1 ? L["Answer_Yes"] : L["Import_No_Need1M"];
            int maxUnits = Math.Min(3, nationState.Treasury);
            return $"{baseMsg}\n\n{L["Treasury", nationState.Treasury]}\n{L["Import_CanImport", canImport]}\n{L["Import_MaxUnits", maxUnits]}";
        }
        else if (Imperial2030.Shared.Constants.RondelData.IsProductionSlot(index)) // Production
        {
            var myFactories = Game.Territories.Where(ts => ts.HasFactory).Select(ts => ts.TerritoryId).ToList();
            var myHomeFactories = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.Where(t => t.Nation == CurrentTurnNation && myFactories.Contains(t.Id)).ToList();
            
            int armyProd = myHomeFactories.Count(f => f.CityType == Imperial2030.Shared.Models.CityType.Brown);
            int fleetProd = myHomeFactories.Count(f => f.CityType == Imperial2030.Shared.Models.CityType.LightBlue);
            
            // Check hostiles that might block production
            int blockedArmies = 0;
            int blockedFleets = 0;
            foreach (var f in myHomeFactories)
            {
                bool hasHostile = Game.Units.Any(u => u.TerritoryId == f.Id && u.UnitType == Imperial2030.Shared.Models.UnitType.Army && u.Nation != CurrentTurnNation && u.IsHostile);
                if (hasHostile)
                {
                    if (f.CityType == Imperial2030.Shared.Models.CityType.Brown) blockedArmies++;
                    else if (f.CityType == Imperial2030.Shared.Models.CityType.LightBlue) blockedFleets++;
                }
            }

            int currentArmies = Game.Units.Count(u => u.Nation == CurrentTurnNation && u.UnitType == Imperial2030.Shared.Models.UnitType.Army);
            int currentFleets = Game.Units.Count(u => u.Nation == CurrentTurnNation && u.UnitType == Imperial2030.Shared.Models.UnitType.Fleet);

            int maxArmies = Imperial2030.Shared.Constants.NationData.GetMaxArmies(CurrentTurnNation);
            int maxFleets = Imperial2030.Shared.Constants.NationData.GetMaxFleets(CurrentTurnNation);

            int availableArmiesToProduce = Math.Max(0, maxArmies - currentArmies);
            int availableFleetsToProduce = Math.Max(0, maxFleets - currentFleets);

            int actualArmyProd = Math.Min(availableArmiesToProduce, Math.Max(0, armyProd - blockedArmies));
            int actualFleetProd = Math.Min(availableFleetsToProduce, Math.Max(0, fleetProd - blockedFleets));

            string details = $"{baseMsg}\n";
            details += "\n" + L["Production_Armies", actualArmyProd, maxArmies, blockedArmies];
            details += "\n" + L["Production_Fleets", actualFleetProd, maxFleets, blockedFleets];
            return details;
        }
        else if (Imperial2030.Shared.Constants.RondelData.IsManeuverSlot(index)) // Maneuver
        {
            int armies = Game.Units.Count(u => u.Nation == CurrentTurnNation && u.UnitType == Imperial2030.Shared.Models.UnitType.Army);
            int fleets = Game.Units.Count(u => u.Nation == CurrentTurnNation && u.UnitType == Imperial2030.Shared.Models.UnitType.Fleet);
            return $"{baseMsg}\n\n{L["Maneuver_FleetsReady", fleets]}\n{L["Maneuver_ArmiesReady", armies]}";
        }

        return baseMsg;
    }

    private string GetNationAbbreviation(Nation nation) => Names.NationAbbrev(nation);


    private string GetNationColor(Nation nation) => Imperial2030.Shared.Constants.NationData.GetColor(nation);
}

<style>
    .rondel-container {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
    }
    .rondel-slice {
        cursor: default;
        transition: opacity 0.2s;
    }
    .rondel-slice.hoverable {
        cursor: pointer;
    }
    .rondel-slice.hoverable:hover {
        opacity: 0.8;
    }
    .my-turn-highlight {
        animation: rondel-pulse 2s infinite;
        border-radius: 50%;
        box-shadow: 0 0 20px 5px rgba(241, 196, 15, 0.6); /* Gold glow */
    }

    @@keyframes rondel-pulse {
        0% { box-shadow: 0 0 10px 2px rgba(241, 196, 15, 0.4); }
        50% { box-shadow: 0 0 25px 8px rgba(241, 196, 15, 0.9); }
        100% { box-shadow: 0 0 10px 2px rgba(241, 196, 15, 0.4); }
    }
</style>

