        /// rail hops and convoy sea regions alike. Empty for a plain step to an adjacent territory.
        ///
        /// Comes from the move's own log entry (ActionMetadata.RouteVia), which the server records at
        /// the time of the move. Only falls back to reconstruction for entries logged before that field
        /// existed - see AttachConvoyRoute.
        /// </summary>
        public List<string> ConvoyVia { get; set; } = new();
    }

