@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@using Imperial2030.Client.Constants

<div class="map-container">
    @if (ShowConvoyModal)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Select Convoy Path</h5>
                        <button type="button" class="btn-close" @onclick="CloseConvoyModal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Multiple convoy routes available. Choose one:</p>
                        <div class="list-group">
                            @for (int i = 0; i < ConvoyOptions.Count; i++)
                            {
                                var path = ConvoyOptions[i];
                                var index = i; 
                                <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectConvoyOption(index)">
                                    Route @(i + 1): via @string.Join(", ", path.Select(f => f.TerritoryId))
                                </button>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseConvoyModal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }
