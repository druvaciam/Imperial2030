    private async Task ConfirmDestroyFactory()
    {
        if (Game == null) return;
        if (!string.IsNullOrEmpty(PendingDestroyFactoryId) && PendingDestroyFactoryUnits.Count == ManeuverRules.DestroyFactoryArmyCost)
        {
            var unitIds = PendingDestroyFactoryUnits.Select(u => u.Id).ToList();
            bool success = await ManeuverService.DestroyFactoryAsync(Game.Id, PendingDestroyFactoryId, unitIds);
            if (!success)
            {
                await JSRuntime.InvokeVoidAsync("alert", L["Destroy_Failed"].Value);
            }
        }
        ShowDestroyFactoryModal = false;
        PendingDestroyFactoryId = "";
        PendingDestroyFactoryUnits.Clear();
    }

    private bool IsWarningMove(Unit movingUnit, string destTerritoryId, out string warningMessage)
    {
        warningMessage = "";
        if (Game == null) return false;

        var sourceDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == movingUnit.TerritoryId);
        var destDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == destTerritoryId);

        // Fleets moving out of port (Land to Sea) are always unambiguous first moves
        if (movingUnit.UnitType == UnitType.Fleet && sourceDef?.Type == TerritoryType.Land && destDef?.Type == TerritoryType.Sea)
        {
            return false;
        }

        // 1. Home to Home
        bool sourceIsHome = sourceDef != null && sourceDef.Nation == movingUnit.Nation;
        bool destIsHome = destDef != null && destDef.Nation == movingUnit.Nation;

        if (sourceIsHome && destIsHome)
        {
            warningMessage = L["MoveWarning_HomeToHome", Names.Territory(movingUnit.TerritoryId), Names.Territory(destTerritoryId)];
            return true;
        }

        // 2. Dest already has a friendly unit
        bool destHasFriendlyUnit = Game.Units.Any(u => u.TerritoryId == destTerritoryId && u.Nation == movingUnit.Nation && u.Id != movingUnit.Id);
        if (destHasFriendlyUnit)
        {
            warningMessage = L["MoveWarning_FriendlyPresent", Names.Territory(destTerritoryId)];
            return true;
        }

        return false;
    }
    
    private async Task ConfirmWarningMove()
    {
        if (PendingWarningUnit != null && !string.IsNullOrEmpty(PendingWarningDest))
        {
            if (PendingWarningConvoyPaths != null && PendingWarningConvoyPaths.Any())
            {
                await MoveUnit(PendingWarningUnit, PendingWarningDest, PendingWarningConvoyPaths);
            }
            else
            {
                await MoveUnit(PendingWarningUnit, PendingWarningDest);
            }
        }
        CancelWarningMove();
    }

    private void CancelWarningMove()
    {
        ShowMoveWarningModal = false;
        PendingWarningUnit = null;
        PendingWarningDest = "";
        PendingWarningConvoyPaths = null;
        MoveWarningMessage = "";
        DeselectUnit();
    }

    private bool CheckCanDestroyFactory(string territoryId, Imperial2030.Shared.Models.Nation nation, out List<Unit> attackingUnits)
    {
        attackingUnits = new List<Unit>();
        if (Game == null) return false;

        // 1. Check if Territory has Factory
        var tState = Game.Territories.FirstOrDefault(t => t.TerritoryId == territoryId);
        if (tState == null || !tState.HasFactory) return false;

        // 2. Check if Foreign Home Province
        var tDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
        if (tDef == null || !tDef.Nation.HasValue || tDef.Nation.Value == nation || tDef.CityType == CityType.None) return false;

        // 3. Check for Defenders (Any unit of Territory Owner)
        var defenders = Game.Units.Any(u => u.TerritoryId == territoryId && u.Nation == tDef.Nation.Value);
        if (defenders) return false;

        // 4. Check for enough attacking armies
        var myArmies = Game.Units.Where(u => u.TerritoryId == territoryId && u.Nation == nation && u.UnitType == UnitType.Army).ToList();
        if (myArmies.Count >= ManeuverRules.DestroyFactoryArmyCost)
        {
            attackingUnits = myArmies.Take(ManeuverRules.DestroyFactoryArmyCost).ToList();
            return true;
        }

        return false;
    }

    private async Task OnTerritoryClick(string territoryId)
    {
        Console.WriteLine($"Player clicked on: {territoryId}");

        if (Game == null || !IsMyTurn || IsObserver) return;

        var nation = Game.CurrentTurnNation;
        var ns = Game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return;

        // MANEUVER PHASE LOGIC
        bool isManeuverSlot = RondelData.IsManeuverSlot(ns.RondelPosition ?? -1);
        if (Game.ManeuverState != null && isManeuverSlot)
        {
            await HandleManeuverClick(territoryId, nation);
            return;
        }

        // FACTORY LOGIC (Existing)
        // check if Factory action (Slot 1) - must have moved on rondel this turn first
        if (ns.RondelPosition == RondelData.FactorySlot && ns.HasMovedThisTurn)
        {
            await HandleFactoryClick(territoryId, nation, ns);
        }
    }

    private async Task HandleManeuverClick(string territoryId, Imperial2030.Shared.Models.Nation nation)
    {
        if (Game == null) return;

        // 1. Execute Move if valid (PRIORITY: If we have a selection and clicked a valid target, MOVE)
        if (selectedUnitId.HasValue)
        {
            var selectedUnit = Game.Units.FirstOrDefault(u => u.Id == selectedUnitId.Value);
            if (selectedUnit == null) 
            {
                DeselectUnit(); // Invalid unit (maybe destroyed?)
                return;
            }

            // Check Adjacency / Valid Destinations
            // We already calculated validDestinations on selection, but let's re-verify specific types.
            
            // Is Destination standard neighbor?
            if (!validDestinations.Contains(territoryId))
            {
                 if (selectedUnit.TerritoryId == territoryId)
                 {
                     await SelectUnitAt(territoryId, nation, cycle: true);
                 }
                 else
                 {
                     DeselectUnit();
                 }
                 return;
            }

            // BATTLE CHECK (Fleets & Armies)
            {
                var potentialEnemies = Game.Units
                    .Where(u => u.TerritoryId == territoryId && u.Nation != selectedUnit.Nation)
                    .Select(u => u.Nation)
                    .Distinct()
                    .ToList();
                
                var tDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
                bool isForeignHome = tDef != null && tDef.Nation.HasValue && tDef.Nation.Value != selectedUnit.Nation;
                bool isMyHome = tDef != null && tDef.Nation.HasValue && tDef.Nation.Value == selectedUnit.Nation;

                if (isMyHome && potentialEnemies.Any())
                {
                    if (potentialEnemies.Count == 1)
                    {
                        // No need for popup, forced hostile auto-attack
                        await MoveUnit(selectedUnit, territoryId, null, true);
                        return;
                    }
                }

                if (potentialEnemies.Any() || isForeignHome)
                {
                    PendingBattleUnit = selectedUnit;
                    PendingBattleDest = territoryId;
                    BattleOptions = potentialEnemies;
                    IsForcedHostile = isMyHome;
                    ShowBattleModal = true;
                    StateHasChanged();
                    return;
                }
            }

            // Determine Move Type
            bool isStandard = false; 
            if (MapConnectivity.Adjacency.TryGetValue(selectedUnit.TerritoryId, out var neighbors))
            {
                isStandard = neighbors.Contains(territoryId);
            }
            
            bool isRail = false;
            if (!isStandard && selectedUnit.UnitType == UnitType.Army)
            {
                var railDestinations = GetRailReachableTerritories(selectedUnit.TerritoryId, selectedUnit.Nation);
                isRail = railDestinations.Contains(territoryId);
            }

            Console.WriteLine($"[MOVE] UnitType={selectedUnit.UnitType} From={selectedUnit.TerritoryId} To={territoryId} isStandard={isStandard} isRail={isRail}");

            if (isStandard || isRail || selectedUnit.UnitType == UnitType.Fleet)
            {
                // Standard or Rail Move
                Console.WriteLine($"[MOVE] Executing standard/rail move (no convoy fleets)");
                if (IsWarningMove(selectedUnit, territoryId, out string msg))
                {
                    PendingWarningUnit = selectedUnit;
                    PendingWarningDest = territoryId;
                    MoveWarningMessage = msg;
                    PendingWarningConvoyPaths = null;
                    ShowMoveWarningModal = true;
                    StateHasChanged();
                }
                else
                {
                    await MoveUnit(selectedUnit, territoryId); 
                    DeselectUnit();
                }
            }
            else
            {
                // Army Convoy Check
                var convoyPaths = GetAllConvoyPaths(Game, selectedUnit.TerritoryId, territoryId, selectedUnit.Nation);
                
                if (convoyPaths.Count == 0)
                {
                    DeselectUnit();
                }
                else if (convoyPaths.Count == 1)
                {
                    // Single Convoy Path
                    if (IsWarningMove(selectedUnit, territoryId, out string msg))
                    {
                        PendingWarningUnit = selectedUnit;
                        PendingWarningDest = territoryId;
                        MoveWarningMessage = msg;
                        PendingWarningConvoyPaths = convoyPaths[0].Select(u => u.Id).ToList();
                        ShowMoveWarningModal = true;
                        StateHasChanged();
                    }
                    else
                    {
                        await MoveUnit(selectedUnit, territoryId, convoyPaths[0].Select(u => u.Id).ToList());
                        DeselectUnit();
                    }
                }
                else
                {
                    // Multiple Convoy Paths -> Modal
                    ConvoyOptions = convoyPaths;
                    PendingMoveDest = territoryId;
                    ShowConvoyModal = true;
                    StateHasChanged();
                }
            }
        }
        else
        {
             // Check for Destroy Factory Opportunity
             if (CheckCanDestroyFactory(territoryId, nation, out var attackingUnits))
             {
                 PendingDestroyFactoryId = territoryId;
                 PendingDestroyFactoryName = Names.Territory(territoryId);
                 PendingDestroyFactoryUnits = attackingUnits;
                 ShowDestroyFactoryModal = true;
                 StateHasChanged();
                 return;
             }

             // Select Unit Logic
             await SelectUnitAt(territoryId, nation);
        }
    }
    private async Task SelectUnitAt(string territoryId, Imperial2030.Shared.Models.Nation nation, bool cycle = false)
    {
        if (Game == null || Game.ManeuverState == null) return;

        // 2. Check for selectable unit at location
        var unitsAtLoc = Game.Units
            .Where(u => u.TerritoryId == territoryId && u.Nation == nation)
            .ToList();

        var relevantUnits = unitsAtLoc.Where(u => 
            !u.HasMoved &&
            ((Game.ManeuverState.Phase == ManeuverPhase.Fleets && u.UnitType == UnitType.Fleet) ||
            (Game.ManeuverState.Phase == ManeuverPhase.Armies && u.UnitType == UnitType.Army))).ToList();

        if (relevantUnits.Any())
        {
            if (cycle && selectedUnitId.HasValue)
            {
                int currentIndex = relevantUnits.FindIndex(u => u.Id == selectedUnitId.Value);
                if (currentIndex >= 0)
                {
                    if (currentIndex + 1 < relevantUnits.Count)
                    {
                        selectedUnitId = relevantUnits[currentIndex + 1].Id;
                    }
                    else
                    {
                        DeselectUnit();
                        return;
                    }
                }
                else
                {
                    selectedUnitId = relevantUnits.First().Id;
                }
            }
            else
            {
                selectedUnitId = relevantUnits.First().Id;
            }
            
            var newlySelectedUnit = relevantUnits.First(u => u.Id == selectedUnitId.Value);
            validDestinations = GetValidDestinations(newlySelectedUnit, territoryId);
            StateHasChanged();
            return;
        }

        // If no units found, fallback
        // Check for Factory Action
        var ns = Game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns != null && ns.RondelPosition == RondelData.FactorySlot)
        {
            await HandleFactoryClick(territoryId, nation, ns);
        }

        // 3. Deselect if clicked empty space
        if (selectedUnitId.HasValue)
        {
            DeselectUnit();
        }
    }

    private void DeselectUnit()
    {
        selectedUnitId = null;
        validDestinations.Clear();
        // Clear Battle Modals
        ShowBattleModal = false;
        ShowStationaryBattleModal = false;
        ShowDestroyFactoryModal = false;
        PendingBattleUnit = null;
        StateHasChanged();
    }
    
    private List<string> GetValidDestinations(Unit unit, string currentTerritoryId)
    {
        var destinations = new HashSet<string>();
        if (Game == null) return destinations.ToList();

        // 1. Standard Adjacency
        var neighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(currentTerritoryId, unit.UnitType == UnitType.Fleet).ToList();
        
        if (unit.UnitType == UnitType.Fleet) 
        {
            // Filter blocked canals
            var validNeighbors = new List<string>();
            foreach (var dest in neighbors)
            {
                var canal = Imperial2030.Shared.Constants.MapConnectivity.CanalLinks.FirstOrDefault(c => 
                    (c.Region1 == currentTerritoryId && c.Region2 == dest) ||
                    (c.Region1 == dest && c.Region2 == currentTerritoryId));

                if (canal != default)
                {
                   // Check Controller
                   var controllerId = canal.ControllerId;
                   var tState = Game.Territories.FirstOrDefault(ts => ts.TerritoryId == controllerId);
                   // Logic: Block if Controller is NOT null AND NOT us
                   var controller = tState?.Controller;
                   
                   if (controller != null && controller != unit.Nation)
                   {
                       // Check if same player controls both nations
                       var movingNationState = Game.NationStates.FirstOrDefault(n => n.Nation == unit.Nation);
                       var canalNationState = Game.NationStates.FirstOrDefault(n => n.Nation == controller.Value);
                       
                       bool isSamePlayer = movingNationState?.ControllerName != null 
                                           && canalNationState?.ControllerName != null 
                                           && movingNationState.ControllerName == canalNationState.ControllerName;

                       if (!isSamePlayer)
                       {
                           // Blocked
                           Console.WriteLine($"[Canal] Passage through {controllerId} blocked by {controller}");
                           continue;
                       }
                   }
                }
                validNeighbors.Add(dest);
            }
            return validNeighbors;
        }

        // 2. Army Rail Logic
        // Combine neighbors with rail-reachable territories
        var railDestinations = GetRailReachableTerritories(currentTerritoryId, unit.Nation);
        var convoyDestinations = GetConvoyDestinations(currentTerritoryId, unit.Nation);

        var allDestinations = neighbors.Union(railDestinations).Union(convoyDestinations).Distinct().ToList();
        allDestinations.Remove(currentTerritoryId); // Fix: Exclude self (click = deselect)
        return allDestinations;
    }

    private List<string> GetRailReachableTerritories(string startId, Imperial2030.Shared.Models.Nation nation, bool includeExitPoints = true)
    {
        var reachable = new HashSet<string>();
        if (Game == null) return reachable.ToList();

        // Queue stores (id, cost). Cost represents number of border crossings/non-rail steps.
        var queue = new Queue<(string id, int cost)>();
        // Visited stores min cost found so far to reach a territory
        var minCosts = new Dictionary<string, int>();

        // Start with cost 0
        queue.Enqueue((startId, 0));
        minCosts[startId] = 0;

        while (queue.Count > 0)
        {
            var (currentId, currentCost) = queue.Dequeue();

            // Optimization: If we found a better path to this node already, skip
            if (minCosts.TryGetValue(currentId, out var recordedCost) && currentCost > recordedCost)
                continue;

            // Get LAND neighbors for rail propagation
            var adjacent = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(currentId, false);
            
            if (adjacent.Any())
            {
                var currentDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == currentId);
                // Check if Current is Home (for Rail Step Logic)
                bool isCurrentHome = currentDef != null && currentDef.IsHomeCity(nation);

                foreach (var neighborId in adjacent)
                {
                    var neighborDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == neighborId);
                    if (neighborDef == null || neighborDef.Type != TerritoryType.Land) continue;

                    // Determine Edge Cost
                    bool isNeighborHome = neighborDef.IsHomeCity(nation);
                    
                    var tState = Game.Territories.FirstOrDefault(t => t.TerritoryId == neighborId);
                    var effectiveController = tState?.Controller ?? neighborDef.Nation;
                    bool isControlledByUs = effectiveController == nation;
                    // Check for Hostile Armies (matches Server UnitType check)
                    bool hasHostileUnits = Game.Units.Any(u => u.TerritoryId == neighborId && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile);

                    bool isRailStep = false;
                    // Rail Step requires moving from Home to Home through Controlled/Safe territory
                    if (isCurrentHome && isNeighborHome && isControlledByUs && !hasHostileUnits)
                    {
                        isRailStep = true;
                    }

                    int edgeCost = isRailStep ? 0 : 1;
                    int newCost = currentCost + edgeCost;

                    // If Exit is not allowed (e.g. Convoy check?), enforce Home only?
                    // But includeExitPoints usually means "Allow reaching non-rail destinations".
                    if (!includeExitPoints && !isNeighborHome) continue;

                    if (newCost > 1) continue; // Cannot exceed 1 border crossing/non-rail step

                    reachable.Add(neighborId);

                    if (!minCosts.TryGetValue(neighborId, out var oldCost) || newCost < oldCost)
                    {
                        minCosts[neighborId] = newCost;
                        queue.Enqueue((neighborId, newCost));
                    }
                }
            }
        }

        return reachable.ToList();
    }

    private bool IsTerritoryRailValid(string territoryId, Imperial2030.Shared.Models.Nation nation)
    {
        if (Game == null) return false;

        var tDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
        if (tDef == null || tDef.Type != TerritoryType.Land) return false;

        // 1. Control Check (Home Province Only)
        // Rail logic only applies within the nation's home provinces.
        bool isHome = tDef.IsHomeCity(nation); 
        
        if (!isHome) 
        {
            return false;
        }

        // 2. Control Check (Must be controlled by us)
        var tState = Game.Territories.FirstOrDefault(t => t.TerritoryId == territoryId);
        // Fallback to Owner if Controller is null (Zombie State handling)
        var effectiveController = tState?.Controller ?? tDef.Nation;
        if (effectiveController != nation) return false;

        // 2. Hostile Unit Check (Suspends Rail)
        var hostileUnits = Game.Units.Any(u => u.TerritoryId == territoryId && u.Nation != nation && u.UnitType == UnitType.Army && u.IsHostile);
        if (hostileUnits) return false;

        return true;
    }

    private async Task HandleFactoryClick(string territoryId, Imperial2030.Shared.Models.Nation nation, Imperial2030.Shared.Models.NationStateDto ns)
    {
        if (Game == null) return;

        // Validate
        var territoryDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
        if (territoryDef == null) return;

        if (!territoryDef.IsHomeCity(nation))
        {
             await ShowToast(L["Factory_NotHomeCity"], true);
             return;
        }

        var territoryState = Game.Territories.FirstOrDefault(t => t.TerritoryId == territoryId);
        if (territoryState != null && territoryState.HasFactory)
        {
             await ShowToast(L["Factory_AlreadyExists"], true);
             return;
        }

        if (ns.Treasury < 5)
        {
             await JSRuntime.InvokeVoidAsync("alert", L["Factory_Need5M"].Value);
             return;
        }

        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", L["Factory_BuildConfirm", Names.Territory(territoryDef.Id)].Value);
        if (confirmed)
        {
            var response = await Http.PostAsync($"api/games/{Game.Id}/build-factory/{territoryId}", null);
            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                await JSRuntime.InvokeVoidAsync("alert", L["Factory_BuildFailed", error].Value);
            }
        }
    }

    private string GetTerritoryClass(string territoryId)
    {
        string baseClass = "map-territory";
        
        if (Game == null) return baseClass;

        if (validDestinations != null && validDestinations.Contains(territoryId))
        {
            baseClass += " valid-target";
        }

        if (Game.PendingBattleTerritoryId == territoryId)
        {
            baseClass += " pending-battle";
        }

        var territoryState = Game.Territories.FirstOrDefault(t => t.TerritoryId == territoryId);
        
        if (IsMyTurn)
        {
            var nation = Game.CurrentTurnNation;
            var ns = Game.NationStates.FirstOrDefault(n => n.Nation == nation);
            if (ns != null && ns.RondelPosition == RondelData.FactorySlot && ns.HasMovedThisTurn && !ns.HasBuiltThisTurn) // only highlight after moving on rondel
            {
                var territoryDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
                if (territoryDef != null && territoryDef.IsHomeCity(nation))
                {
                    if (territoryState == null || !territoryState.HasFactory)
                    {
                        baseClass += " valid-target";
                    }
                }
            }
        }

        return baseClass;
    }

    private string GetTerritoryTooltip(string territoryId)
    {
        var territoryDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == territoryId);
        if (territoryDef == null || Game == null) return "";

        var sb = new System.Text.StringBuilder();
        sb.AppendLine(Names.Territory(territoryDef.Id));

        // Owner
        var tState = Game.Territories.FirstOrDefault(t => t.TerritoryId == territoryDef.Id);
        if (tState != null && tState.Controller != null)
        {
            sb.AppendLine(L["Tooltip_Owner", Names.Nation(tState.Controller)]);
        }
        else if (territoryDef.Nation != null)
        {
            sb.AppendLine(L["Tooltip_HomeTerritory", Names.Nation(territoryDef.Nation)]);
        }

        // Factory
        if (tState != null && tState.HasFactory)
        {
            sb.AppendLine(L["Tooltip_FactoryYes"]);
        }

        // Units
        var units = Game.Units.Where(u => u.TerritoryId == territoryDef.Id).ToList();
        if (units.Any())
        {
            var armies = units.Where(u => u.UnitType == UnitType.Army)
                            .GroupBy(u => u.Nation)
                            .Select(g => L["Tooltip_NationCount", Names.Nation(g.Key), g.Count()].Value);
            
            var fleets = units.Where(u => u.UnitType == UnitType.Fleet)
                            .GroupBy(u => u.Nation)
                            .Select(g => L["Tooltip_NationCount", Names.Nation(g.Key), g.Count()].Value);

            if (armies.Any())
            {
                sb.AppendLine(L["Tooltip_Armies", string.Join(", ", armies)]);
            }
            if (fleets.Any())
            {
                sb.AppendLine(L["Tooltip_Fleets", string.Join(", ", fleets)]);
            }
        }

        string baseMsg = sb.ToString().Trim();

        if (!IsMyTurn || Game.IsInvestorTurn) return baseMsg;

        var nation = Game.CurrentTurnNation;
        var ns = Game.NationStates.FirstOrDefault(n => n.Nation == nation);
        if (ns == null) return baseMsg;

        if (Game.ManeuverState != null && Game.ManeuverState.Phase != ManeuverPhase.None && RondelData.IsManeuverSlot(ns.RondelPosition ?? -1))
        {
            if (selectedUnitId == null)
            {
                // Hovering over a unit of ours to select
                bool hasMovableUnit = Game.Units.Any(u => u.TerritoryId == territoryId && u.Nation == nation && !u.HasMoved && 
                    ((Game.ManeuverState.Phase == ManeuverPhase.Fleets && u.UnitType == UnitType.Fleet) || 
                     (Game.ManeuverState.Phase == ManeuverPhase.Armies && u.UnitType == UnitType.Army)));
                
                if (hasMovableUnit) return $"{baseMsg}\n\n{L["Tooltip_ClickToSelect", Names.ManeuverPhaseSingular(Game.ManeuverState.Phase)]}";
                return baseMsg;
            }
            else
            {
                if (validDestinations.Contains(territoryId)) return $"{baseMsg}\n\nClick to move unit here.";
                return $"{baseMsg}\n\nCannot move unit here.";
            }
        }

        if (ns.RondelPosition == RondelData.FactorySlot && ns.HasMovedThisTurn && !ns.HasBuiltThisTurn)
        {
            if (territoryDef.IsHomeCity(nation))
            {
                if (tState != null && tState.HasFactory) return $"{baseMsg}\n\nFactory already built here.";
                if (ns.Treasury < 5) return $"{baseMsg}\n\nNot enough treasury (Need 5M, have {ns.Treasury}M) to build factory.";
                return $"{baseMsg}\n\nClick to build factory for 5M.";
            }
            return $"{baseMsg}\n\nCan only build factory in Home Cities.";
        }

        if (ns.RondelPosition == RondelData.ImportSlot && !ns.HasImportedThisTurn && ns.Treasury >= 1)
        {
            if (territoryDef.IsHomeCity(nation))
            {
                bool hasHostileUnit = Game.Units.Any(u => u.TerritoryId == territoryId && u.Nation != nation && u.IsHostile);
                if (hasHostileUnit) return $"{baseMsg}\n\nCannot import here: Hostile forces present.";
                return $"{baseMsg}\n\nClick to Import here for 1M.";
            }
        }

        return baseMsg;
    }

