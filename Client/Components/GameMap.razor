@using Imperial2030.Shared.Models
@using Imperial2030.Shared.Constants
@using Imperial2030.Client.Constants
@inject IStringLocalizer<GameMap> L
@inject IStringLocalizer<SharedResource> Shared
@inject DisplayNameLocalizer Names
@implements IDisposable

<div class="map-container position-relative" style="flex: 1; width: 100%;">
    @if (selectedUnitId.HasValue)
    {
        <div class="position-absolute top-0 start-50 translate-middle-x mt-2 p-2 bg-warning text-dark rounded shadow fw-bold" style="z-index: 1000; opacity: 0.9; cursor: pointer;" @onclick="DeselectUnit">
            @L["UnitSelectedBanner"]
        </div>
    }

    @if (ShowConvoyModal)

    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@L["Convoy_Title"]</h5>
                        <button type="button" class="btn-close" @onclick="CloseConvoyModal"></button>
                    </div>
                    <div class="modal-body">
                        <p>@L["Convoy_Prompt"]</p>
                        <div class="list-group">
                            @for (int i = 0; i < ConvoyOptions.Count; i++)
                            {
                                var path = ConvoyOptions[i];
                                var index = i; 
                                <button type="button" class="list-group-item list-group-item-action" @onclick="() => SelectConvoyOption(index)">
                                    @L["Convoy_Route", i + 1, string.Join(", ", path.Select(f => Names.Territory(f.TerritoryId)))]
                                </button>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseConvoyModal">@Shared["Common_Cancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowBattleModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@L["Stance_Title"]</h5>
                    </div>
                    <div class="modal-body">
                        <p>@L["Stance_Body"]</p>
                        <p>@L["Stance_Prompt"]</p>
                        <div class="d-grid gap-2">
                             @if (!IsForcedHostile)
                             {
                                 <button class="btn btn-success" @onclick="ConfirmPeace">
                                     @L["Stance_Peaceful"]
                                 </button>
                             }
                             @foreach (var nation in BattleOptions)
                             {
                                 <button class="btn btn-danger" @onclick="() => ConfirmBattle(nation)">
                                     Attack @nation
                                 </button>
                             }
                             @if (!BattleOptions.Any())
                             {
                                 <button class="btn btn-danger" @onclick="ConfirmHostile">
                                     @L["Stance_EnterHostilely"]
                                 </button>
                             }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowStationaryBattleModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@L["Stationary_Title"]</h5>
                        <button type="button" class="btn-close" @onclick="CancelStationaryBattle"></button>
                    </div>
                    <div class="modal-body">
                        <p>@L["Stationary_Prompt"]</p>
                        <div class="d-grid gap-2">
                             @foreach (var nation in BattleOptions)
                             {
                                 <button class="btn btn-danger" @onclick="() => ExecuteStationaryBattle(nation)">
                                     Attack @nation
                                 </button>
                             }
                        </div>
                    </div>
                     <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelStationaryBattle">@Shared["Common_Cancel"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowDestroyFactoryModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@L["Destroy_Title"]</h5>
                        <button type="button" class="btn-close" @onclick="CancelDestroyFactory"></button>
                    </div>
                    <div class="modal-body">
                        <p>@L["Destroy_Occupied", PendingDestroyFactoryName]</p>
                        <p>@L["Destroy_Question"]</p>
                        <div class="alert alert-warning">
                            @L["Destroy_Warning"]
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelDestroyFactory">@Shared["Common_Cancel"]</button>
                        <button class="btn btn-danger" @onclick="ConfirmDestroyFactory">@L["Destroy_Confirm"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (ShowMoveWarningModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 3000;">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title text-warning">@L["MoveWarning_Title"]</h5>
                        <button type="button" class="btn-close" @onclick="CancelWarningMove"></button>
                    </div>
                    <div class="modal-body">
                        <p>@MoveWarningMessage</p>
                        <p>@L["MoveWarning_Question"]</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelWarningMove">@L["MoveWarning_Cancel"]</button>
                        <button class="btn btn-warning" @onclick="ConfirmWarningMove">@L["MoveWarning_Confirm"]</button>
                    </div>
                </div>
            </div>
        </div>
    }
