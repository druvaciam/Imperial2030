    }

    private async Task SelectConvoyOption(int index)
    {
        if (index < 0 || index >= ConvoyOptions.Count || PendingMoveDest == null || !selectedUnitId.HasValue || Game == null) return;

        var path = ConvoyOptions[index];
        var unit = Game.Units.FirstOrDefault(u => u.Id == selectedUnitId.Value);
        
        if (unit != null)
        {
            await MoveUnit(unit, PendingMoveDest, path.Select(u => u.Id).ToList());
        }

        CloseConvoyModal();
        DeselectUnit();
    }

    private async Task MoveUnit(Unit unit, string destinationId, List<Guid>? convoyFleets = null, bool isHostile = false)
    {
        if (Game == null) return;

        Console.WriteLine($"[MoveUnit] UnitType={unit.UnitType} From={unit.TerritoryId} To={destinationId} ConvoyFleets={convoyFleets?.Count ?? 0}");
        if (convoyFleets != null)
        {
            foreach (var fId in convoyFleets)
            {
                var fl = Game?.Units.FirstOrDefault(u => u.Id == fId);
                Console.WriteLine($"[MoveUnit]   Fleet {fId} at {fl?.TerritoryId} HasConvoyed={fl?.HasConvoyed}");
            }
        }
        // Remember the route this client actually chose, so the move animation can draw the real
        // convoy chain instead of reconstructing a plausible one. Captured before the request,
        // because the fleets' HasConvoyed flags change once the server applies the move.
        _lastConvoyVia = convoyFleets == null || Game == null
            ? new List<string>()
            : convoyFleets
                .Select(id => Game.Units.FirstOrDefault(u => u.Id == id)?.TerritoryId)
                .Where(t => !string.IsNullOrEmpty(t))
                .Select(t => t!)
                .ToList();
        _lastConvoyFrom = unit.TerritoryId;
        _lastConvoyTo = destinationId;

        string? errorMessage = null;
        if (unit.UnitType == UnitType.Fleet)
        {
            errorMessage = await ManeuverService.MoveFleet(Game.Id, unit.Id, destinationId, null, isHostile);
        }
        else
        {
            errorMessage = await ManeuverService.MoveArmy(Game.Id, unit.Id, destinationId, convoyFleets, null, isHostile);
        }

        if (errorMessage != null)
        {
             await JSRuntime.InvokeVoidAsync("alert", L["MoveFailed", errorMessage].Value);
        }
        else
        {
            // Optimistic local update: mark unit as moved and convoy fleets as used
            unit.HasMoved = true;
            unit.TerritoryId = destinationId;
            if (convoyFleets != null && Game != null)
            {
                foreach (var fleetId in convoyFleets)
                {
                    var fleet = Game.Units.FirstOrDefault(u => u.Id == fleetId);
                    if (fleet != null) fleet.HasConvoyed = true;
                }
            }
        }
    }

    /// <param name="includeUsedFleets">
    /// Normally false: a fleet that has already convoyed this turn cannot carry another army, so it is
    /// no longer a legal option when PLANNING a move.
    ///
    /// Route RECONSTRUCTION needs the opposite (see ReconstructConvoyVia). It runs after the convoy has
    /// happened, and ManeuverController marks every carrying fleet HasConvoyed = true at that point -
    /// so the fleets it must find are precisely the ones this filter would exclude. Passing true here
    /// searches all of the nation's fleets instead.
    /// </param>
    private List<List<Unit>> GetAllConvoyPaths(GameDetailDto game, string startId, string endId, Imperial2030.Shared.Models.Nation nation, bool includeUsedFleets = false)
    {
        var paths = new List<List<Unit>>();

        var availableFleets = game.Units
            .Where(u => u.UnitType == UnitType.Fleet && u.Nation == nation && (includeUsedFleets || !u.HasConvoyed))
            .GroupBy(u => u.TerritoryId)
            .ToDictionary(g => g.Key, g => g.ToList());

        if (!availableFleets.Any()) return paths;

        // Collect embarkation points: current position + rail-reachable (only if army starts on rail-valid territory)
        var embarkationPoints = new HashSet<string> { startId };
        if (IsTerritoryRailValid(startId, nation))
        {
            var railReachable = GetRailReachableTerritories(startId, nation, includeExitPoints: false);
            foreach (var t in railReachable) embarkationPoints.Add(t);
        }

        // Seas adjacent to any embarkation point (Army Start/Rail -> Sea)
        var seasAdjacentToStart = new HashSet<string>();
        foreach (var embark in embarkationPoints)
        {
            var seaNeighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(embark, true);
            foreach (var sea in seaNeighbors.Where(n => availableFleets.ContainsKey(n)))
            {
                seasAdjacentToStart.Add(sea);
            }
        }
        
        // Seas adjacent to end (Sea -> Army End)
        var endNeighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(endId, true);
        var targetSeas = new HashSet<string>(endNeighbors);
        
        // Queue: (CurrentSea, PathOfFleets)
        var queue = new Queue<(string Region, List<Unit> Path)>();
        
        foreach (var sea in seasAdjacentToStart)
        {
            var fleet = availableFleets[sea].First();
            queue.Enqueue((sea, new List<Unit> { fleet }));
        }
        
        while (queue.Count > 0)
        {
            var (currentSea, path) = queue.Dequeue();
            
            if (targetSeas.Contains(currentSea))
            {
                paths.Add(path);
                if (paths.Count >= 5) break;
                continue;
            }
            
            if (path.Count >= 5) continue;

            var seaNeighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(currentSea, true);
            
            foreach (var nextSea in seaNeighbors)
            {
                // Canal Check
                var canal = Imperial2030.Shared.Constants.MapConnectivity.CanalLinks.FirstOrDefault(c => 
                    (c.Region1 == currentSea && c.Region2 == nextSea) ||
                    (c.Region1 == nextSea && c.Region2 == currentSea));

                if (canal != default)
                {
                   var controllerId = canal.ControllerId;
                   var tState = game.Territories.FirstOrDefault(ts => ts.TerritoryId == controllerId);
                   if (tState != null && tState.Controller != null && tState.Controller != nation)
                   {
                       // Check if same player controls both nations (Convoy context: 'nation' is the moving nation)
                       var movingNationState = game.NationStates.FirstOrDefault(n => n.Nation == nation);
                       var canalNationState = game.NationStates.FirstOrDefault(n => n.Nation == tState.Controller.Value);
                       
                       bool isSamePlayer = movingNationState?.ControllerName != null 
                                           && canalNationState?.ControllerName != null 
                                           && movingNationState.ControllerName == canalNationState.ControllerName;

                       if (!isSamePlayer)
                       {
                           // Canal Blocked
                           continue;
                       }
                   }
                }

                if (availableFleets.ContainsKey(nextSea) && !path.Any(f => f.TerritoryId == nextSea))
                {
                     var fleet = availableFleets[nextSea].First();
                     var newPath = new List<Unit>(path) { fleet };
                     queue.Enqueue((nextSea, newPath));
                }
            }
        }
        
        return paths;
    }

    private List<string> GetConvoyDestinations(string startId, Imperial2030.Shared.Models.Nation nation)
    {
        var destinations = new HashSet<string>();
        if (Game == null) return destinations.ToList();

        var allFleets = Game.Units.Where(u => u.UnitType == UnitType.Fleet && u.Nation == nation).ToList();
        Console.WriteLine($"[GetConvoyDestinations] All fleets for {nation}: {allFleets.Count}");
        foreach (var f in allFleets)
        {
            Console.WriteLine($"[GetConvoyDestinations]   Fleet {f.Id} at {f.TerritoryId} HasConvoyed={f.HasConvoyed} HasMoved={f.HasMoved}");
        }
        var availableFleets = allFleets
            .Where(u => !u.HasConvoyed)
            .Select(u => u.TerritoryId)
            .ToHashSet();
        Console.WriteLine($"[GetConvoyDestinations] Available fleet territories: {string.Join(", ", availableFleets)}");

        if (!availableFleets.Any()) return destinations.ToList();

        // Embarkation points: current position + rail-reachable (only if army starts on rail-valid territory)
        var embarkationPoints = new HashSet<string> { startId };
        if (IsTerritoryRailValid(startId, nation))
        {
            var railReachable = GetRailReachableTerritories(startId, nation, includeExitPoints: false);
            foreach (var t in railReachable) embarkationPoints.Add(t);
        }

        // BFS through Fleets starting from all embarkation points
        var queue = new Queue<string>();
        var visitedSeas = new HashSet<string>();

        // 1. Embark: Find seas adjacent to any embarkation point that have a friendly fleet
        foreach (var embark in embarkationPoints)
        {
            var seaNeighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(embark, true);
            foreach (var sea in seaNeighbors)
            {
                if (availableFleets.Contains(sea) && !visitedSeas.Contains(sea))
                {
                    queue.Enqueue(sea);
                    visitedSeas.Add(sea);
                }
            }
        }

        while (queue.Count > 0)
        {
            var currentSea = queue.Dequeue();

            // 2. Disembark: Sea -> Land
            var landNeighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(currentSea, false);
            foreach (var land in landNeighbors)
            {
                if (land != startId)
                {
                    destinations.Add(land);
                }
            }

            // 3. Move to next Sea (Chain): Sea -> Sea
            var nextSeas = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(currentSea, true);
            foreach (var next in nextSeas)
            {
                if (visitedSeas.Contains(next)) continue;
                
                // Canal Check
                var canal = Imperial2030.Shared.Constants.MapConnectivity.CanalLinks.FirstOrDefault(c => 
                    (c.Region1 == currentSea && c.Region2 == next) ||
                    (c.Region1 == next && c.Region2 == currentSea));

                if (canal != default)
                {
                   var controllerId = canal.ControllerId;
                   // Use Game.Territories (List<TerritoryStateDto>)
                   var tState = Game.Territories.FirstOrDefault(ts => ts.TerritoryId == controllerId);
                   if (tState != null && tState.Controller != null && tState.Controller != nation)
                   {
                       // Check if same player controls both nations (Convoy context: 'nation' is the moving nation)
                       var movingNationState = Game.NationStates.FirstOrDefault(n => n.Nation == nation);
                       var canalNationState = Game.NationStates.FirstOrDefault(n => n.Nation == tState.Controller.Value);
                       
                       bool isSamePlayer = movingNationState?.ControllerName != null 
                                           && canalNationState?.ControllerName != null 
                                           && movingNationState.ControllerName == canalNationState.ControllerName;

                       if (!isSamePlayer)
                       {
                           // Canal Blocked
                           continue;
                       }
                   }
                }

                if (availableFleets.Contains(next))
                {
                    visitedSeas.Add(next);
                    queue.Enqueue(next);
                }
            }
        }

        return destinations.ToList();
    }

    private async Task ShowToast(string message, bool isError)
    {
        ShowToastAction?.Invoke(message, isError);
        await Task.CompletedTask;
    }
