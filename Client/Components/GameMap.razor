    private bool CanInitiateStationaryBattle()
    {
        if (selectedUnitId == null || Game == null) return false;
        var unit = Game.Units.FirstOrDefault(u => u.Id == selectedUnitId.Value);
        if (unit == null || unit.HasMoved) return false;
        // Must be Fleet or Army
        if (unit.UnitType != UnitType.Fleet && unit.UnitType != UnitType.Army) return false;
        
        // Check for enemies (any type) in the same territory
        var enemies = Game.Units
            .Where(u => u.TerritoryId == unit.TerritoryId && u.Nation != unit.Nation)
            .Any();
            
        return enemies;
    }

    private Unit? GetSelectedUnit()
    {
        if (selectedUnitId == null || Game == null) return null;
        return Game.Units.FirstOrDefault(u => u.Id == selectedUnitId.Value);
    }

    private bool CanToggleHostility()
    {
        if (selectedUnitId == null || Game == null || !IsMyTurn) return false;
        var unit = GetSelectedUnit();
        if (unit == null || unit.UnitType != UnitType.Army) return false;
        
        // Can only toggle hostility if it's our unit
        if (unit.Nation != Game.CurrentTurnNation) return false;

        var territoryDef = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == unit.TerritoryId);
        if (territoryDef == null) return false;

        // Is it a foreign home province?
        return territoryDef.Nation.HasValue && territoryDef.Nation != unit.Nation;
    }

    private async Task ToggleHostility()
    {
        if (selectedUnitId == null || Game == null) return;
        var error = await ManeuverService.ToggleHostility(Game.Id, selectedUnitId.Value);
        if (error != null)
        {
             await JSRuntime.InvokeVoidAsync("alert", L["HostilityToggleFailed", error].Value);
        }
    }

    private async Task OpenStationaryBattleModal()
    {
        if (selectedUnitId == null || Game == null) return;
        var unit = Game.Units.FirstOrDefault(u => u.Id == selectedUnitId.Value);
        if (unit == null) return;

        PendingBattleUnit = unit;
        BattleOptions = Game.Units
            .Where(u => u.TerritoryId == unit.TerritoryId && u.Nation != unit.Nation)
            .Select(u => u.Nation)
            .Distinct()
            .ToList();
            
        if (BattleOptions.Count == 1)
        {
            await ExecuteStationaryBattle(BattleOptions.First());
            return;
        }
            
        ShowStationaryBattleModal = true;
    }

    private async Task ConfirmPeace()
    {
        if (PendingBattleUnit != null)
        {
            // If we are in movement mode (ShowBattleModal true)
            if (ShowBattleModal)
            {
                // Execute move peacefully
                await MoveUnit(PendingBattleUnit, PendingBattleDest, null, false);
            }
        }
        ShowBattleModal = false;
        PendingBattleUnit = null;
        DeselectUnit();
    }

    private async Task ConfirmBattle(Imperial2030.Shared.Models.Nation target)
    {
        if (Game == null || PendingBattleUnit == null || PendingBattleDest == null)
        {
            ShowBattleModal = false;
            PendingBattleUnit = null;
            DeselectUnit();
            return;
        }

             // If we are in movement mode (ShowBattleModal true)
             if (ShowBattleModal)
             {
                 if (PendingBattleUnit.UnitType == UnitType.Fleet)
                 {
                    await ManeuverService.MoveFleet(Game.Id, PendingBattleUnit.Id, PendingBattleDest, target, true);
                 }
                 else
                 {
                    // Army Battle Move
                    await ManeuverService.MoveArmy(Game.Id, PendingBattleUnit.Id, PendingBattleDest, null, target, true);
                 }
             }

        ShowBattleModal = false;
        PendingBattleUnit = null;
        DeselectUnit();
    }

    private async Task ConfirmHostile()
    {
        if (Game != null && PendingBattleUnit != null && PendingBattleDest != null && ShowBattleModal)
        {
             await MoveUnit(PendingBattleUnit, PendingBattleDest, null, true);
        }
        ShowBattleModal = false;
        PendingBattleUnit = null;
        DeselectUnit();
    }

    private async Task ExecuteStationaryBattle(Imperial2030.Shared.Models.Nation target)
    {
        if (Game != null && PendingBattleUnit != null)
        {
            await ManeuverService.BattleAsync(Game.Id, PendingBattleUnit.Id, target);
        }
        ShowStationaryBattleModal = false;
        PendingBattleUnit = null;
        DeselectUnit();
    }

