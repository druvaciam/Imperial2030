    // How far back to scan the action log when matching a detected move (or battle) to its log entry.
    // A move stays on the map for 10s, so a slightly wider window covers everything still displayed.
    private const int RecentActionLookbackSeconds = 11;

    private List<RecentMove> recentMoves = new();

    /// <summary>How long a move/battle/destruction stays highlighted on the map before fading out.</summary>
    private static readonly TimeSpan RecentEventLifetime = TimeSpan.FromSeconds(10);

    /// <summary>How long the "end phase" control pulses after being prompted.</summary>
    private static readonly TimeSpan EndPhaseHighlightDuration = TimeSpan.FromSeconds(5);

    /// <summary>
    /// Cancels every pending <see cref="ScheduleExpiry"/> when this component goes away.
    ///
    /// Without it each scheduled expiry held a 5-10 second window in which the user could navigate
    /// away, after which InvokeAsync(StateHasChanged) ran against a disposed component. The work was
    /// fire-and-forget, so the resulting ObjectDisposedException was unobserved - no log, no error
    /// boundary. The map re-renders on every poll (every 400ms during replay), so these accumulated.
    /// </summary>
    private readonly CancellationTokenSource _expiryCts = new();

    /// <summary>
    /// Runs <paramref name="expire"/> after <paramref name="delay"/> and re-renders if it changed
    /// anything, unless the component was disposed first.
    ///
    /// <paramref name="expire"/> returns whether it actually removed something - List.Remove's own
    /// contract - so an entry already swept by the bulk RemoveAll passes costs no extra render.
    /// </summary>
    private void ScheduleExpiry(TimeSpan delay, Func<bool> expire)
    {
        var token = _expiryCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(delay, token);
                if (token.IsCancellationRequested) return;
                if (!expire()) return;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException) { /* component disposed while waiting */ }
            catch (ObjectDisposedException) { /* renderer torn down between the check and the render */ }
        });
    }

    public void Dispose()
    {
        _expiryCts.Cancel();
        _expiryCts.Dispose();
    }

    // Route of the most recent convoy this client initiated, matched onto the RecentMove that the
    // unit-diff subsequently detects (see AttachConvoyRoute).
    private List<string> _lastConvoyVia = new();
    private string? _lastConvoyFrom;
    private string? _lastConvoyTo;

    /// <summary>
    /// Fills in what a freshly detected move passed through, so the map draws the whole journey instead
    /// of a straight line to the destination. In preference order:
    ///
    ///   1. loggedRoute - ActionMetadata.RouteVia off the move's own log entry. Authoritative: the
    ///      server recorded it while performing the move. Every move logged since that field was added
    ///      takes this path, including rail moves and other players' and bots' convoys.
    ///   2. The route this client picked itself, for a convoy it ordered, when the move was spotted by
    ///      the unit diff rather than read from the log.
    ///   3. Reconstruction, purely for entries logged before RouteVia existed.
    ///
    /// Called at detection time rather than at render time because the reconstruction in (3) reads the
    /// HasConvoyed flags, and those are cleared again at the start of the next maneuver phase.
    /// </summary>
    private void AttachConvoyRoute(RecentMove move, List<string>? loggedRoute = null)
    {
        // Look the route up when the caller has not already got it. Moves detected from the unit diff
        // come with no metadata, and without this they fell through to reconstruction even though the
        // log held the answer - inventing a convoy through the China Sea for an army that had railed
        // Beijing -> Chongqing -> Indochina, because a fleet happened to be sitting in that sea.
        loggedRoute ??= FindLoggedRoute(move);

        if (loggedRoute != null && loggedRoute.Count > 0)
        {
            move.ConvoyVia = new List<string>(loggedRoute);
            return;
        }

        if (_lastConvoyVia.Count > 0
            && move.FromTerritoryId == _lastConvoyFrom && move.ToTerritoryId == _lastConvoyTo)
        {
            move.ConvoyVia = new List<string>(_lastConvoyVia);
            _lastConvoyVia = new List<string>();   // consume it - only the first matching move is ours
            _lastConvoyFrom = _lastConvoyTo = null;
            return;
        }

        move.ConvoyVia = ReconstructConvoyVia(move);
    }

    /// <summary>
    /// The route recorded on this move's own log entry, or null if the log has no matching entry (or the
    /// entry predates ActionMetadata.RouteVia). Matched on nation, origin and destination among the most
    /// recent entries, newest first, so a territory pair traversed more than once picks up the latest.
    /// </summary>
    private List<string>? FindLoggedRoute(RecentMove move)
    {
        if (Game?.Actions == null) return null;

        var cutoff = DateTime.UtcNow.AddSeconds(-RecentActionLookbackSeconds);
        foreach (var action in Game.Actions
                     .Where(a => (a.ActionType == "MoveArmy" || a.ActionType == "MoveFleet")
                                 && a.Nation == move.Nation
                                 && a.Timestamp >= cutoff
                                 && !string.IsNullOrEmpty(a.Metadata))
                     .OrderByDescending(a => a.Timestamp))
        {
            try
            {
                var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.ActionMetadata>(
                    action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                if (meta?.FromTerritoryId == move.FromTerritoryId && meta.ToTerritoryId == move.ToTerritoryId)
                {
                    return meta.RouteVia;
                }
            }
            catch
            {
                // Malformed metadata is not worth failing a render over - fall through to the next entry.
            }
        }
        return null;
    }

    private List<RecentBattle> recentBattles = new();
    private List<RecentFactoryDestruction> recentFactoryDestructions = new();
    private List<Unit> previousUnits = new();

    protected override void OnParametersSet()
    {
        if (Game != null && Game.Units != null)
        {
            if (previousUnits.Count > 0)
            {
                var now = DateTime.UtcNow;
                foreach (var newUnit in Game.Units)
                {
                    var oldUnit = previousUnits.FirstOrDefault(u => u.Id == newUnit.Id);
                    if (oldUnit != null && oldUnit.TerritoryId != newUnit.TerritoryId)
                    {
                        var move = new RecentMove
                        {
                            UnitId = newUnit.Id,
                            UnitType = newUnit.UnitType,
                            Nation = newUnit.Nation,
                            FromTerritoryId = oldUnit.TerritoryId,
                            ToTerritoryId = newUnit.TerritoryId,
                            TimestampUtc = now
                        };
                        AttachConvoyRoute(move);
                        recentMoves.Add(move);
                        
                        ScheduleExpiry(RecentEventLifetime, () => recentMoves.Remove(move));
                    }
                }
            }
            
            recentMoves.RemoveAll(m => (DateTime.UtcNow - m.TimestampUtc).TotalSeconds > 11);
            
            // Supplement recentMoves and recentBattles from GameActions (to catch destroyed units that disappear from Game.Units)
            if (Game.Actions != null)
            {
                var recentLimit = DateTime.UtcNow.AddSeconds(-RecentActionLookbackSeconds);
                
                // Track battles
                foreach (var action in Game.Actions.Where(a => a.ActionType == "Battle" && a.Timestamp >= recentLimit))
                {
                    if (!recentBattles.Any(b => b.TimestampUtc == action.Timestamp) && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && !string.IsNullOrEmpty(meta.TerritoryId))
                            {
                                var battle = new RecentBattle
                                {
                                    TimestampUtc = action.Timestamp,
                                    TerritoryId = meta.TerritoryId,
                                    AggressorNation = meta.AggressorNation,
                                    DefenderNation = meta.DefenderNation,
                                    UnitType = meta.UnitType,
                                    DefenderUnitType = meta.DefenderUnitType
                                };
                                recentBattles.Add(battle);
                                
                                ScheduleExpiry(RecentEventLifetime, () => recentBattles.Remove(battle));
                            }
                        }
                        catch
                        {
                            // Ignore parsing errors for backwards compatibility
                        }
                    }
                }
                recentBattles.RemoveAll(b => (DateTime.UtcNow - b.TimestampUtc).TotalSeconds > 11);
                
                // Track factory destructions
                foreach (var action in Game.Actions.Where(a => a.ActionType == "DestroyFactory" && a.Timestamp >= recentLimit))
                {
                    if (!recentFactoryDestructions.Any(d => d.TimestampUtc == action.Timestamp) && !string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && !string.IsNullOrEmpty(meta.TerritoryId))
                            {
                                var destruction = new RecentFactoryDestruction
                                {
                                    TimestampUtc = action.Timestamp,
                                    TerritoryId = meta.TerritoryId
                                };
                                recentFactoryDestructions.Add(destruction);
                                
                                ScheduleExpiry(RecentEventLifetime, () => recentFactoryDestructions.Remove(destruction));
                            }
                        }
                        catch
                        {
                            // Ignore parsing errors for backwards compatibility
                        }
                    }
                }
                recentFactoryDestructions.RemoveAll(d => (DateTime.UtcNow - d.TimestampUtc).TotalSeconds > 11);
                
                // Track destroyed unit moves
                foreach (var action in Game.Actions.Where(a => (a.ActionType == "MoveArmy" || a.ActionType == "MoveFleet") && a.Timestamp >= recentLimit))
                {
                    if (!string.IsNullOrEmpty(action.Metadata))
                    {
                        try
                        {
                            var meta = System.Text.Json.JsonSerializer.Deserialize<Imperial2030.Shared.Models.ActionMetadata>(action.Metadata, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                            if (meta != null && !string.IsNullOrEmpty(meta.FromTerritoryId) && !string.IsNullOrEmpty(meta.ToTerritoryId) && action.Nation.HasValue)
                            {
                                string toTerr = meta.ToTerritoryId;
                                string fromTerr = meta.FromTerritoryId;
                                
                                // A unit that ended where it started did not move, so there is no path to
                                // draw - and drawing one is actively wrong: route reconstruction would
                                // find the convoy fleets around it and trace a line out to sea and back.
                                // The unit-diff site above gets this for free by only firing on a change.
                                if (fromTerr == toTerr) continue;

                                if (!recentMoves.Any(m => m.FromTerritoryId == fromTerr && m.ToTerritoryId == toTerr && m.Nation == action.Nation.Value && Math.Abs((m.TimestampUtc - action.Timestamp).TotalSeconds) < 2))
                                {
                                    var m = new RecentMove
                                    {
                                        UnitId = Guid.NewGuid(),
                                        Nation = action.Nation.Value,
                                        UnitType = action.ActionType == "MoveFleet" ? Imperial2030.Shared.Models.UnitType.Fleet : Imperial2030.Shared.Models.UnitType.Army,
                                        FromTerritoryId = fromTerr,
                                        ToTerritoryId = toTerr,
                                        TimestampUtc = action.Timestamp
                                    };
                                    AttachConvoyRoute(m, meta.RouteVia);
                                    recentMoves.Add(m);
                                    
                                    ScheduleExpiry(RecentEventLifetime, () => recentMoves.Remove(m));
                                }
                            }
                        }
                        catch
                        {
                            // Ignore parsing errors
                        }
                    }
                }
            }

            previousUnits = Game.Units.Select(u => new Unit 
            { 
                Id = u.Id, 
                TerritoryId = u.TerritoryId, 
                Nation = u.Nation, 
                UnitType = u.UnitType 
            }).ToList();
        }
    }

