<style>
    .map-container {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
    }

    @@media (max-width: 1399.98px) {
        .map-container {
            aspect-ratio: 1200 / 841;
            height: auto;
        }
    }
    /* Default narrow container: stacked HUD */
    .map-overlay-action-buttons {
        position: absolute;
        top: -42px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 500;
        width: max-content;
    }
    /* Wide container: right aligned */
    @@container mainboard (min-width: 800px) {
        .map-overlay-action-buttons {
            top: -38px;
            right: 10px;
            left: unset;
            transform: none;
        }
    }
    .world-map {
        max-width: 100%;
        max-height: 100%;
        border-radius: 4px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    /* This targets every path inside your game board */
    .map-territory {
        fill: rgba(0, 0, 0, 0); /* Start transparent */
        stroke: #333;           /* Border color */
        stroke-width: 0.5;
        cursor: pointer;
        transition: all 0.2s ease; /* Smooth "fade in" of the color */
    }

    /* The Highlight Effect */
    .map-territory:hover {
        fill: rgba(255, 255, 0, 0.4); /* Highlight yellow with 40% opacity */
        stroke: #000;                /* Darken the border on hover */
        stroke-width: 1.5;           /* Make border thicker */
    }

    .valid-target {
        fill: rgba(0, 255, 0, 0.3) !important;
        stroke: #2ecc71 !important;
        stroke-width: 2px !important;
        animation: pulse-green 2s infinite;
    }

    .factory-built {
        fill: rgba(139, 69, 19, 0.8) !important; /* Brown factory */
        stroke: #000 !important;
        stroke-width: 2px !important;
    }

    .selected-unit {
        stroke: #ffff00;
        stroke-width: 3px;
    }

    @@keyframes ghost-blink {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 0.6; }
    }

    @@keyframes marching-ants {
        to { stroke-dashoffset: -20; }
    }

    @@keyframes pulse-ring {
        0% { transform: scale(0.8); opacity: 1; stroke-width: 2px; }
        100% { transform: scale(2.5); opacity: 0; stroke-width: 10px; }
    }

    .ghost-unit {
        animation: ghost-blink 1.5s infinite;
        pointer-events: none;
    }

    .move-path {
        stroke-dasharray: 5, 5;
        animation: marching-ants 1s linear infinite;
        pointer-events: none;
    }

    .pulse-ring {
        animation: pulse-ring 2s ease-out infinite;
        transform-origin: center;
        transform-box: fill-box;
        pointer-events: none;
    }

    .turn-card-highlighter {
        transform-origin: 0 0;
    }

    .turn-card-glow {
        animation: turnCardPulse 2s ease-in-out infinite;
    }

    @@keyframes turnCardPulse {
        0%, 100% { stroke-opacity: 0.7; fill-opacity: 0.10; stroke-width: 3.5px; }
        50% { stroke-opacity: 1.0; fill-opacity: 0.22; stroke-width: 5.5px; }
    }

    .pawn-pulse-ring {
        animation: pawnPulse 1.8s ease-out infinite;
        transform-origin: 0 0;
    }

    @@keyframes pawnPulse {
        0% { transform: scale(0.7); opacity: 1; stroke-width: 3px; }
        100% { transform: scale(2.2); opacity: 0; stroke-width: 0.5px; }
    }

    .track-flow {
        animation: trackFlowAnts 1.2s linear infinite;
    }

    @@keyframes trackFlowAnts {
        to { stroke-dashoffset: -20; }
    }

    .pending-battle {
        stroke: #ffa500 !important; /* Orange */
        stroke-width: 3px !important;
        animation: pulse-orange 2s infinite;
        filter: drop-shadow(0 0 5px orange);
    }

    @@keyframes pulse-orange {
        0% { stroke-opacity: 0.5; }
        50% { stroke-opacity: 1.0; }
        100% { stroke-opacity: 0.5; }
    }

    @@keyframes pulse-green {
        0% { fill-opacity: 0.3; }

</style>



@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject Imperial2030.Client.Services.ManeuverService ManeuverService
@inject Imperial2030.Client.Services.MapService MapService

@code {
    private string Fmt(double val) => val.ToString(System.Globalization.CultureInfo.InvariantCulture);

    [Parameter]
    public GameDetailDto? Game { get; set; }

    private bool IsForcedHostile { get; set; } = false;

    [Parameter] 
    public bool IsMyTurn { get; set; } = false;

    [Parameter]
    public bool IsObserver { get; set; } = false;

    [Parameter]
    public Action<string, bool>? ShowToastAction { get; set; }

    [Parameter]
    public HashSet<Guid> NewUnitIds { get; set; } = new();

    [Parameter]
    public HashSet<string> NewFactoryIds { get; set; } = new();

    [Parameter]
    public HashSet<Nation> PowerBlinkNations { get; set; } = new();

    [Parameter]
    public HashSet<Nation> TaxBlinkNations { get; set; } = new();

    /// <summary>
    /// East/west seam pairs: the map is a sphere, so these regions are adjacent across the border
    /// even though they sit on opposite sides of the image. Mirrors the wrap entries in
    /// MapConnectivity (North Pacific &lt;-&gt; Sea of Japan / China Sea, South Pacific &lt;-&gt; China Sea /
    /// Tasman Sea) - the rules define no north-south equivalent.
    /// </summary>
    private static readonly (string West, string East)[] SeamPairs =
    {
        ("NorthPacific", "SeaOfJapan"),
        ("NorthPacific", "ChinaSea"),
        ("SouthPacific", "ChinaSea"),
        ("SouthPacific", "TasmanSea"),
    };

    private const double MapLeftEdge = 0.0;
    private const double MapRightEdge = 1200.0;

    private static bool CrossesSeam(string a, string b) =>
        SeamPairs.Any(p => (p.West == a && p.East == b) || (p.East == a && p.West == b));

    /// <summary>
    /// The full route of a move as SVG polyline point strings - one string per unbroken segment.
    ///
    /// A convoyed army is drawn through every sea region it was carried across rather than straight
    /// to its destination. A hop across the east/west seam is split into two segments so the line
    /// leaves one border and resumes at the other, instead of cutting back across the whole map.
    /// Both can occur in the same move, so seam splitting is applied per leg of the route.
    /// </summary>
    private List<string> BuildMovePolylines(RecentMove move)
    {
        var coords = Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters;

        // Origin, every convoy stop, destination.
        var route = new List<string> { move.FromTerritoryId };
        route.AddRange(move.ConvoyVia);
        route.Add(move.ToTerritoryId);

        // Bail rather than skip an unplottable region: dropping it would silently splice the route
        // together through whatever remains and draw a leg the unit never travelled.
        if (route.Any(id => !coords.ContainsKey(id))) return new List<string>();

        // Collapse repeats - a convoy stop that equals the origin or the destination, or the same
        // region listed twice, would otherwise contribute a zero-length leg.
        route = route.Where((id, i) => i == 0 || id != route[i - 1]).ToList();

        // Nothing to draw for a unit that ended where it started, however that route was assembled.
        if (route.Count < 2 || route.Distinct().Count() < 2) return new List<string>();

        var segments = new List<string>();
        var current = new List<(double X, double Y)> { coords[route[0]] };

        for (int i = 1; i < route.Count; i++)
        {
            var prev = coords[route[i - 1]];
            var next = coords[route[i]];

            if (CrossesSeam(route[i - 1], route[i]))
            {
                // Run out to the border the previous region faces, close the segment, and restart
                // from the opposite border at the next region's latitude.
                bool prevIsWest = prev.X < next.X;
                double exitX = prevIsWest ? MapLeftEdge : MapRightEdge;
                double entryX = prevIsWest ? MapRightEdge : MapLeftEdge;

                current.Add((exitX, prev.Y));
                segments.Add(ToPoints(current));
                current = new List<(double X, double Y)> { (entryX, next.Y), next };
            }
            else
            {
                current.Add(next);
            }
        }

        if (current.Count >= 2) segments.Add(ToPoints(current));
        return segments;
    }

    private string ToPoints(List<(double X, double Y)> pts) =>
        string.Join(" ", pts.Select(p => $"{Fmt(p.X)},{Fmt(p.Y)}"));

    /// <summary>
    /// Works out which sea regions a convoyed army crossed, for moves this client did not order
    /// itself (another player's, or a bot's) - the unit diff those are detected from records only
    /// origin and destination.
    ///
    /// Best-effort by nature: it searches the board as it stands immediately after the move, so if a
    /// carrying fleet has already been sunk in a battle resolved by the same update it finds nothing
    /// and the move draws direct, as it did before. Only applies to armies whose origin and
    /// destination are not adjacent - anything else did not need a convoy.
    /// </summary>
    private List<string> ReconstructConvoyVia(RecentMove move)
    {
        if (Game == null || move.UnitType != UnitType.Army) return new List<string>();

        var neighbors = Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(move.FromTerritoryId, false);
        if (neighbors.Contains(move.ToTerritoryId)) return new List<string>();  // ordinary adjacent move

        var paths = GetAllConvoyPaths(Game, move.FromTerritoryId, move.ToTerritoryId, move.Nation, includeUsedFleets: true);
        if (paths.Count == 0) return new List<string>();

        // The fleets that carried this army are flagged HasConvoyed by the move that just landed, so a
        // route made entirely of flagged fleets is almost certainly the real one. Shortest breaks ties:
        // the exact route is unknowable from the log, and the shortest is the least misleading guess.
        var seaRoute = paths.OrderByDescending(fleets => fleets.Count(f => f.HasConvoyed))
                            .ThenBy(fleets => fleets.Count)
                            .First()
                            .Select(f => f.TerritoryId)
                            .ToList();

        var via = new List<string>();

        // An army can only board a fleet from a coastal territory it can actually reach, which is not
        // always where it started: GetAllConvoyPaths lets it rail to the coast first, then throws that
        // leg away and reports only the sea regions. Without it the path jumps straight from an inland
        // origin to open sea - Moscow to the Sea of Japan, when the army in fact railed to Vladivostok
        // and boarded there.
        var embarkation = ResolveEmbarkationPoint(move.FromTerritoryId, seaRoute[0], move.Nation);
        if (embarkation != null && embarkation != move.FromTerritoryId) via.Add(embarkation);

        via.AddRange(seaRoute);
        return via;
    }

    /// <summary>
    /// Where the army boarded: the origin itself when it already touches that sea, otherwise the
    /// rail-reachable coastal territory that does. Returns null when none qualifies, in which case the
    /// route is drawn without an embarkation leg rather than with a guessed one.
    /// </summary>
    private string? ResolveEmbarkationPoint(string originId, string firstSeaId, Imperial2030.Shared.Models.Nation nation)
    {
        if (Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(originId, true).Contains(firstSeaId))
        {
            return originId;
        }

        if (!IsTerritoryRailValid(originId, nation)) return null;

        var coords = Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters;
        var candidates = GetRailReachableTerritories(originId, nation, includeExitPoints: false)
            .Where(t => Imperial2030.Shared.Constants.MapConnectivity.GetNeighbors(t, true).Contains(firstSeaId))
            .ToList();

        if (candidates.Count == 0) return null;
        if (candidates.Count == 1 || !coords.ContainsKey(firstSeaId)) return candidates[0];

        // Several coastal territories can touch the same sea. The exact one is not recoverable from the
        // log, so take the one nearest that sea - the shortest, least misleading line to draw.
        var sea = coords[firstSeaId];
        return candidates
            .Where(coords.ContainsKey)
            .OrderBy(t => (coords[t].X - sea.X) * (coords[t].X - sea.X) + (coords[t].Y - sea.Y) * (coords[t].Y - sea.Y))
            .FirstOrDefault() ?? candidates[0];
    }

