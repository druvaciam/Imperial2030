      <!-- Power Track Markers -->
      @if (Game != null && Game.NationStates != null)
      {
          var nationsByPower = Game.NationStates.GroupBy(ns => ns.Power);
          foreach (var group in nationsByPower)
          {
              if (PowerTrackRects.TryGetValue(group.Key, out var rect))
              {
                  var nations = group.ToList();
                  var count = nations.Count;
                  
                  // Calculate base center
                  double centerX = rect.x + rect.w / 2;
                  double centerY = rect.y + rect.h / 2;

                  int maxCols = 3;
                  int totalRows = (count + maxCols - 1) / maxCols;
                  double rowHeight = 12.0;
                  double totalGridHeight = (totalRows - 1) * rowHeight;

                  for (int i = 0; i < count; i++)
                  {
                      var ns = nations[i];
                      
                      int row = i / maxCols;
                      int col = i % maxCols;
                      
                      int itemsInThisRow = Math.Min(maxCols, count - row * maxCols);
                      double rowWidth = (itemsInThisRow - 1) * 12.0;

                      double offsetX = col * 12.0 - rowWidth / 2.0;
                      double offsetY = row * rowHeight - totalGridHeight / 2.0;

                      <circle class="@(PowerBlinkNations.Contains(ns.Nation) ? "new-unit-blink" : "")" cx="@Fmt(centerX + offsetX)" cy="@Fmt(centerY + offsetY)" r="5" 
                              fill="@GetNationColor(ns.Nation)" 
                              stroke="white" stroke-width="1.5" style="opacity:0.9;" />
                  }
              }
          }
      }
    </g>

    <g id="factories">
        @if (Game != null)
        {
            @foreach (var tState in Game.Territories.Where(t => t.HasFactory))
            {
                if (MapCoordinates.TerritoryCenters.TryGetValue(tState.TerritoryId, out var coords))
                {
                    var def = TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == tState.TerritoryId);
                    string fill = def?.CityType == CityType.LightBlue ? "#00BFFF" : "#8B4513"; // DeepSkyBlue or SaddleBrown
                    
                    bool isNew = NewFactoryIds.Contains(tState.TerritoryId);
                    string blinkClass = isNew ? "new-unit-blink" : "";
                    
                    <use class="@blinkClass" href="#factory-icon" x="@Fmt(coords.X - 15)" y="@Fmt(coords.Y - 15)" width="30" height="30" style="fill:@fill; opacity: 0.9; pointer-events: none;" />
                }
            }
        }
    </g>

    <g id="battles-and-ghosts" style="pointer-events: none;">
        @foreach (var battle in recentBattles)
        {
            if (Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(battle.TerritoryId, out var coords))
            {
                if (battle.AggressorNation.HasValue && battle.UnitType.HasValue)
                {
                    string aggColor = GetNationColor(battle.AggressorNation.Value);
                    double offsetX = -10;
                    if (battle.UnitType.Value == Imperial2030.Shared.Models.UnitType.Army)
                    {
                        <g opacity="0.6" class="ghost-blink">
                            <rect x="@Fmt(coords.X + offsetX - 8)" y="@Fmt(coords.Y - 8)" width="16" height="16" fill="@aggColor" stroke="white" stroke-width="1.5" />
                            <text x="@Fmt(coords.X + offsetX)" y="@Fmt(coords.Y)" text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Army)</text>
                        </g>
                    }
                    else
                    {
                        <g opacity="0.6" class="ghost-blink">
                            <circle cx="@Fmt(coords.X + offsetX)" cy="@Fmt(coords.Y)" r="8" fill="@aggColor" stroke="white" stroke-width="1.5" />
                            <text x="@Fmt(coords.X + offsetX)" y="@Fmt(coords.Y)" text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Fleet)</text>
                        </g>
                    }
                }

                if (battle.DefenderNation.HasValue && battle.DefenderUnitType.HasValue)
                {
                    string defColor = GetNationColor(battle.DefenderNation.Value);
                    double defOffsetX = 10;
                    if (battle.DefenderUnitType.Value == Imperial2030.Shared.Models.UnitType.Army)
                    {
                        <g opacity="0.6" class="ghost-blink">
                            <rect x="@Fmt(coords.X + defOffsetX - 8)" y="@Fmt(coords.Y - 8)" width="16" height="16" fill="@defColor" stroke="white" stroke-width="1.5" />
                            <text x="@Fmt(coords.X + defOffsetX)" y="@Fmt(coords.Y)" text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Army)</text>
                        </g>
                    }
                    else
                    {
                        <g opacity="0.6" class="ghost-blink">
                            <circle cx="@Fmt(coords.X + defOffsetX)" cy="@Fmt(coords.Y)" r="8" fill="@defColor" stroke="white" stroke-width="1.5" />
                            <text x="@Fmt(coords.X + defOffsetX)" y="@Fmt(coords.Y)" text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Fleet)</text>
                        </g>
                    }
                }

                // Explosion Icon in center
                <g>
                    <text x="@Fmt(coords.X)" y="@Fmt(coords.Y + 2)" text-anchor="middle" font-size="20" class="explosion-flash">💥</text>
                </g>
            }
        }
    </g>
    
    <g id="recent-factory-destructions-effects" style="pointer-events: none;">
        @foreach (var destruction in recentFactoryDestructions)
        {
            if (Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(destruction.TerritoryId, out var coords))
            {
                // Explosion Icon where the factory used to be
                <g>
                    <text x="@Fmt(coords.X - 10)" y="@Fmt(coords.Y + 2)" text-anchor="middle" font-size="20" class="explosion-flash">💥</text>
                    <rect x="@Fmt(coords.X - 18)" y="@Fmt(coords.Y - 14)" width="16" height="16" fill="transparent" stroke="gray" stroke-width="1.5" stroke-dasharray="2,2" class="new-unit-blink" />
                </g>
            }
        }
    </g>

    <g id="recent-moves-effects" style="pointer-events: none;">
        @foreach (var move in recentMoves)
        {
            if (Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(move.FromTerritoryId, out var fromCoords) &&
                Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(move.ToTerritoryId, out var toCoords))
            {
                string color = GetNationColor(move.Nation);

                @* The path is a polyline, not a single A-to-B line, for two reasons:
                     - a convoyed army rides a chain of fleets, so the route runs through every sea
                       region it was carried across, not straight to the destination;
                     - a move across the map's east/west seam (the world is a sphere) must leave one
                       border and re-enter at the other, instead of slicing back across the whole map.
                   BuildMovePolylines returns one polyline per unbroken segment - two when the move
                   crosses the seam, one otherwise - all with the same .move-path animation and
                   nation colour every other move uses. *@
                @foreach (var segment in BuildMovePolylines(move))
                {
                    <polyline points="@segment" fill="none"
                              stroke="@color" stroke-width="3" class="move-path" />
                }

                <!-- Ghost Unit at Origin -->
                if (move.UnitType == Imperial2030.Shared.Models.UnitType.Army)
                {
                    <rect x="@Fmt(fromCoords.X - 8)" y="@Fmt(fromCoords.Y - 8)" width="16" height="16" 
                          fill="@color" stroke="#ffffff" stroke-width="2" class="ghost-unit" />
                }
                else
                {
                    <circle cx="@Fmt(fromCoords.X)" cy="@Fmt(fromCoords.Y)" r="8" 
                            fill="@color" stroke="#ffffff" stroke-width="2" class="ghost-unit" />
                }

                <!-- Pulsing Effect at Destination -->
                if (move.UnitType == Imperial2030.Shared.Models.UnitType.Army)
                {
                    <rect x="@Fmt(toCoords.X - 8)" y="@Fmt(toCoords.Y - 8)" width="16" height="16" 
                          fill="none" stroke="@color" class="pulse-ring" />
                }
                else
                {
                    <circle cx="@Fmt(toCoords.X)" cy="@Fmt(toCoords.Y)" r="8" 
                            fill="none" stroke="@color" class="pulse-ring" />
                }
            }
        }
    </g>

    <g id="units" style="pointer-events: none;">
        @if (Game != null && Game.Units != null)
        {
            @foreach (var group in Game.Units.GroupBy(u => u.TerritoryId))
            {
                if (Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(group.Key, out var coords))
                {
                    var units = group.ToList();
                    for (int i = 0; i < units.Count; i++)
                    {
                        var unit = units[i];
                        // Dynamic grid layout for stacking
                        int row = i / 3;
                        int col = i % 3;
                        int itemsInRow = System.Math.Min(3, units.Count - row * 3);
                        
                        double rowWidth = (itemsInRow - 1) * 16.0;
                        double offsetX = col * 16.0 - (rowWidth / 2.0); 
                        double offsetY = row * 16.0 + 12.0; 
                        string color = GetNationColor(unit.Nation);
                        string strokeColor = unit.IsHostile ? "red" : "lime";
                        if (selectedUnitId == unit.Id) strokeColor = "#ffff00"; // Highlight selected
                        
                        string strokeWidth = (selectedUnitId == unit.Id) ? "3" : "2";
                        
                        bool isPendingBattleAggressor = (unit.TerritoryId == Game.PendingBattleTerritoryId && unit.Nation == Game.PendingBattleAggressorNation);
                        if (isPendingBattleAggressor)
                        {
                            strokeColor = "#ffa500"; // Orange highlight for aggressor
                            strokeWidth = "3";
                        }
                        
                        bool isDimmed = false;
                        if (unit.UnitType == Imperial2030.Shared.Models.UnitType.Army)
                        {
                            isDimmed = unit.HasMoved;
                        }
                        else if (unit.UnitType == Imperial2030.Shared.Models.UnitType.Fleet)
                        {
                            if (Game?.ManeuverState?.Phase == ManeuverPhase.Fleets)
                                isDimmed = unit.HasMoved;
                            else
                                isDimmed = unit.HasConvoyed;
                        }
                        string dimmedOpacity = isDimmed && !isPendingBattleAggressor ? "0.4" : "1.0"; // Don't dim if involved in battle

                        bool isNew = NewUnitIds.Contains(unit.Id);
                        
                        bool isReadyToMove = false;
                        if (!isDimmed && Game?.ManeuverState != null && unit.Nation == Game.CurrentTurnNation && string.IsNullOrEmpty(Game.PendingBattleTerritoryId))
                        {
                            if ((Game.ManeuverState.Phase == ManeuverPhase.Fleets && unit.UnitType == UnitType.Fleet) ||
                                (Game.ManeuverState.Phase == ManeuverPhase.Armies && unit.UnitType == UnitType.Army))
                            {
                                var dests = GetValidDestinations(unit, unit.TerritoryId);
                                if (dests.Any())
                                {
                                    isReadyToMove = true;
                                }
                            }
                        }

                        string newUnitClass = isNew ? "new-unit-blink" : "";
                        if (isReadyToMove && selectedUnitId != unit.Id) 
                        {
                            newUnitClass += (string.IsNullOrEmpty(newUnitClass) ? "" : " ") + "ready-to-move-blink";
                        }

                        if (unit.UnitType == Imperial2030.Shared.Models.UnitType.Army)
                        {
                            <g style="pointer-events: none;" opacity="@dimmedOpacity" class="@(isPendingBattleAggressor ? "pending-battle" : "") @newUnitClass">
                                <rect x="@Fmt(coords.X + offsetX - 8)" y="@Fmt(coords.Y + offsetY - 8)" width="16" height="16" 
                                      fill="@color" stroke="@strokeColor" stroke-width="@strokeWidth" />
                                <text x="@Fmt(coords.X + offsetX)" y="@Fmt(coords.Y + offsetY)" 
                                      text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Army)</text>
                            </g>
                        }
                        else
                        {
                            <g style="pointer-events: none;" opacity="@dimmedOpacity" class="@(isPendingBattleAggressor ? "pending-battle" : "") @newUnitClass">
                                <circle cx="@Fmt(coords.X + offsetX)" cy="@Fmt(coords.Y + offsetY)" r="8" 
                                        fill="@color" stroke="@strokeColor" stroke-width="@strokeWidth" />
                                <text x="@Fmt(coords.X + offsetX)" y="@Fmt(coords.Y + offsetY)" 
                                      text-anchor="middle" dy="4" font-size="10" fill="white" font-weight="bold">@Names.UnitGlyph(UnitType.Fleet)</text>
                            </g>
                        }
                    }
                }
            }
        }

        @if (Game != null && Game.Territories != null)
        {
            @foreach (var ts in Game.Territories)
            {
                if (ts.Controller.HasValue && Imperial2030.Client.Constants.MapCoordinates.TerritoryCenters.TryGetValue(ts.TerritoryId, out var flagCenter))
                {
                    // Only show flag if controller differs from home nation
                    var def = Imperial2030.Shared.Constants.TerritoryData.AllTerritories.FirstOrDefault(t => t.Id == ts.TerritoryId);
                    if (def != null && def.Nation == ts.Controller.Value) continue;

                    // Render Flag (Small rectangle + pole)
                    var flagX = flagCenter.X;
                    var flagY = flagCenter.Y - 14;
                    <line x1="@Fmt(flagX)" y1="@Fmt(flagY)" x2="@Fmt(flagX)" y2="@Fmt(flagY + 14)" stroke="black" stroke-width="1" />
                    <rect x="@Fmt(flagX)" y="@Fmt(flagY)" width="14" height="9"
                          fill="@GetNationColor(ts.Controller.Value)"
                          stroke="black" stroke-width="0.5"
                          style="pointer-events: none;" />
                }
            }
        }
    </g>
    
    @if (Game != null)
    {
        var localGame = Game; // Capture for null safety in loop
        <!-- Tax Chart Markers -->
        @foreach (var group in (localGame.NationStates ?? Enumerable.Empty<Imperial2030.Shared.Models.NationStateDto>()).GroupBy(ns => Imperial2030.Shared.Constants.TaxChart.GetPowerGain(ns.TaxRevenue)))
        {
            var rect = GetTaxRectByTier(group.Key);
            if (rect.HasValue)
            {
                var (x, y, w, h) = rect.Value;
                var nations = group.ToList();
                var count = nations.Count;

                // Calculate base center
                double centerX = x + w / 2;
                double centerY = y + h / 2;
                
                int maxCols = 3;
                int totalRows = (count + maxCols - 1) / maxCols;
                double rowHeight = 12.0; // Spacing between rows
                double totalGridHeight = (totalRows - 1) * rowHeight;

                for (int i = 0; i < count; i++)
                {
                    var ns = nations[i];
                    
                    int row = i / maxCols;
                    int col = i % maxCols;
                    
                    int itemsInThisRow = Math.Min(maxCols, count - row * maxCols);
                    double rowWidth = (itemsInThisRow - 1) * 12.0; // 12px spacing specific to row

                    double offsetX = col * 12.0 - rowWidth / 2.0;
                    double offsetY = row * rowHeight - totalGridHeight / 2.0;

                    <circle class="@(TaxBlinkNations.Contains(ns.Nation) ? "new-unit-blink" : "")" cx="@Fmt(centerX + offsetX)" cy="@Fmt(centerY + offsetY)" r="5" 
                            fill="@GetNationColor(ns.Nation)" 
                            stroke="white" stroke-width="1.5" style="opacity:0.9;" />
                }
            }
        }

        @* No decoration is drawn for the sphere-wrap sea connections: the map artwork already prints
           them at both edges (the "SJ", "NP", "CS", "SP", "TS" arrow pairs). An actual crossing move
           is drawn by BuildMovePolylines, which splits it at the border into two segments. *@

        <!-- Turn Order Indicator on Bottom Nation Cards -->
        @if (Game.Status == GameStatus.InProgress)
        {
            var activeNation = Game.CurrentTurnNation;
            int activeIdx = (int)activeNation;
            double cardX = 9.0 + activeIdx * 197.0;
            double pawnX = cardX + 30.0;
            double pawnY = 682.0;
            string activeColor = GetNationColor(activeNation);

            <g id="turn-order-indicator" style="pointer-events: none;">
                <!-- Flow Arrows between the 6 Nation Cards at bottom (y=682) -->
                <g class="turn-track-arcs" opacity="0.45">
                    <path d="M 39 682 Q 137.5 638 236 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="232,676 240,682 232,688" fill="#ffffff" />

                    <path d="M 236 682 Q 334.5 638 433 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="429,676 437,682 429,688" fill="#ffffff" />

                    <path d="M 433 682 Q 531.5 638 630 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="626,676 634,682 626,688" fill="#ffffff" />

                    <path d="M 630 682 Q 728.5 638 827 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="823,676 831,682 823,688" fill="#ffffff" />

                    <path d="M 827 682 Q 925.5 638 1024 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="1020,676 1028,682 1020,688" fill="#ffffff" />

                    <!-- Turn order wraps from Europe back to Russia. Drawn as two stubs running off
                         opposite edges rather than one long arc sweeping back across the whole row:
                         that arc passed over all six cards and read as a connection between them.
                         Both ends leave/enter at the same height so they scan as one line the map
                         edge happens to cut. Both stop exactly on the border - overshooting draws into the
                         letterboxed margin outside the map, since preserveAspectRatio clips to the
                         element box rather than to the viewBox. -->
                    @* Same stroke-width and no extra opacity as the five arrows above: this is the same
                       kind of connection, just cut by the map edge, and it has to read that way. The
                       group's own opacity="0.45" already applies to every path in here, so a per-path
                       opacity stacks on top of it and made this leg roughly a third as strong. *@
                    <path d="M 1024 682 C 1100 682, 1150 668, 1200 665" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <path d="M 0 665 C 12 668, 20 682, 39 682" fill="none" stroke="#ffffff" stroke-width="2.5" stroke-dasharray="5,5" class="track-flow" />
                    <polygon points="35,676 43,682 35,688" fill="#ffffff" />
